---
import ProductCard from './ProductCard.astro';
import type { Product } from '../lib/mockData';

export interface Props {
  products: Product[];
}

const { products } = Astro.props;
---

<section class="py-20 bg-slate-900 text-white border-b border-slate-800">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-6">
      <div class="space-y-3 max-w-2xl">
        <h2 class="text-xs font-bold text-industrial-copper uppercase tracking-widest">Handpicked Solutions</h2>
        <h3 class="text-3xl sm:text-4xl font-extrabold text-white">Featured Industrial Products</h3>
        <p class="text-slate-400 text-base">
          Our flagship high-purity graphite and sealing components utilized in high-temperature manufacturing.
        </p>
      </div>
      <a
        href="/products"
        class="inline-flex items-center gap-2 text-sm font-bold text-industrial-copper hover:text-amber-400 transition-colors"
      >
        <span>View Complete Catalog ({products.length}+ Products)</span>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {products.map((product) => (
        <ProductCard product={product} />
      ))}
    </div>

  </div>
</section>
