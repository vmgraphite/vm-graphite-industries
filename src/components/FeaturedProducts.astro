---
import ProductCard from './ProductCard.astro';
import type { Product } from '../lib/mockData';

export interface Props {
  products: Product[];
}

const { products } = Astro.props;
---

<section class="py-24 bg-white text-slate-900 border-b border-slate-200/80 relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-16 gap-6 reveal-on-scroll">
      <div class="space-y-3 max-w-2xl">
        <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-amber-500/10 text-industrial-copper border border-amber-500/20 text-xs font-bold uppercase tracking-widest font-mono">
          Handpicked Solutions
        </div>
        <h2 class="text-3xl sm:text-5xl font-extrabold text-slate-900 tracking-tight">
          Featured Industrial Products
        </h2>
        <p class="text-slate-600 text-base sm:text-lg leading-relaxed">
          Our flagship high-purity graphite and sealing components engineered for high-temperature manufacturing.
        </p>
      </div>
      <a
        href="/products"
        class="inline-flex items-center gap-2 text-sm font-bold text-industrial-copper hover:text-amber-700 transition-colors shrink-0"
      >
        <span>View Complete Catalog ({products.length}+ Products) &rarr;</span>
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {products.map((product) => (
        <ProductCard product={product} />
      ))}
    </div>

  </div>
</section>


