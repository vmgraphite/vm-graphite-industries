---
import type { Product } from '../lib/mockData';

export interface Props {
  product: Product;
}

const { product } = Astro.props;
const topSpecs = product.specifications ? product.specifications.slice(0, 2) : [];
---

<div class="bg-[#0e131f] rounded-3xl overflow-hidden transition-all duration-500 flex flex-col h-full group reveal-on-scroll border border-white/10 hover:border-gold-500/40 shadow-2xl hover:-translate-y-2">
  
  <!-- Image Banner -->
  <a href={`/products/${product.slug}`} class="aspect-4/3 overflow-hidden relative bg-[#040508] block">
    <img
      src={product.mainImage}
      alt={product.name}
      class="w-full h-full object-cover group-hover:scale-108 transition-transform duration-700 opacity-90 group-hover:opacity-100"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-[#0e131f] via-transparent to-transparent"></div>
    
    <div class="absolute top-4 left-4 bg-[#07090e]/90 backdrop-blur-md px-3.5 py-1 rounded-full text-[11px] font-bold text-gold-400 border border-gold-500/30 font-mono shadow-md">
      {product.categoryName}
    </div>

    {product.isFeatured && (
      <div class="absolute top-4 right-4 bg-gradient-to-r from-amber-400 via-gold-400 to-amber-500 text-slate-950 text-[10px] font-black uppercase tracking-wider px-3 py-1 rounded-full shadow-md font-mono border border-amber-200/60">
        Featured
      </div>
    )}
  </a>

  <!-- Content Body -->
  <div class="p-7 flex-grow flex flex-col justify-between space-y-5">
    <div>
      <h3 class="text-xl font-bold text-white group-hover:text-gold-400 transition-colors mb-2 leading-snug">
        <a href={`/products/${product.slug}`}>{product.name}</a>
      </h3>
      <p class="text-xs sm:text-sm text-slate-300 line-clamp-3 leading-relaxed font-normal">
        {product.shortDescription}
      </p>
    </div>

    <!-- Key Spec Chips -->
    {topSpecs.length > 0 && (
      <div class="bg-[#07090e] border border-white/10 rounded-2xl p-3.5 space-y-2">
        {topSpecs.map((spec) => (
          <div class="flex justify-between items-baseline gap-2 text-xs">
            <span class="text-slate-400 font-medium shrink-0">{spec.name}:</span>
            <span class="text-gold-300 font-semibold font-mono text-right min-w-0 break-words">{spec.value}</span>
          </div>
        ))}
      </div>
    )}

    <!-- Action Buttons -->
    <div class="pt-2 grid grid-cols-2 gap-3">
      <button
        type="button"
        data-open-quote-modal
        data-product-name={product.name}
        data-product-category={product.categoryName}
        class="w-full py-3 px-3 bg-gradient-to-r from-amber-400 via-gold-400 to-amber-500 hover:from-amber-300 hover:to-amber-400 text-slate-950 text-xs font-black rounded-xl border border-amber-200/80 shadow-[0_4px_15px_rgba(245,158,11,0.3)] transition-all active:scale-95 cursor-pointer flex items-center justify-center gap-1.5 font-sans uppercase tracking-wider"
      >
        <svg class="w-3.5 h-3.5 text-slate-950" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
        <span>Get Quote</span>
      </button>

      <a
        href={`/products/${product.slug}`}
        class="w-full py-3 px-3 bg-[#141b2d] hover:bg-[#1e293b] text-slate-200 text-xs font-bold rounded-xl transition-colors flex items-center justify-center gap-1 border border-white/10"
      >
        <span>Details</span>
        <svg class="w-3.5 h-3.5 text-gold-400 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
      </a>
    </div>
  </div>

</div>
