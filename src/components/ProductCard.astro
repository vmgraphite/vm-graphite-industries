---
import type { Product } from '../lib/mockData';

export interface Props {
  product: Product;
}

const { product } = Astro.props;
const topSpecs = product.specifications ? product.specifications.slice(0, 2) : [];
---

<div
  data-tilt
  data-tilt-max="6"
  data-spotlight
  class="glow-card card-shimmer-sweep group flex flex-col justify-between overflow-hidden rounded-2xl border border-white/[0.08] hover:border-theme hover:shadow-[0_20px_50px_rgba(0,0,0,0.8),0_0_30px_rgba(255,102,54,0.22)] transition-all duration-500 bg-[#0f1118] relative"
>
  
  <!-- Image Banner with HUD overlays -->
  <a href={`/products/${product.slug}`} class="h-52 overflow-hidden relative bg-[#040508] block">
    <img
      src={product.mainImage}
      alt={product.name}
      class="w-full h-full object-cover group-hover:scale-108 group-hover:brightness-105 transition-all duration-700 opacity-85 group-hover:opacity-100"
    />
    
    <!-- HUD Scanline and Ambient Shadow -->
    <div class="hud-scanline"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-[#0f1118] via-transparent to-transparent"></div>
    
    <!-- Tech HUD Corner Crosshairs (Top Left & Top Right) -->
    <div class="absolute top-2 left-2 w-2.5 h-2.5 border-t-2 border-l-2 border-white/20 group-hover:border-theme transition-colors pointer-events-none"></div>
    <div class="absolute top-2 right-2 w-2.5 h-2.5 border-t-2 border-r-2 border-white/20 group-hover:border-theme transition-colors pointer-events-none"></div>
    
    <!-- Category Pill -->
    <div class="absolute top-3.5 left-3.5 bg-[#07090e]/90 backdrop-blur-md px-3 py-1 rounded-full text-[10px] font-bold text-theme-bright border border-white/10 font-mono shadow-md uppercase tracking-wider group-hover:border-theme transition-colors">
      {product.categoryName}
    </div>

    {product.isFeatured && (
      <div class="absolute top-3.5 right-3.5 bg-gradient-to-r from-[var(--primary)] to-[var(--primary-hover)] text-white text-[10px] font-bold uppercase tracking-wider px-2.5 py-1 rounded-full shadow-md font-mono border border-white/20">
        Featured
      </div>
    )}
  </a>

  <!-- Content Body -->
  <div class="p-5 sm:p-6 flex-grow flex flex-col justify-between space-y-4 relative z-10">
    <div>
      <h3 class="text-lg font-bold text-white group-hover:text-theme-bright transition-colors mb-2 leading-snug" style="font-family:'Outfit',sans-serif;">
        <a href={`/products/${product.slug}`}>{product.name}</a>
      </h3>
      <p class="text-xs text-slate-400 line-clamp-2 leading-relaxed font-normal">
        {product.shortDescription}
      </p>
    </div>

    <!-- Key Spec Chips with glowing indicator dots -->
    {topSpecs.length > 0 && (
      <div class="bg-[#07090e] border border-white/[0.06] group-hover:border-white/10 rounded-xl p-3 space-y-2 transition-colors">
        {topSpecs.map((spec) => (
          <div class="flex justify-between items-baseline gap-2 text-xs">
            <span class="text-slate-400 font-medium shrink-0 font-mono text-[11px] flex items-center gap-1.5">
              <span class="w-1.5 h-1.5 rounded-full bg-theme/50 group-hover:bg-theme group-hover:shadow-[0_0_6px_var(--primary)] transition-all"></span>
              {spec.name}:
            </span>
            <span class="text-slate-200 font-bold font-mono text-right min-w-0 break-words text-[11px]">{spec.value}</span>
          </div>
        ))}
      </div>
    )}

    <!-- Action Buttons -->
    <div class="pt-1 grid grid-cols-2 gap-2.5">
      <button
        type="button"
        data-open-quote-modal
        data-product-name={product.name}
        data-product-category={product.categoryName}
        data-magnetic
        class="forge-btn-primary w-full py-2.5 px-3 rounded-full text-xs font-semibold flex items-center justify-center gap-1.5"
      >
        <svg class="w-3.5 h-3.5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
        <span>Quote</span>
      </button>

      <a
        href={`/products/${product.slug}`}
        data-magnetic
        class="forge-btn-ghost w-full py-2.5 px-3 rounded-full text-xs font-semibold flex items-center justify-center gap-1 group/btn"
      >
        <span>Details</span>
        <svg class="w-3.5 h-3.5 text-theme-bright group-hover/btn:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/></svg>
      </a>
    </div>
  </div>

</div>
