---
import type { Category } from '../lib/mockData';

export interface Props {
  categories: Category[];
}

const { categories } = Astro.props;
---

<section class="py-28 lg:py-36 bg-[#090c15] text-slate-100 border-b border-white/5 relative overflow-hidden">
  
  <!-- Subtle Ambient Glow Backdrop -->
  <div class="absolute top-0 right-1/4 w-[600px] h-[600px] bg-[radial-gradient(circle,rgba(212,175,55,0.06),transparent_70%)] pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Section Header -->
    <div class="flex flex-col lg:flex-row lg:items-end justify-between mb-20 gap-8 reveal-on-scroll">
      <div class="space-y-4 max-w-2xl">
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-gold-500/10 text-gold-400 border border-gold-500/25 text-xs font-bold uppercase tracking-widest font-mono">
          Material Divisions
        </div>
        <h2 class="text-3xl sm:text-5xl lg:text-6xl font-black text-white tracking-tight leading-tight">
          Specialized <span class="text-gold-gradient font-black">Industrial Divisions</span>
        </h2>
        <p class="text-slate-300 text-base sm:text-lg leading-relaxed font-normal">
          Explore our primary material operations serving metallurgy, flexography, rotary printing, and severe thermal sealing industries worldwide.
        </p>
      </div>
      
      <a
        href="/products"
        class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-[#121724] hover:bg-[#182030] text-gold-400 border border-gold-500/30 text-sm font-bold transition-all shrink-0 hover:border-gold-400 shadow-lg"
      >
        <span>Browse All Divisions &rarr;</span>
      </a>
    </div>

    <!-- Spacious Division Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 lg:gap-10">
      {categories.map((cat, idx) => (
        <a
          href={`/products?category=${cat.slug}`}
          class="group relative bg-[#0e131f] rounded-3xl overflow-hidden transition-all duration-500 flex flex-col justify-between h-full reveal-on-scroll border border-white/10 hover:border-gold-500/40 hover:-translate-y-2 shadow-2xl"
        >
          <!-- Image Banner -->
          <div class="aspect-16/10 overflow-hidden relative bg-[#040508]">
            <img
              src={cat.image}
              alt={cat.name}
              class="w-full h-full object-cover group-hover:scale-108 transition-transform duration-700 opacity-90 group-hover:opacity-100"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-[#0e131f] via-transparent to-transparent"></div>
            
            <div class="absolute top-4 left-4 bg-[#07090e]/90 backdrop-blur-md px-3.5 py-1 rounded-full text-xs font-bold text-gold-400 border border-gold-500/30 font-mono shadow-md">
              DIVISION 0{idx + 1}
            </div>
          </div>

          <!-- Content Body -->
          <div class="p-8 flex-grow flex flex-col justify-between space-y-6">
            <div>
              <h3 class="text-2xl font-bold text-white group-hover:text-gold-400 transition-colors mb-3 leading-snug">
                {cat.name}
              </h3>
              <p class="text-sm text-slate-300 line-clamp-3 leading-relaxed font-normal">
                {cat.description}
              </p>
            </div>

            <div class="pt-5 border-t border-white/10 flex items-center justify-between text-xs font-bold text-gold-400 tracking-wider font-mono">
              <span>EXPLORE DIVISION</span>
              <div class="w-8 h-8 rounded-full bg-gold-500/10 border border-gold-500/30 flex items-center justify-center group-hover:bg-gold-500 group-hover:text-slate-950 transition-all">
                <svg class="w-4 h-4 text-gold-400 group-hover:text-slate-950 transform group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/></svg>
              </div>
            </div>
          </div>
        </a>
      ))}
    </div>

  </div>
</section>
