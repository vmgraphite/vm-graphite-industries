---
import type { Category } from '../lib/mockData';

export interface Props {
  categories: Category[];
}

const { categories } = Astro.props;
---

<section class="py-24 bg-slate-50/80 text-slate-900 border-b border-slate-200/80 relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-16 gap-6 reveal-on-scroll">
      <div class="space-y-3 max-w-2xl">
        <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-amber-500/10 text-industrial-copper border border-amber-500/20 text-xs font-bold uppercase tracking-widest font-mono">
          Product Catalog
        </div>
        <h2 class="text-3xl sm:text-5xl font-extrabold text-slate-900 tracking-tight">
          Featured Product Divisions
        </h2>
        <p class="text-slate-600 text-base sm:text-lg leading-relaxed">
          Explore our specialized material divisions engineered for metallurgy, sealing technology, and flexo/gravure printing systems.
        </p>
      </div>
      <a
        href="/products"
        class="inline-flex items-center gap-2 text-sm font-bold text-industrial-copper hover:text-amber-700 transition-colors group shrink-0"
      >
        <span>Browse All Divisions &rarr;</span>
      </a>
    </div>

    <!-- Category Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {categories.map((cat, idx) => (
        <a
          href={`/products?category=${cat.slug}`}
          class="group relative glass-card-light rounded-2xl overflow-hidden transition-all duration-500 flex flex-col h-full reveal-on-scroll"
        >
          <!-- Image Banner -->
          <div class="aspect-16/10 overflow-hidden relative bg-slate-100">
            <img
              src={cat.image}
              alt={cat.name}
              class="w-full h-full object-cover group-hover:scale-108 transition-transform duration-700"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-slate-950/60 via-transparent to-transparent"></div>
            <div class="absolute top-4 left-4 bg-white/90 backdrop-blur-md px-3 py-1 rounded-full text-[11px] font-bold text-industrial-copper border border-slate-200/90 font-mono shadow-xs">
              DIVISION 0{idx + 1}
            </div>
          </div>

          <!-- Content Body -->
          <div class="p-7 flex-grow flex flex-col justify-between space-y-5">
            <div>
              <h3 class="text-2xl font-bold text-slate-900 group-hover:text-industrial-copper transition-colors mb-3">
                {cat.name}
              </h3>
              <p class="text-sm text-slate-600 line-clamp-3 leading-relaxed font-normal">
                {cat.description}
              </p>
            </div>

            <div class="pt-4 border-t border-slate-100 flex items-center justify-between text-xs font-bold text-industrial-copper tracking-wider font-mono">
              <span>EXPLORE DIVISION PRODUCTS</span>
              <svg class="w-4 h-4 transform group-hover:translate-x-1.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
            </div>
          </div>
        </a>
      ))}
    </div>

  </div>
</section>


