---
import type { Category } from '../lib/mockData';

export interface Props {
  categories: Category[];
}

const { categories } = Astro.props;
---

<section class="relative bg-[#0a0b0f] border-t border-white/5 py-14">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Header row -->
    <div class="flex items-center justify-between mb-8 reveal-on-scroll">
      <div class="space-y-1">
        <span class="amber-pill">Product Divisions</span>
        <h2 class="text-2xl font-black text-white tracking-tight mt-2" style="font-family:'Outfit',sans-serif;">
          Our Specializations
        </h2>
      </div>
      <a href="/products" class="forge-btn-ghost rounded-lg text-xs px-4 py-2 shrink-0">
        All Products →
      </a>
    </div>

    <!-- Compact card grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 reveal-on-scroll">
      {categories.map((cat, idx) => (
        <a
          href={`/products?category=${cat.slug}`}
          class="group relative bg-[#111318] rounded-xl overflow-hidden border border-white/8 hover:border-[rgba(232,160,32,0.3)] transition-all duration-300 hover:-translate-y-0.5 flex flex-col"
        >
          <!-- Image -->
          <div class="h-44 overflow-hidden relative bg-[#080a10] shrink-0">
            <img
              src={cat.image}
              alt={cat.name}
              class="w-full h-full object-cover opacity-75 group-hover:opacity-90 group-hover:scale-105 transition-all duration-500"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-[#111318] via-transparent to-transparent"></div>
            <span class="absolute top-3 left-3 text-[9px] font-black font-mono text-[#e8a020] bg-[rgba(10,11,15,0.85)] border border-[rgba(232,160,32,0.25)] px-2 py-0.5 rounded uppercase tracking-widest">
              {String(idx + 1).padStart(2, '0')}
            </span>
          </div>

          <!-- Content -->
          <div class="p-4 flex-1 flex flex-col justify-between gap-2">
            <div>
              <h3 class="text-sm font-bold text-white group-hover:text-[#f7c355] transition-colors leading-snug" style="font-family:'Outfit',sans-serif;">
                {cat.name}
              </h3>
              <p class="text-xs text-slate-500 mt-1 line-clamp-2 leading-relaxed">{cat.description}</p>
            </div>
            <span class="text-[10px] font-bold text-[#e8a020] font-mono uppercase tracking-wider flex items-center gap-1">
              Explore
              <svg class="w-3 h-3 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
            </span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
