---
import type { Category } from '../lib/mockData';

export interface Props {
  categories: Category[];
  badge?: string;
  title?: string;
  description?: string;
  buttonText?: string;
  cardLinkText?: string;
}

const {
  categories = [],
  badge,
  title,
  description,
  buttonText,
  cardLinkText,
} = Astro.props;

const safeBadge = badge || 'Product Divisions';
const safeTitle = title || 'Engineered for Extreme Operations';
const safeDesc = description || 'From metallurgical melting and hot forging to high-precision printing doctoring, our three specialized divisions supply certified industrial-grade solutions.';
const safeBtnText = buttonText || 'View Full Catalog';
const safeLinkText = cardLinkText || 'Explore Products';
---

<section class="relative bg-[#07090e] border-t border-white/[0.06] py-20 overflow-hidden">
  
  <!-- Subtle Background Ambient Light -->
  <div class="absolute top-1/2 right-0 w-[500px] h-[500px] bg-[radial-gradient(circle,var(--primary-glow-subtle),transparent_70%)] pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">

    <!-- Header row with Entrance Reveal -->
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-4" data-reveal="fade-up">
      <div class="space-y-3 max-w-2xl">
        <span class="theme-pill">{safeBadge}</span>
        <h2 class="display-lg text-white font-black tracking-tight" style="font-family:'Outfit',sans-serif;">
          {safeTitle.includes('Extreme') ? (
            <>Engineered for <span class="text-theme-gradient">Extreme Operations</span></>
          ) : (
            <span>{safeTitle}</span>
          )}
        </h2>
        <p class="text-slate-400 text-sm sm:text-base leading-relaxed">
          {safeDesc}
        </p>
      </div>
      <a href="/products" data-magnetic class="forge-btn-ghost rounded-full text-xs px-5 py-2.5 shrink-0 self-start md:self-auto font-semibold">
        <span>{safeBtnText}</span>
        <span class="text-theme-bright font-bold">→</span>
      </a>
    </div>

    <!-- Category spotlight cards with 3D Tilt and Stagger -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6" data-reveal="stagger">
      {categories.map((cat, idx) => (
        <a
          href={`/products?category=${cat.slug}`}
          data-tilt
          data-tilt-max="6"
          data-spotlight
          class="glow-card group flex flex-col justify-between overflow-hidden rounded-2xl border border-white/[0.08] hover:border-theme transition-all duration-300 bg-[#0f1118]"
        >
          <!-- Image Header with gradient overlay -->
          <div class="h-56 overflow-hidden relative bg-[#040508] shrink-0">
            <img
              src={cat.image}
              alt={cat.name}
              class="w-full h-full object-cover opacity-80 group-hover:opacity-95 group-hover:scale-105 transition-all duration-700"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-[#0f1118] via-transparent to-transparent"></div>
            
            <!-- Division tag -->
            <div class="absolute top-4 left-4 bg-[#07090e]/90 backdrop-blur-md border border-white/10 px-3 py-1 rounded-full text-[10px] font-bold font-mono text-theme-bright uppercase tracking-wider shadow-md">
              DIVISION {String(idx + 1).padStart(2, '0')}
            </div>

            <!-- Arrow icon badge on hover -->
            <div class="absolute bottom-4 right-4 w-8 h-8 rounded-full bg-[var(--primary)] text-white flex items-center justify-center font-bold opacity-0 translate-y-2 group-hover:opacity-100 group-hover:translate-y-0 transition-all duration-300 shadow-[0_0_20px_var(--primary-glow)]">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
            </div>
          </div>

          <!-- Card Content -->
          <div class="p-6 flex-1 flex flex-col justify-between gap-4 bg-[#0f1118]">
            <div>
              <h3 class="text-lg font-bold text-white group-hover:text-theme-bright transition-colors leading-snug" style="font-family:'Outfit',sans-serif;">
                {cat.name}
              </h3>
              <p class="text-xs text-slate-400 mt-2 leading-relaxed font-normal">{cat.description}</p>
            </div>

            <div class="pt-4 border-t border-white/[0.06] flex items-center justify-between">
              <span class="text-xs font-semibold text-theme-bright font-mono uppercase tracking-wider flex items-center gap-1.5 group-hover:translate-x-1 transition-transform">
                <span>{safeLinkText}</span>
                <span>→</span>
              </span>
            </div>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
