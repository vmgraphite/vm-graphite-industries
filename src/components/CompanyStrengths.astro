---

<section class="py-24 relative bg-[#07090e] overflow-hidden border-t border-white/[0.06]">

  <!-- Section header -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-14">
    <div class="max-w-3xl space-y-4 reveal-slide-left">
      <span class="theme-pill">B2B Manufacturing Advantage</span>
      <h2 class="display-lg text-white font-black tracking-tight" style="font-family:'Outfit',sans-serif;">
        Why Industrial Leaders Choose <span class="text-theme-gradient">VM Graphite</span>
      </h2>
      <p class="text-slate-400 text-sm sm:text-base leading-relaxed max-w-2xl font-normal">
        Delivering consistent material purity, extended component life, and minimal maintenance downtime across continuous thermal operations worldwide.
      </p>
    </div>
  </div>

  <!-- Alternating Rows -->
  <div class="border-t border-white/[0.06]">
    {strengths.map((item, idx) => (
      <div class={`relative group border-b border-white/[0.06] transition-colors duration-300 hover:bg-white/[0.02] bg-[#07090e] reveal-on-scroll stagger-${(idx % 4) + 1}`}>
        
        <!-- Left Theme Indicator Bar on Hover -->
        <div class="absolute left-0 top-0 bottom-0 w-1 bg-gradient-to-b from-[var(--primary)] to-[var(--primary-dark)] opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>

        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-center py-8 lg:py-10">

            <!-- Watermark Number -->
            <div class="hidden lg:flex lg:col-span-1 items-center justify-center">
              <span class="font-black font-mono text-6xl text-theme-bright opacity-[0.07] select-none">
                {item.number}
              </span>
            </div>

            <!-- Icon -->
            <div class="lg:col-span-1 flex items-center">
              <div class="w-12 h-12 rounded-xl bg-[#0f1118] border border-white/[0.08] group-hover:border-theme group-hover:bg-theme-tint flex items-center justify-center transition-all duration-300 shadow-md">
                <svg class="w-6 h-6 text-theme-bright" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d={item.icon} />
                </svg>
              </div>
            </div>

            <!-- Text Content -->
            <div class="lg:col-span-7 space-y-1.5">
              <h3 class="text-lg sm:text-xl font-bold text-white group-hover:text-theme-bright transition-colors leading-snug" style="font-family:'Outfit',sans-serif;">
                {item.title}
              </h3>
              <p class="text-slate-400 text-xs sm:text-sm leading-relaxed font-normal">
                {item.description}
              </p>
            </div>

            <!-- Metric Pill -->
            <div class="lg:col-span-3 flex lg:justify-end">
              <span class="inline-flex items-center gap-2 px-4 py-2 bg-[#0f1118] border border-white/[0.08] group-hover:border-theme rounded-full text-xs font-semibold text-slate-300 group-hover:text-theme-bright transition-all font-mono shadow-sm">
                <span class="w-2 h-2 rounded-full bg-[var(--primary)] opacity-70 group-hover:animate-pulse"></span>
                {item.metric}
              </span>
            </div>

          </div>
        </div>
      </div>
    ))}
  </div>

</section>
