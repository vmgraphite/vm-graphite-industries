---

<section class="py-28 lg:py-36 bg-[#07090e] text-slate-100 border-b border-white/5 relative overflow-hidden">
  
  <!-- Subtle Ambient Glow -->
  <div class="absolute bottom-0 right-0 w-[600px] h-[600px] bg-[radial-gradient(circle,rgba(212,175,55,0.06),transparent_70%)] pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto space-y-4 mb-20 reveal-on-scroll">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-gold-500/10 border border-gold-500/25 text-gold-400 text-xs font-bold uppercase tracking-widest font-mono">
        B2B Manufacturing Advantage
      </div>
      <h2 class="text-3xl sm:text-5xl lg:text-6xl font-black text-white tracking-tight leading-tight">
        Why Industrial Leaders Choose <span class="text-gold-gradient font-black">VM Graphite</span>
      </h2>
      <p class="text-slate-300 text-base sm:text-lg leading-relaxed font-normal">
        Delivering consistent material purity, extended component life, and minimal maintenance downtime across continuous thermal operations.
      </p>
    </div>

    <!-- Strengths Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 lg:gap-10">
      {strengths.map((item) => (
        <div class="bg-[#0e131f] p-8 rounded-3xl border border-white/10 hover:border-gold-500/40 transition-all duration-500 transform hover:-translate-y-2 group reveal-on-scroll shadow-2xl flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-6">
              <div class="w-14 h-14 rounded-2xl bg-gold-500/10 border border-gold-500/25 text-gold-400 group-hover:bg-gold-500 group-hover:text-slate-950 flex items-center justify-center transition-all duration-500 shadow-lg">
                <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d={item.icon} />
                </svg>
              </div>

              <span class="text-[11px] font-bold text-gold-400 bg-gold-500/10 px-3 py-1 rounded-full border border-gold-500/25 font-mono">
                {item.metric}
              </span>
            </div>

            <h3 class="text-xl font-bold text-white mb-3 group-hover:text-gold-400 transition-colors leading-snug">{item.title}</h3>
            <p class="text-sm text-slate-300 leading-relaxed font-normal">{item.description}</p>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
