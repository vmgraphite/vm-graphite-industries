---
export interface Props {
  headline?: string;
  subheadline?: string;
  heroImage?: string;
  primaryCtaText?: string;
  secondaryCtaText?: string;
}

const {
  headline = 'Advanced Graphite & Industrial Material Solutions',
  subheadline = 'Precision-manufactured high-density graphite crucibles, colloidal graphite suspensions, synthetic seals, and high-tensile doctor blades engineered for severe thermal and chemical operating environments.',
  heroImage = '/images/categories/graphite-carbon.jpg',
  primaryCtaText = 'Explore Products',
  secondaryCtaText = 'Get a Quote',
} = Astro.props;
---

<section class="relative bg-slate-950 text-white overflow-hidden py-20 lg:py-28 industrial-grid-bg border-b border-slate-800">
  
  <!-- Subtle Industrial Glow Accent -->
  <div class="absolute top-0 right-1/4 w-96 h-96 bg-industrial-copper/10 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute bottom-0 left-10 w-80 h-80 bg-sky-500/10 rounded-full blur-3xl pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      
      <!-- Left Hero Text Column (7 cols) -->
      <div class="lg:col-span-7 space-y-6">
        
        <!-- Trust Badge -->
        <div class="inline-flex items-center gap-2.5 px-3.5 py-1.5 rounded-full bg-slate-900 border border-slate-700/80 text-xs font-semibold text-slate-300">
          <span class="w-2 h-2 rounded-full bg-industrial-copper animate-pulse"></span>
          <span>ISO 9001:2015 CERTIFIED B2B MANUFACTURER</span>
        </div>

        <!-- Main Title -->
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black text-white tracking-tight leading-[1.1]">
          {headline.split('&').map((part, index) => (
            index === 0 ? (
              <span>{part} &amp; <br className="hidden sm:inline" /></span>
            ) : (
              <span class="text-transparent bg-clip-text bg-gradient-to-r from-industrial-copper via-amber-400 to-amber-200">{part}</span>
            )
          ))}
        </h1>

        <!-- Supporting Text -->
        <p class="text-base sm:text-lg text-slate-300 max-w-2xl font-normal leading-relaxed">
          {subheadline}
        </p>

        <!-- Feature Pills -->
        <div class="flex flex-wrap items-center gap-3 pt-2">
          <div class="flex items-center gap-2 bg-slate-900/90 border border-slate-800 px-3 py-1.5 rounded-lg text-xs font-medium text-slate-300">
            <svg class="w-4 h-4 text-industrial-copper" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
            High-Temp Coating &amp; Metalizing
          </div>
          <div class="flex items-center gap-2 bg-slate-900/90 border border-slate-800 px-3 py-1.5 rounded-lg text-xs font-medium text-slate-300">
            <svg class="w-4 h-4 text-industrial-copper" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
            Custom Machining &amp; Tolerances
          </div>
          <div class="flex items-center gap-2 bg-slate-900/90 border border-slate-800 px-3 py-1.5 rounded-lg text-xs font-medium text-slate-300">
            <svg class="w-4 h-4 text-industrial-copper" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
            Severe Thermal Environments
          </div>
        </div>

        <!-- Action CTAs -->
        <div class="pt-4 flex flex-col sm:flex-row items-stretch sm:items-center gap-4">
          <a
            href="/products"
            class="px-8 py-4 bg-gradient-to-r from-industrial-copper to-amber-600 hover:from-amber-600 hover:to-industrial-copper text-white font-bold rounded-xl shadow-industrial-lg flex items-center justify-center gap-2 transition-all transform active:scale-95 text-base"
          >
            <span>{primaryCtaText}</span>
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
          </a>

          <button
            type="button"
            data-open-quote-modal
            class="px-8 py-4 bg-slate-900 hover:bg-slate-800 text-slate-200 hover:text-white font-bold rounded-xl border border-slate-700/80 flex items-center justify-center gap-2 transition-colors cursor-pointer text-base"
          >
            <svg class="w-5 h-5 text-industrial-copper" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
            <span>{secondaryCtaText}</span>
          </button>
        </div>

      </div>

      <!-- Right Visual Card Column (5 cols) -->
      <div class="lg:col-span-5 relative">
        <div class="relative rounded-2xl overflow-hidden border border-slate-800 bg-slate-900 shadow-industrial-lg p-2 group">
          <div class="aspect-4/3 rounded-xl overflow-hidden relative">
            <img
              src={heroImage}
              alt="VM Graphite High Temperature Material Processing"
              class="w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-700"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/20 to-transparent"></div>
          </div>

          <!-- Technical Metrics Overlay Grid -->
          <div class="p-6 grid grid-cols-3 gap-4 border-t border-slate-800 bg-slate-950/90 rounded-b-xl">
            <div class="text-center border-r border-slate-800 pr-2">
              <div class="text-xl sm:text-2xl font-black text-industrial-copper">99.9%</div>
              <div class="text-[10px] sm:text-xs font-semibold text-slate-400 uppercase tracking-wider mt-0.5">Carbon Purity</div>
            </div>
            <div class="text-center border-r border-slate-800 pr-2">
              <div class="text-xl sm:text-2xl font-black text-white">3000°C</div>
              <div class="text-[10px] sm:text-xs font-semibold text-slate-400 uppercase tracking-wider mt-0.5">Max Resistance</div>
            </div>
            <div class="text-center">
              <div class="text-xl sm:text-2xl font-black text-emerald-400">Zero</div>
              <div class="text-[10px] sm:text-xs font-semibold text-slate-400 uppercase tracking-wider mt-0.5">Defect Quality</div>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
