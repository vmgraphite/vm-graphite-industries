---
export interface Props {
  headline?: string;
  subheadline?: string;
  primaryCtaText?: string;
  secondaryCtaText?: string;
  coreCapabilities?: string[];
  products?: Array<{
    name: string;
    slug: string;
    categoryName?: string;
    shortDescription?: string;
    mainImage?: string;
    specifications?: Array<{ name: string; value: string }>;
  }>;
}

const {
  headline = 'Advanced Graphite & Industrial Material Solutions',
  subheadline = 'Precision-manufactured high-density graphite crucibles, colloidal graphite suspensions, synthetic seals, and high-tensile doctor blades engineered for severe thermal and chemical operating environments.',
  primaryCtaText = 'Explore Product Range',
  secondaryCtaText = 'Request Custom Quote',
  coreCapabilities = [],
  products = [],
} = Astro.props;

// Headline split for stylish gradient accent
const parts = headline.split('&');
const headlinePart1 = parts[0]?.trim() || headline;
const headlinePart2 = parts[1]?.trim() || '';

// Fallback showcase items if no products are explicitly selected in Sanity yet
const defaultShowcase = [
  {
    id: 'crucibles',
    tabName: 'Graphite Crucibles',
    title: 'Isostatic Graphite Crucibles',
    tagline: 'Engineered for extreme thermal metallurgy up to 3000°C with Alubonding™ anti-oxidation protection.',
    image: '/images/products/graphite-crucibles.jpg',
    url: '/products/graphite-crucibles',
    badge: '3000°C Max Heat',
    badgeColor: 'text-amber-400 border-amber-500/30 bg-amber-500/10',
    stat1Val: '3000°C',
    stat1Lbl: 'Thermal Rating',
    stat2Val: '99.9%',
    stat2Lbl: 'Carbon Purity',
    stat3Val: '±0.02mm',
    stat3Lbl: 'CNC Precision',
  },
  {
    id: 'colloidal',
    tabName: 'Colloidal Dispersions',
    title: 'Colloidal Graphite Dispersions',
    tagline: 'Ultra-fine sub-micron graphite suspensions for die-casting, hot forging, and industrial mold release.',
    image: '/images/products/graphite-suspension.jpg',
    url: '/products/graphite-suspension',
    badge: 'Sub-Micron Grade',
    badgeColor: 'text-cyan-400 border-cyan-500/30 bg-cyan-500/10',
    stat1Val: '< 1µm',
    stat1Lbl: 'Particle Size',
    stat2Val: 'Water / Oil',
    stat2Lbl: 'Carrier Base',
    stat3Val: 'Zero Smoke',
    stat3Lbl: 'Eco Formulation',
  },
  {
    id: 'seals',
    tabName: 'Graphite Seals & Foil',
    title: 'Pure Flexible Graphite Foil & Seals',
    tagline: 'High-pressure expanded natural graphite gaskets and tapes offering impenetrable fluid containment.',
    image: '/images/products/graphite-foil-tape.jpg',
    url: '/products/graphite-foil-tape',
    badge: '99.9% Carbon Foil',
    badgeColor: 'text-emerald-400 border-emerald-500/30 bg-emerald-500/10',
    stat1Val: '-200 to 650°C',
    stat1Lbl: 'Temp Range',
    stat2Val: '100%',
    stat2Lbl: 'Non-Asbestos',
    stat3Val: 'High PSI',
    stat3Lbl: 'Pressure Class',
  },
  {
    id: 'doctor-blades',
    tabName: 'Doctor Blades',
    title: 'Precision High-Tensile Doctor Blades',
    tagline: 'Micro-honed Swedish carbon and stainless steel doctor blades for streak-free rotogravure & flexo printing.',
    image: '/images/products/carbon-steel-doctor-blades.jpg',
    url: '/products/carbon-steel-doctor-blades',
    badge: 'Micro-Honed Edge',
    badgeColor: 'text-purple-400 border-purple-500/30 bg-purple-500/10',
    stat1Val: 'Swedish',
    stat1Lbl: 'Steel Grade',
    stat2Val: 'Lamella / Bevel',
    stat2Lbl: 'Edge Profiles',
    stat3Val: 'Zero Streak',
    stat3Lbl: 'Wiping Quality',
  },
];

// Map Sanity products or fallback
const productList = Array.isArray(products) && products.length > 0 ? products.filter(Boolean) : [];
const showcaseItems = productList.length > 0
  ? productList.map((p, idx) => {
      const s1 = p.specifications?.[0] || { name: 'Thermal Rating', value: '3000°C' };
      const s2 = p.specifications?.[1] || { name: 'Carbon Purity', value: '99.9%' };
      const s3 = p.specifications?.[2] || { name: 'Precision', value: '±0.02mm' };
      return {
        id: p.slug || `prod-${idx}`,
        tabName: p.name && p.name.length > 22 ? p.name.substring(0, 20) + '...' : (p.name || 'Product'),
        title: p.name || 'Industrial Product',
        tagline: p.shortDescription || 'Engineered industrial graphite product with tight tolerances and extreme heat durability.',
        image: p.mainImage || '/images/products/graphite-crucibles.jpg',
        url: `/products/${p.slug}`,
        badge: p.categoryName || 'Industrial Grade',
        badgeColor: idx % 2 === 0 ? 'text-amber-400 border-amber-500/30 bg-amber-500/10' : 'text-cyan-400 border-cyan-500/30 bg-cyan-500/10',
        stat1Val: s1.value,
        stat1Lbl: s1.name,
        stat2Val: s2.value,
        stat2Lbl: s2.name,
        stat3Val: s3.value,
        stat3Lbl: s3.name,
      };
    })
  : defaultShowcase;
---

<section class="relative min-h-[85vh] lg:min-h-[90vh] flex items-center overflow-hidden bg-[#07090e] pt-8 pb-16 lg:pt-14 lg:pb-20 industrial-grid-bg">

  <!-- Ambient Glowing Backdrops -->
  <div class="absolute top-1/4 -left-32 w-[500px] h-[500px] bg-[radial-gradient(circle,rgba(240,101,67,0.14)_0%,transparent_70%)] pointer-events-none z-10"></div>
  <div class="absolute -top-24 right-1/4 w-[500px] h-[500px] bg-[radial-gradient(circle,rgba(199,130,16,0.10)_0%,transparent_70%)] pointer-events-none z-10"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-20 w-full">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-center">

      <!-- LEFT: Hero Animated Entrance Content -->
      <div class="lg:col-span-6 space-y-6">

        <!-- Entrance Element 1: Main Headline with Solid High-Contrast Accent -->
        <div class="space-y-1">
          <h1 class="text-3xl sm:text-4xl lg:text-[3.25rem] font-black text-white tracking-tight leading-[1.08]" style="font-family:'Outfit',sans-serif;">
            {headlinePart1}
            {headlinePart2 && (
              <span class="block text-[#f06543] font-black mt-1.5">
                &amp; {headlinePart2}
              </span>
            )}
          </h1>
        </div>

        <!-- Entrance Element 3: Subheadline -->
        <div>
          <p class="text-slate-300 text-sm sm:text-base max-w-xl leading-relaxed font-normal">
            {subheadline}
          </p>
        </div>

        <!-- Entrance Element 4: High-Conversion CTA Buttons -->
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3.5 pt-2">
          <a
            href="/products"
            class="forge-btn-primary rounded-full px-7 py-3.5 text-sm font-bold shadow-lg shadow-[#f06543]/20"
          >
            <span>{primaryCtaText}</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
            </svg>
          </a>
          <button
            type="button"
            data-open-quote-modal
            class="forge-btn-ghost rounded-full px-7 py-3.5 text-sm font-semibold hover:bg-white/[0.08] backdrop-blur-sm cursor-pointer"
          >
            <svg class="w-4 h-4 text-[#f06543]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
            </svg>
            <span>{secondaryCtaText}</span>
          </button>
        </div>

        <!-- Entrance Element 5: Operational Highlights Pills -->
        {(() => {
          const defaultCaps = [
            'Isostatic Hot Pressing',
            'Sub-Micron Dispersions',
            'CNC Machining ±0.02mm',
            'Global Export 20+ Countries',
          ];
          const list = Array.isArray(coreCapabilities) && coreCapabilities.length > 0
            ? coreCapabilities.filter(Boolean)
            : defaultCaps;
          const colors = ['bg-amber-400', 'bg-[#f06543]', 'bg-emerald-400', 'bg-sky-400', 'bg-purple-400'];

          return (
            <div class="pt-4 border-t border-white/10 space-y-2">
              <div class="text-[11px] uppercase tracking-wider text-slate-400 font-mono font-semibold">
                <span>Core Manufacturing Capabilities</span>
              </div>
              <div class="flex flex-wrap items-center gap-2 text-xs text-slate-300 font-mono">
                {list.map((cap, idx) => (
                  <span class="flex items-center gap-1.5 bg-white/[0.05] border border-white/[0.1] px-3 py-1.5 rounded-lg backdrop-blur-sm">
                    <span class={`w-1.5 h-1.5 rounded-full ${colors[idx % colors.length]}`}></span>
                    {cap}
                  </span>
                ))}
              </div>
            </div>
          );
        })()}

      </div>

      <!-- RIGHT: Interactive Product Showcase Card -->
      <div class="lg:col-span-6 relative">

        <!-- Main Showcase Frame -->
        <div class="relative bg-[#0d1017]/95 backdrop-blur-xl border border-white/[0.14] rounded-3xl overflow-hidden shadow-2xl">
          
          <!-- Category Quick Selection Tabs -->
          <div class="px-3 sm:px-4 py-3 border-b border-white/[0.08] bg-white/[0.03] flex items-center justify-between gap-2 overflow-x-auto no-scrollbar">
            <div class="flex items-center gap-1.5 sm:gap-2 w-full">
              {showcaseItems.map((item, idx) => (
                <button
                  type="button"
                  class={`hero-tab text-xs font-mono font-medium py-1.5 px-3.5 rounded-xl transition-colors shrink-0 cursor-pointer ${
                    idx === 0
                      ? 'bg-[#f06543] text-[#07090e] shadow-md font-bold'
                      : 'text-slate-400 hover:text-white hover:bg-white/[0.05]'
                  }`}
                  data-index={idx}
                >
                  {item.tabName}
                </button>
              ))}
            </div>
          </div>

          <!-- Product Image & Highlight Banner -->
          <div class="relative h-64 sm:h-76 overflow-hidden bg-black/60">
            {showcaseItems.map((item, idx) => (
              <div
                class={`hero-image-slide absolute inset-0 ${
                  idx === 0 ? 'block' : 'hidden'
                }`}
                data-slide-index={idx}
              >
                <img
                  src={item.image}
                  alt={item.title}
                  class="w-full h-full object-cover opacity-90"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-[#0d1017] via-[#0d1017]/40 to-transparent"></div>
                
                <!-- Info Tag Inside Slide -->
                <div class="absolute bottom-4 left-4 right-4 z-10 space-y-1.5">
                  <span class={`inline-block text-[10px] font-mono font-bold uppercase tracking-wider px-2.5 py-0.5 rounded-md border ${item.badgeColor}`}>
                    {item.badge}
                  </span>
                  <h3 class="text-xl sm:text-2xl font-bold text-white tracking-tight" style="font-family:'Outfit',sans-serif;">
                    {item.title}
                  </h3>
                  <p class="text-xs text-slate-300 line-clamp-2 font-normal leading-relaxed">
                    {item.tagline}
                  </p>
                </div>
              </div>
            ))}
          </div>

          <!-- Clean Specification Attributes & Action Bar -->
          <div class="p-4 sm:p-5 space-y-4">
            
            <!-- Sleek Responsive Spec Chips -->
            <div class="flex flex-wrap items-center gap-2">
              <div class="inline-flex items-center gap-1.5 bg-white/[0.04] border border-white/[0.08] px-3 py-1.5 rounded-lg text-xs font-mono">
                <span id="heroStat1Lbl" class="text-slate-400 font-semibold">{showcaseItems[0]?.stat1Lbl || 'Spec 1'}:</span>
                <span id="heroStat1Val" class="font-bold text-white">{showcaseItems[0]?.stat1Val || 'Standard'}</span>
              </div>
              <div class="inline-flex items-center gap-1.5 bg-white/[0.04] border border-white/[0.08] px-3 py-1.5 rounded-lg text-xs font-mono">
                <span id="heroStat2Lbl" class="text-slate-400 font-semibold">{showcaseItems[0]?.stat2Lbl || 'Spec 2'}:</span>
                <span id="heroStat2Val" class="font-bold text-[#f06543]">{showcaseItems[0]?.stat2Val || 'Standard'}</span>
              </div>
              <div class="inline-flex items-center gap-1.5 bg-white/[0.04] border border-white/[0.08] px-3 py-1.5 rounded-lg text-xs font-mono">
                <span id="heroStat3Lbl" class="text-slate-400 font-semibold">{showcaseItems[0]?.stat3Lbl || 'Spec 3'}:</span>
                <span id="heroStat3Val" class="font-bold text-cyan-400">{showcaseItems[0]?.stat3Val || 'Standard'}</span>
              </div>
            </div>

            <!-- Action Bar Inside Showcase -->
            <div class="flex items-center justify-between pt-2 border-t border-white/[0.06] gap-2">
              <a
                id="heroProductLink"
                href={showcaseItems[0]?.url || '/products'}
                class="text-xs text-[#f06543] font-bold font-mono hover:underline flex items-center gap-1 uppercase tracking-wider"
              >
                <span>View Full Specifications</span>
                <span>→</span>
              </a>
              <button
                type="button"
                data-open-quote-modal
                id="heroQuoteBtn"
                data-product-name={showcaseItems[0]?.title}
                data-product-category={showcaseItems[0]?.badge}
                class="px-5 py-2.5 bg-[#f06543] hover:bg-[#d4911c] text-[#07090e] font-extrabold text-xs rounded-xl transition-all shadow-md cursor-pointer"
              >
                <span>Quick Quote</span>
              </button>
            </div>
          </div>

        </div>

      </div>

    </div>
  </div>
</section>

<script is:inline define:vars={{ showcaseItems }}>
  let currentIndex = 0;
  const tabs = document.querySelectorAll('.hero-tab');
  const slides = document.querySelectorAll('.hero-image-slide');
  const stat1Val = document.getElementById('heroStat1Val');
  const stat1Lbl = document.getElementById('heroStat1Lbl');
  const stat2Val = document.getElementById('heroStat2Val');
  const stat2Lbl = document.getElementById('heroStat2Lbl');
  const stat3Val = document.getElementById('heroStat3Val');
  const stat3Lbl = document.getElementById('heroStat3Lbl');
  const productLink = document.getElementById('heroProductLink');
  const quoteBtn = document.getElementById('heroQuoteBtn');

  function switchTab(index) {
    if (!showcaseItems[index]) return;
    currentIndex = index;
    const item = showcaseItems[index];

    // Update tab button styles
    tabs.forEach((tab, i) => {
      if (i === index) {
        tab.classList.add('bg-[#f06543]', 'text-[#07090e]', 'shadow-md', 'font-bold');
        tab.classList.remove('text-slate-400', 'hover:text-white', 'hover:bg-white/[0.05]');
      } else {
        tab.classList.remove('bg-[#f06543]', 'text-[#07090e]', 'shadow-md', 'font-bold');
        tab.classList.add('text-slate-400', 'hover:text-white', 'hover:bg-white/[0.05]');
      }
    });

    // Update slides
    slides.forEach((slide, i) => {
      if (i === index) {
        slide.classList.remove('hidden');
        slide.classList.add('block');
      } else {
        slide.classList.remove('block');
        slide.classList.add('hidden');
      }
    });

    // Update metrics and link
    if (stat1Val) stat1Val.textContent = item.stat1Val;
    if (stat1Lbl) stat1Lbl.textContent = item.stat1Lbl + ':';
    if (stat2Val) stat2Val.textContent = item.stat2Val;
    if (stat2Lbl) stat2Lbl.textContent = item.stat2Lbl + ':';
    if (stat3Val) stat3Val.textContent = item.stat3Val;
    if (stat3Lbl) stat3Lbl.textContent = item.stat3Lbl + ':';
    if (productLink) productLink.href = item.url;
    if (quoteBtn) {
      quoteBtn.setAttribute('data-product-name', item.title);
      quoteBtn.setAttribute('data-product-category', item.badge);
    }
  }

  tabs.forEach((tab) => {
    tab.addEventListener('click', (e) => {
      const idx = parseInt(e.currentTarget.getAttribute('data-index') || '0', 10);
      switchTab(idx);
    });
  });
</script>
