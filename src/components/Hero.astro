---
export interface Props {
  headline?: string;
  subheadline?: string;
  heroImage?: string;
  primaryCtaText?: string;
  secondaryCtaText?: string;
}

const {
  headline = 'Advanced Graphite & Industrial Material Solutions',
  subheadline = 'Precision-manufactured high-density graphite crucibles, colloidal graphite suspensions, synthetic seals, and high-tensile doctor blades engineered for severe thermal and chemical operating environments.',
  heroImage: propHeroImage,
  primaryCtaText = 'Explore Products',
  secondaryCtaText = 'Get a Quote',
} = Astro.props;

const heroImage = propHeroImage || '/images/hero-industrial.jpg';
---

<section class="relative bg-gradient-to-b from-white via-slate-50 to-slate-100/70 text-slate-900 overflow-hidden py-24 lg:py-32 industrial-grid-light-bg border-b border-slate-200/80">
  
  <!-- Dynamic Light Ambient Glow Backdrops -->
  <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-gradient-to-tr from-amber-500/10 via-amber-400/5 to-sky-500/5 rounded-full blur-[120px] pointer-events-none animate-pulse-glow"></div>
  <div class="absolute top-10 right-10 w-96 h-96 bg-amber-500/5 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute bottom-10 left-10 w-96 h-96 bg-sky-500/5 rounded-full blur-3xl pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
      
      <!-- Left Hero Content (7 cols) -->
      <div class="lg:col-span-7 space-y-8 reveal-on-scroll">
        
        <!-- Trust Badge -->
        <div class="inline-flex items-center gap-2.5 px-4 py-1.5 rounded-full bg-white border border-slate-200 shadow-xs text-xs font-semibold text-slate-700 backdrop-blur-md">
          <span class="relative flex h-2.5 w-2.5">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-amber-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-industrial-copper"></span>
          </span>
          <span class="tracking-wide uppercase font-mono text-[11px] text-slate-800">ISO 9001:2015 CERTIFIED B2B MANUFACTURER</span>
        </div>

        <!-- Main Title -->
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black text-slate-900 tracking-tight leading-[1.1]">
          {headline.split('&').map((part, index) => (
            index === 0 ? (
              <span>{part} &amp; <br class="hidden sm:inline" /></span>
            ) : (
              <span class="text-transparent bg-clip-text bg-gradient-to-r from-industrial-copper via-amber-600 to-amber-700 font-extrabold">{part}</span>
            )
          ))}
        </h1>

        <!-- Supporting Text -->
        <p class="text-base sm:text-lg text-slate-600 max-w-2xl font-normal leading-relaxed">
          {subheadline}
        </p>

        <!-- Feature Pills -->
        <div class="flex flex-wrap items-center gap-3 pt-1">
          <div class="flex items-center gap-2 bg-white border border-slate-200 hover:border-slate-300 px-3.5 py-2 rounded-xl text-xs font-medium text-slate-700 backdrop-blur-sm transition-colors shadow-2xs">
            <svg class="w-4 h-4 text-industrial-copper shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
            <span>High-Temp Coating &amp; Metalizing</span>
          </div>
          <div class="flex items-center gap-2 bg-white border border-slate-200 hover:border-slate-300 px-3.5 py-2 rounded-xl text-xs font-medium text-slate-700 backdrop-blur-sm transition-colors shadow-2xs">
            <svg class="w-4 h-4 text-industrial-copper shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
            <span>Custom Machining &amp; Tolerances</span>
          </div>
          <div class="flex items-center gap-2 bg-white border border-slate-200 hover:border-slate-300 px-3.5 py-2 rounded-xl text-xs font-medium text-slate-700 backdrop-blur-sm transition-colors shadow-2xs">
            <svg class="w-4 h-4 text-industrial-copper shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
            <span>Severe Thermal Environments</span>
          </div>
        </div>

        <!-- Action CTAs -->
        <div class="pt-2 flex flex-col sm:flex-row items-stretch sm:items-center gap-4">
          <a
            href="/products"
            class="relative group overflow-hidden px-8 py-4 bg-gradient-to-r from-industrial-copper to-amber-600 hover:from-amber-600 hover:to-industrial-copper text-white font-bold rounded-xl shadow-[0_4px_20px_rgba(217,119,6,0.3)] flex items-center justify-center gap-2 transition-all transform hover:-translate-y-0.5 active:translate-y-0 text-base"
          >
            <span class="relative z-10">{primaryCtaText}</span>
            <svg class="w-5 h-5 relative z-10 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
          </a>

          <button
            type="button"
            data-open-quote-modal
            class="px-8 py-4 bg-white hover:bg-slate-50 text-slate-800 font-bold rounded-xl border border-slate-300 hover:border-amber-500/50 flex items-center justify-center gap-2 transition-all cursor-pointer text-base shadow-xs"
          >
            <svg class="w-5 h-5 text-industrial-copper" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
            <span>{secondaryCtaText}</span>
          </button>
        </div>

      </div>

      <!-- Right Visual Card Column (5 cols) -->
      <div class="lg:col-span-5 relative reveal-on-scroll">
        <div class="relative rounded-2xl overflow-hidden border border-slate-200/90 bg-white shadow-xl p-2.5 group hover:border-industrial-copper/40 transition-all duration-500">
          
          <!-- Image Wrapper -->
          <div class="aspect-4/3 rounded-xl overflow-hidden relative bg-slate-900">
            <img
              src={heroImage}
              alt="VM Graphite High Temperature Material Processing"
              class="w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-700"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-slate-950/70 via-slate-950/20 to-transparent"></div>
            
            <!-- Live Badge Overlay -->
            <div class="absolute top-4 right-4 bg-white/95 backdrop-blur-md border border-slate-200 px-3 py-1.5 rounded-full flex items-center gap-2 shadow-md">
              <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
              <span class="text-[11px] font-bold text-slate-800 tracking-wide uppercase font-mono">Precision Engineered</span>
            </div>
          </div>

          <!-- Technical Metrics Overlay Grid -->
          <div class="p-6 grid grid-cols-3 gap-4 border-t border-slate-100 bg-slate-50/90 rounded-b-xl">
            <div class="text-center border-r border-slate-200/80 pr-2">
              <div class="text-xl sm:text-2xl font-black text-industrial-copper font-mono">99.9%</div>
              <div class="text-[10px] sm:text-xs font-bold text-slate-600 uppercase tracking-wider mt-0.5">Carbon Purity</div>
            </div>
            <div class="text-center border-r border-slate-200/80 pr-2">
              <div class="text-xl sm:text-2xl font-black text-slate-900 font-mono">3000°C</div>
              <div class="text-[10px] sm:text-xs font-bold text-slate-600 uppercase tracking-wider mt-0.5">Max Temp</div>
            </div>
            <div class="text-center">
              <div class="text-xl sm:text-2xl font-black text-emerald-600 font-mono">Zero</div>
              <div class="text-[10px] sm:text-xs font-bold text-slate-600 uppercase tracking-wider mt-0.5">Defect Quality</div>
            </div>
          </div>

        </div>
      </div>

    </div>
  </div>
</section>


