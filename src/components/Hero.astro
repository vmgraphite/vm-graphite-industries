---
export interface Props {
  headline?: string;
  subheadline?: string;
  heroImage?: string;
  primaryCtaText?: string;
  secondaryCtaText?: string;
}

const {
  headline = 'Advanced Graphite & Industrial Material Solutions',
  subheadline = 'Precision-manufactured high-density graphite crucibles, colloidal graphite suspensions, synthetic seals, and high-tensile doctor blades engineered for severe thermal and chemical operating environments.',
  heroImage: propHeroImage,
  primaryCtaText = 'Explore Product Range',
  secondaryCtaText = 'Request Quote',
} = Astro.props;

const heroImage = propHeroImage || '/images/hero-industrial.jpg';

// Headline split
const parts = headline.split('&');
const headlinePart1 = parts[0]?.trim() || headline;
const headlinePart2 = parts[1]?.trim() || '';
---

<section class="relative flex items-center overflow-hidden bg-[#07090e] pt-8 pb-16 lg:pt-14 lg:pb-24 industrial-grid-bg">

  <!-- Ambient Light Orbs -->
  <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[900px] h-[550px] bg-[radial-gradient(ellipse_at_top,rgba(232,160,32,0.16),transparent_65%)] pointer-events-none"></div>
  <div class="absolute top-1/3 left-10 w-[400px] h-[400px] bg-[radial-gradient(circle,rgba(56,189,248,0.06),transparent_70%)] pointer-events-none"></div>
  <div class="absolute bottom-0 inset-x-0 h-32 bg-gradient-to-t from-[#07090e] to-transparent pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 w-full">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-10 items-center">

      <!-- LEFT: Headline & Actions -->
      <div class="lg:col-span-7 space-y-7 reveal-on-scroll">
        
        <!-- Trust badge with pulse ping -->
        <div class="inline-flex items-center gap-2.5 px-4 py-1.5 rounded-full border border-amber-500/30 bg-amber-500/10 text-[#f7c355] font-mono text-[11px] font-bold uppercase tracking-wider shadow-[0_0_20px_rgba(232,160,32,0.15)]">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-amber-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-amber-400"></span>
          </span>
          <span>ISO 9001:2015 Certified B2B Manufacturer</span>
        </div>

        <!-- Main headline -->
        <h1 class="display-lg text-white font-black tracking-tight leading-[1.04]">
          {headlinePart1}
          {headlinePart2 && (
            <span class="block text-gold-gradient font-black mt-1">
              &amp; {headlinePart2}
            </span>
          )}
        </h1>

        <!-- Subheadline -->
        <p class="text-slate-300 text-sm sm:text-base max-w-xl leading-relaxed font-normal">
          {subheadline}
        </p>

        <!-- CTA Action Buttons -->
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3.5 pt-2">
          <a href="/products" class="forge-btn-primary group rounded-xl">
            <span>{primaryCtaText}</span>
            <svg class="w-4 h-4 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
          </a>
          <button type="button" data-open-quote-modal class="forge-btn-ghost rounded-xl">
            <svg class="w-4 h-4 text-[#f7c355]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
            <span>{secondaryCtaText}</span>
          </button>
        </div>

        <!-- Key Capability Badges -->
        <div class="flex flex-wrap items-center gap-3 pt-3 text-xs text-slate-400 font-mono">
          <span class="flex items-center gap-1.5 bg-white/5 border border-white/8 px-3 py-1.5 rounded-lg">
            <span class="w-1.5 h-1.5 rounded-full bg-[#f7c355]"></span>
            Isostatic Pressed
          </span>
          <span class="flex items-center gap-1.5 bg-white/5 border border-white/8 px-3 py-1.5 rounded-lg">
            <span class="w-1.5 h-1.5 rounded-full bg-[#38bdf8]"></span>
            Colloidal Dispersions
          </span>
          <span class="flex items-center gap-1.5 bg-white/5 border border-white/8 px-3 py-1.5 rounded-lg">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
            Custom CNC Machined
          </span>
        </div>
      </div>

      <!-- RIGHT: Interactive Spec Card with Live Counters -->
      <div class="lg:col-span-5 reveal-scale">
        <div class="glow-card border-white/10 rounded-2xl shadow-[0_20px_50px_rgba(0,0,0,0.8),0_0_40px_rgba(232,160,32,0.12)]">

          <!-- Card HUD header -->
          <div class="flex items-center justify-between px-5 py-3.5 border-b border-white/10 bg-[#0d1017]">
            <div class="flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-[#f7c355] animate-ambient-pulse"></span>
              <span class="text-[11px] font-black text-[#f7c355] uppercase tracking-widest font-mono">Material Specs &amp; Quality</span>
            </div>
            <span class="text-[10px] text-slate-400 font-mono bg-white/5 px-2 py-0.5 rounded border border-white/8">ISO 9001:2015</span>
          </div>

          <!-- Feature Image Preview with Overlay -->
          <div class="h-48 overflow-hidden relative bg-[#040508]">
            <img
              src={heroImage}
              alt="VM Graphite High Temperature Testing"
              class="w-full h-full object-cover opacity-80 hover:scale-105 transition-transform duration-700"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-[#0d1017] via-transparent to-transparent"></div>
            
            <!-- Floating Floating Badge -->
            <div class="absolute bottom-3 left-4 bg-[#07090e]/90 backdrop-blur-md px-3.5 py-1.5 rounded-xl border border-amber-500/30 text-xs font-bold text-slate-200 flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
              <span>Ultra-High Purity Carbon</span>
            </div>
          </div>

          <!-- Live Metrics Grid -->
          <div class="grid grid-cols-3 divide-x divide-white/10 bg-[#0a0d14] border-t border-b border-white/10">
            <div class="px-3 py-4 text-center">
              <div
                class="text-2xl font-black text-[#f7c355] font-mono leading-none"
                data-counter-target="99.9"
                data-counter-decimals="1"
                data-counter-suffix="%"
              >
                99.9%
              </div>
              <div class="text-[10px] font-bold text-slate-400 uppercase tracking-wider mt-1.5 font-mono">Carbon Purity</div>
            </div>
            <div class="px-3 py-4 text-center">
              <div
                class="text-2xl font-black text-white font-mono leading-none"
                data-counter-target="3000"
                data-counter-decimals="0"
                data-counter-suffix="°C"
              >
                3000°C
              </div>
              <div class="text-[10px] font-bold text-slate-400 uppercase tracking-wider mt-1.5 font-mono">Max Thermal</div>
            </div>
            <div class="px-3 py-4 text-center">
              <div
                class="text-2xl font-black text-[#38bdf8] font-mono leading-none"
                data-counter-target="20"
                data-counter-decimals="0"
                data-counter-suffix="+"
              >
                20+
              </div>
              <div class="text-[10px] font-bold text-slate-400 uppercase tracking-wider mt-1.5 font-mono">Countries</div>
            </div>
          </div>

          <!-- Key Feature Checklist -->
          <div class="p-5 bg-[#0d1017] space-y-2.5">
            {[
              'Alubonding™ proprietary bonding technology',
              'CNC-machined geometries to ±0.02mm tolerance',
              'Specialized colloidal formulations for die-casting',
              'Flexible thermal graphite foil & severe-duty seals',
            ].map((f) => (
              <div class="flex items-center gap-2.5 text-xs text-slate-300">
                <svg class="w-3.5 h-3.5 text-[#f7c355] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
                <span>{f}</span>
              </div>
            ))}
          </div>

          <!-- Card Footer Action -->
          <div class="px-5 py-3 bg-[#090c12] border-t border-white/10 flex items-center justify-between">
            <span class="text-[11px] text-slate-400 font-mono">Immediate Dispatch Available</span>
            <a href="/products" class="text-xs font-bold text-[#f7c355] hover:text-amber-300 transition-colors font-mono uppercase tracking-wider flex items-center gap-1">
              <span>View Catalog</span>
              <span>→</span>
            </a>
          </div>

        </div>
      </div>

    </div>
  </div>

</section>
