---
export interface Props {
  headline?: string;
  subheadline?: string;
  primaryCtaText?: string;
  secondaryCtaText?: string;
  coreCapabilities?: string[];
  products?: Array<{
    name: string;
    slug: string;
    categoryName?: string;
    shortDescription?: string;
    mainImage?: string;
    specifications?: Array<{ name: string; value: string }>;
  }>;
}

const {
  headline = 'Advanced Graphite & Industrial Material Solutions',
  subheadline = 'Precision-manufactured high-density graphite crucibles, colloidal graphite suspensions, synthetic seals, and high-tensile doctor blades engineered for severe thermal and chemical operating environments.',
  primaryCtaText = 'Explore Product Range',
  secondaryCtaText = 'Request Custom Quote',
  coreCapabilities = [],
  products = [],
} = Astro.props;

// Headline split for stylish gradient accent
const parts = headline.split('&');
const headlinePart1 = parts[0]?.trim() || headline;
const headlinePart2 = parts[1]?.trim() || '';

// 6 Main Featured Products requested for Hero Showcase
const defaultShowcase = [
  {
    id: 'graphite-suspension',
    tabName: 'Graphite Suspension',
    title: 'Graphite Suspension',
    tagline: 'Colloidal aqueous and solvent-based graphite dispersion engineered for high-temperature forging die lubrication and conductive metal coating applications.',
    image: '/images/products/colloidal-graphite-dispersion.jpg',
    url: '/products/graphite-suspension',
    badge: 'Sub-Micron Grade',
    badgeColor: 'text-cyan-400 border-cyan-500/30 bg-cyan-500/10',
    stat1Val: '≥ 99.5%',
    stat1Lbl: 'Carbon Purity',
    stat2Val: '< 5.0 µm',
    stat2Lbl: 'Particle Size',
    stat3Val: '1100°C',
    stat3Lbl: 'Max Temp',
  },
  {
    id: 'graphite-foil-tape',
    tabName: 'Graphite Foil Tape',
    title: 'Graphite Foil Tape',
    tagline: 'Self-adhesive corrugated flexible expanded graphite foil tape designed for instant valve stem packing and spiral wound gasket manufacturing.',
    image: '/images/products/graphite-foil-tape-pallet.jpg',
    url: '/products/graphite-foil-tape',
    badge: '99.9% Carbon Foil',
    badgeColor: 'text-emerald-400 border-emerald-500/30 bg-emerald-500/10',
    stat1Val: '≥ 99.0%',
    stat1Lbl: 'Carbon Content',
    stat2Val: '0.38 - 0.5mm',
    stat2Lbl: 'Thickness',
    stat3Val: '450°C',
    stat3Lbl: 'Operating Temp',
  },
  {
    id: 'x-ray-grade-selenium-granules',
    tabName: 'Selenium Granules',
    title: 'X-Ray Grade Selenium Granules',
    tagline: 'Ultra-pure 99.999% (5N) spherical selenium granules and vitreous beads engineered for X-ray photoreceptors and radiation detectors.',
    image: '/images/products/selenium-granules.jpg',
    url: '/products/x-ray-grade-selenium-granules',
    badge: '5N 99.999% Ultra Pure',
    badgeColor: 'text-purple-400 border-purple-500/30 bg-purple-500/10',
    stat1Val: '≥ 99.999%',
    stat1Lbl: 'Selenium Purity',
    stat2Val: '1.0 - 3.5mm',
    stat2Lbl: 'Granule Size',
    stat3Val: '< 5 ppm',
    stat3Lbl: 'Impurities',
  },
  {
    id: 'graphite-powder',
    tabName: 'Graphite Powder',
    title: 'Graphite Powder',
    tagline: 'Ultra-fine micronized synthetic and natural flake graphite powder for conductive coatings, metallurgy, and lubricant blending.',
    image: '/images/products/graphite-powder.jpg',
    url: '/products/graphite-powder',
    badge: 'Micronized Grade',
    badgeColor: 'text-amber-400 border-amber-500/30 bg-amber-500/10',
    stat1Val: '≥ 99.9%',
    stat1Lbl: 'Carbon Purity',
    stat2Val: '< 10 µm',
    stat2Lbl: 'D50 Size',
    stat3Val: '≤ 0.05%',
    stat3Lbl: 'Ash Content',
  },
  {
    id: 'graphite-sleeves',
    tabName: 'Graphite Sleeves',
    title: 'Graphite Sleeves',
    tagline: 'Custom machined graphite cylindrical sleeves and bushings designed for high-temperature pumps, casting dies, and thermal barriers.',
    image: '/images/products/graphite-sleeves-machined.jpg',
    url: '/products/graphite-sleeves',
    badge: 'Precision Machined',
    badgeColor: 'text-blue-400 border-blue-500/30 bg-blue-500/10',
    stat1Val: '± 0.02 mm',
    stat1Lbl: 'Tolerance',
    stat2Val: '35 - 48 MPa',
    stat2Lbl: 'Strength',
    stat3Val: '2800°C',
    stat3Lbl: 'Max Service Temp',
  },
  {
    id: 'graphite-crucibles',
    tabName: 'Graphite Crucibles',
    title: 'Graphite Crucibles',
    tagline: 'Isostatically pressed silicon-carbide bonded graphite crucibles crafted for melting non-ferrous alloys, copper, brass, and aluminum.',
    image: '/images/products/graphite-crucibles-cups.jpg',
    url: '/products/graphite-crucibles',
    badge: '3000°C Max Heat',
    badgeColor: 'text-amber-400 border-amber-500/30 bg-amber-500/10',
    stat1Val: '1650°C',
    stat1Lbl: 'Max Temp',
    stat2Val: 'SiC-Graphite',
    stat2Lbl: 'Material',
    stat3Val: '1kg - 1000kg',
    stat3Lbl: 'Capacity',
  },
];

// Strictly allowed slugs for the hero right-side showcase in exact requested order:
const ALLOWED_HERO_SLUGS = [
  'graphite-suspension',
  'graphite-foil-tape',
  'x-ray-grade-selenium-granules',
  'graphite-powder',
  'graphite-sleeves',
  'graphite-crucibles',
];

// Map products passed from Sanity (homePage.heroProducts) or use defaultShowcase
// Strictly filter so NO extra products can ever appear
const rawProductList = Array.isArray(products) && products.length > 0 ? products.filter(Boolean) : [];
const filteredSanityProducts = ALLOWED_HERO_SLUGS.map((slug) =>
  rawProductList.find((p) => p.slug === slug)
).filter(Boolean);

const showcaseItems = filteredSanityProducts.length === ALLOWED_HERO_SLUGS.length
  ? filteredSanityProducts.map((p, idx) => {
      const s1 = p.specifications?.[0] || { name: 'Carbon Purity', value: '≥ 99.5%' };
      const s2 = p.specifications?.[1] || { name: 'Specification', value: 'Industrial Grade' };
      const s3 = p.specifications?.[2] || { name: 'Standard', value: 'High Performance' };
      return {
        id: p.slug || `prod-${idx}`,
        tabName: p.name && p.name.length > 22 ? p.name.substring(0, 20) + '...' : (p.name || 'Product'),
        title: p.name || 'Industrial Product',
        tagline: p.shortDescription || 'Engineered industrial graphite product with tight tolerances and extreme heat durability.',
        image: p.mainImage || '/images/products/colloidal-graphite-dispersion.jpg',
        url: `/products/${p.slug}`,
        badge: p.categoryName || 'Industrial Grade',
        badgeColor: idx % 3 === 0
          ? 'text-cyan-400 border-cyan-500/30 bg-cyan-500/10'
          : idx % 3 === 1
          ? 'text-emerald-400 border-emerald-500/30 bg-emerald-500/10'
          : 'text-amber-400 border-amber-500/30 bg-amber-500/10',
        stat1Val: s1.value,
        stat1Lbl: s1.name,
        stat2Val: s2.value,
        stat2Lbl: s2.name,
        stat3Val: s3.value,
        stat3Lbl: s3.name,
      };
    })
  : defaultShowcase;
---

<section class="relative min-h-[85vh] lg:min-h-[90vh] flex items-center overflow-hidden bg-[#07090e] pt-8 pb-16 lg:pt-14 lg:pb-20 industrial-grid-bg">

  <!-- Interactive Graphite Ember Particle Canvas (Reacts to cursor!) -->
  <canvas id="hero-ember-canvas" class="absolute inset-0 w-full h-full pointer-events-none z-10 opacity-75"></canvas>

  <!-- Ambient Glowing Backdrops -->
  <div class="absolute top-1/4 -left-32 w-[500px] h-[500px] bg-[radial-gradient(circle,rgba(255,102,54,0.15)_0%,transparent_70%)] pointer-events-none z-10 animate-pulse-glow"></div>
  <div class="absolute -top-24 right-1/4 w-[500px] h-[500px] bg-[radial-gradient(circle,rgba(255,102,54,0.10)_0%,transparent_70%)] pointer-events-none z-10"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-20 w-full">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-center">

      <!-- LEFT: Hero Animated Entrance Content -->
      <div class="lg:col-span-6 space-y-6">

        <!-- Headline with Stagger Reveal -->
        <div data-reveal="fade-up" data-reveal-delay="100">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/[0.04] border border-white/10 backdrop-blur-md mb-3">
            <span class="w-1.5 h-1.5 rounded-full bg-[var(--primary)] animate-ping"></span>
            <span class="text-[10px] font-mono font-bold text-theme-bright uppercase tracking-wider">ISO 9001:2015 High-Purity Graphite</span>
          </div>

          <h1 class="text-3xl sm:text-4xl lg:text-[3.25rem] font-black text-white tracking-tight leading-[1.08]" style="font-family:'Outfit',sans-serif;">
            {headlinePart1}
            {headlinePart2 && (
              <span class="block text-theme font-black mt-1.5">
                &amp; {headlinePart2}
              </span>
            )}
          </h1>
        </div>

        <!-- Subheadline -->
        <div data-reveal="fade-up" data-reveal-delay="200">
          <p class="text-slate-300 text-sm sm:text-base max-w-xl leading-relaxed font-normal">
            {subheadline}
          </p>
        </div>

        <!-- High-Conversion CTA Buttons with Magnetic Hover -->
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3.5 pt-2" data-reveal="fade-up" data-reveal-delay="300">
          <a
            href="/products"
            data-magnetic
            class="forge-btn-primary rounded-full px-7 py-3.5 text-sm font-bold shadow-lg shadow-[var(--primary)]/20 group"
          >
            <span>{primaryCtaText}</span>
            <svg class="w-4 h-4 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
            </svg>
          </a>
          <button
            type="button"
            data-open-quote-modal
            data-magnetic
            class="forge-btn-ghost rounded-full px-7 py-3.5 text-sm font-semibold hover:bg-white/[0.08] backdrop-blur-sm cursor-pointer"
          >
            <svg class="w-4 h-4 text-theme" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
            </svg>
            <span>{secondaryCtaText}</span>
          </button>
        </div>

        <!-- Operational Highlights Pills -->
        {(() => {
          const defaultCaps = [
            'Isostatic Hot Pressing',
            'Sub-Micron Dispersions',
            'CNC Machining ±0.02mm',
            'Global Export 20+ Countries',
          ];
          const list = Array.isArray(coreCapabilities) && coreCapabilities.length > 0
            ? coreCapabilities.filter(Boolean)
            : defaultCaps;
          const colors = ['bg-amber-400', 'bg-[var(--primary)]', 'bg-emerald-400', 'bg-sky-400', 'bg-purple-400'];

          return (
            <div class="pt-4 border-t border-white/10 space-y-2" data-reveal="fade-up" data-reveal-delay="400">
              <div class="text-[11px] uppercase tracking-wider text-slate-400 font-mono font-semibold">
                <span>Core Manufacturing Capabilities</span>
              </div>
              <div class="flex flex-wrap items-center gap-2 text-xs text-slate-300 font-mono">
                {list.map((cap, idx) => (
                  <span class="flex items-center gap-1.5 bg-white/[0.05] border border-white/[0.1] px-3 py-1.5 rounded-lg backdrop-blur-sm hover:border-white/25 transition-all">
                    <span class={`w-1.5 h-1.5 rounded-full ${colors[idx % colors.length]}`}></span>
                    {cap}
                  </span>
                ))}
              </div>
            </div>
          );
        })()}

      </div>

      <!-- RIGHT: Interactive 3D Perspective Showcase Card -->
      <div class="lg:col-span-6 relative" data-reveal="zoom-in" data-reveal-delay="250">

        <!-- Main Showcase Frame with 3D Tilt -->
        <div id="heroShowcaseCard" data-tilt data-tilt-max="5" class="relative bg-[#0d1017]/95 backdrop-blur-xl border border-white/[0.14] rounded-3xl overflow-hidden shadow-2xl glow-card">
          
          <!-- Category Quick Selection Tabs -->
          <div id="heroTabsContainer" class="px-3 sm:px-4 py-3 border-b border-white/[0.08] bg-white/[0.03] flex items-center justify-between gap-2 overflow-x-auto no-scrollbar scroll-smooth relative">
            <div class="flex items-center gap-1.5 sm:gap-2 w-full">
              {showcaseItems.map((item, idx) => (
                <button
                  type="button"
                  class={`hero-tab text-xs font-mono font-medium py-1.5 px-3.5 rounded-xl transition-all duration-300 shrink-0 cursor-pointer whitespace-nowrap relative ${
                    idx === 0
                      ? 'bg-[var(--primary)] text-white shadow-[0_0_15px_rgba(255,102,54,0.4)] font-bold scale-[1.03]'
                      : 'text-slate-400 hover:text-white hover:bg-white/[0.06]'
                  }`}
                  data-index={idx}
                >
                  <span class="relative z-10 flex items-center gap-1.5">
                    {idx === 0 && <span class="w-1.5 h-1.5 rounded-full bg-white animate-pulse"></span>}
                    {item.tabName}
                  </span>
                </button>
              ))}
            </div>
          </div>

          <!-- Micro Animated Countdown Progress Bar -->
          <div class="h-0.5 w-full bg-white/[0.06] overflow-hidden relative">
            <div id="heroProgressBar" class="h-full bg-gradient-to-r from-[var(--primary)] via-amber-400 to-[var(--primary)] w-0 transition-all shadow-[0_0_8px_var(--primary)]"></div>
          </div>

          <!-- Product Image & Highlight Banner with Cinematic Transition -->
          <div class="relative h-64 sm:h-76 overflow-hidden bg-black/80">
            {showcaseItems.map((item, idx) => (
              <div
                class={`hero-image-slide absolute inset-0 transition-all duration-700 ease-out transform ${
                  idx === 0 ? 'opacity-100 scale-100 z-10' : 'opacity-0 scale-95 pointer-events-none z-0'
                }`}
                data-slide-index={idx}
              >
                <img
                  src={item.image}
                  alt={item.title}
                  class="w-full h-full object-cover opacity-90 transition-transform duration-1000 ease-out hover:scale-105"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-[#0d1017] via-[#0d1017]/40 to-transparent"></div>
                
                <!-- Info Tag Inside Slide with Slide-Up Transition -->
                <div class="absolute bottom-4 left-4 right-4 z-10 space-y-1.5 transform transition-transform duration-500">
                  <span class={`inline-block text-[10px] font-mono font-bold uppercase tracking-wider px-2.5 py-0.5 rounded-md border backdrop-blur-md ${item.badgeColor} shadow-sm`}>
                    {item.badge}
                  </span>
                  <h3 class="text-xl sm:text-2xl font-bold text-white tracking-tight drop-shadow-md" style="font-family:'Outfit',sans-serif;">
                    {item.title}
                  </h3>
                  <p class="text-xs text-slate-300 line-clamp-2 font-normal leading-relaxed drop-shadow">
                    {item.tagline}
                  </p>
                </div>
              </div>
            ))}
          </div>

          <!-- Clean Specification Attributes & Action Bar -->
          <div class="p-4 sm:p-5 space-y-4">
            
            <!-- Sleek Responsive Spec Chips -->
            <div class="flex flex-wrap items-center gap-2">
              <div class="inline-flex items-center gap-1.5 bg-white/[0.04] border border-white/[0.08] px-3 py-1.5 rounded-lg text-xs font-mono">
                <span id="heroStat1Lbl" class="text-slate-400 font-semibold">{showcaseItems[0]?.stat1Lbl || 'Spec 1'}:</span>
                <span id="heroStat1Val" class="font-bold text-white">{showcaseItems[0]?.stat1Val || 'Standard'}</span>
              </div>
              <div class="inline-flex items-center gap-1.5 bg-white/[0.04] border border-white/[0.08] px-3 py-1.5 rounded-lg text-xs font-mono">
                <span id="heroStat2Lbl" class="text-slate-400 font-semibold">{showcaseItems[0]?.stat2Lbl || 'Spec 2'}:</span>
                <span id="heroStat2Val" class="font-bold text-theme">{showcaseItems[0]?.stat2Val || 'Standard'}</span>
              </div>
              <div class="inline-flex items-center gap-1.5 bg-white/[0.04] border border-white/[0.08] px-3 py-1.5 rounded-lg text-xs font-mono">
                <span id="heroStat3Lbl" class="text-slate-400 font-semibold">{showcaseItems[0]?.stat3Lbl || 'Spec 3'}:</span>
                <span id="heroStat3Val" class="font-bold text-cyan-400">{showcaseItems[0]?.stat3Val || 'Standard'}</span>
              </div>
            </div>

            <!-- Action Bar Inside Showcase -->
            <div class="flex items-center justify-between pt-2 border-t border-white/[0.06] gap-2">
              <a
                id="heroProductLink"
                href={showcaseItems[0]?.url || '/products'}
                class="text-xs text-theme-bright font-bold font-mono hover:underline flex items-center gap-1 uppercase tracking-wider"
              >
                <span>View Full Specifications</span>
                <span>→</span>
              </a>
              <button
                type="button"
                data-open-quote-modal
                id="heroQuoteBtn"
                data-product-name={showcaseItems[0]?.title}
                data-product-category={showcaseItems[0]?.badge}
                class="px-5 py-2.5 bg-[var(--primary)] hover:bg-[var(--primary-hover)] text-white font-extrabold text-xs rounded-xl transition-all shadow-md cursor-pointer forge-btn-primary"
              >
                <span>Quick Quote</span>
              </button>
            </div>
          </div>

        </div>

      </div>

    </div>
  </div>
</section>

<script is:inline define:vars={{ showcaseItems }}>
  let currentIndex = 0;
  const tabs = document.querySelectorAll('.hero-tab');
  const slides = document.querySelectorAll('.hero-image-slide');
  const tabsContainer = document.getElementById('heroTabsContainer');
  const showcaseCard = document.getElementById('heroShowcaseCard');
  const stat1Val = document.getElementById('heroStat1Val');
  const stat1Lbl = document.getElementById('heroStat1Lbl');
  const stat2Val = document.getElementById('heroStat2Val');
  const stat2Lbl = document.getElementById('heroStat2Lbl');
  const stat3Val = document.getElementById('heroStat3Val');
  const stat3Lbl = document.getElementById('heroStat3Lbl');
  const productLink = document.getElementById('heroProductLink');
  const quoteBtn = document.getElementById('heroQuoteBtn');

  const progressBar = document.getElementById('heroProgressBar');

  let autoScrollTimer = null;
  const AUTO_SCROLL_INTERVAL = 2600; // auto-advance every 2.6 seconds

  function resetProgressBar() {
    if (!progressBar) return;
    progressBar.style.transition = 'none';
    progressBar.style.width = '0%';
    // Force reflow
    void progressBar.offsetWidth;
    progressBar.style.transition = `width ${AUTO_SCROLL_INTERVAL}ms linear`;
    progressBar.style.width = '100%';
  }

  function pauseProgressBar() {
    if (!progressBar) return;
    const computedWidth = window.getComputedStyle(progressBar).width;
    progressBar.style.transition = 'none';
    progressBar.style.width = computedWidth;
  }

  function switchTab(index, userTriggered = false) {
    if (!showcaseItems[index]) return;
    currentIndex = index;
    const item = showcaseItems[index];

    // Update tab button styles with smooth animations and tactile indicator
    tabs.forEach((tab, i) => {
      if (i === index) {
        tab.className = 'hero-tab text-xs font-mono font-medium py-1.5 px-3.5 rounded-xl transition-all duration-300 shrink-0 cursor-pointer whitespace-nowrap relative bg-[var(--primary)] text-white shadow-[0_0_15px_rgba(255,102,54,0.4)] font-bold scale-[1.03]';
        
        // Scroll ONLY the tabsContainer horizontally - NEVER scroll the window vertically!
        if (tabsContainer) {
          const tabOffsetLeft = tab.offsetLeft;
          const tabWidth = tab.offsetWidth;
          const containerWidth = tabsContainer.clientWidth;
          const targetScrollLeft = tabOffsetLeft - (containerWidth / 2) + (tabWidth / 2);
          tabsContainer.scrollTo({
            left: Math.max(0, targetScrollLeft),
            behavior: 'smooth'
          });
        }
      } else {
        tab.className = 'hero-tab text-xs font-mono font-medium py-1.5 px-3.5 rounded-xl transition-all duration-300 shrink-0 cursor-pointer whitespace-nowrap relative text-slate-400 hover:text-white hover:bg-white/[0.06]';
      }
    });

    // Update slides with smooth cinematic crossfade
    slides.forEach((slide, i) => {
      if (i === index) {
        slide.classList.remove('opacity-0', 'scale-95', 'pointer-events-none', 'z-0');
        slide.classList.add('opacity-100', 'scale-100', 'z-10');
      } else {
        slide.classList.remove('opacity-100', 'scale-100', 'z-10');
        slide.classList.add('opacity-0', 'scale-95', 'pointer-events-none', 'z-0');
      }
    });

    // Animate stats change with subtle fade
    [stat1Val, stat2Val, stat3Val].forEach(el => {
      if (el) {
        el.style.opacity = '0.4';
        el.style.transform = 'translateY(-2px)';
      }
    });

    setTimeout(() => {
      if (stat1Val) {
        stat1Val.textContent = item.stat1Val;
        stat1Val.style.opacity = '1';
        stat1Val.style.transform = 'translateY(0)';
      }
      if (stat1Lbl) stat1Lbl.textContent = item.stat1Lbl + ':';
      if (stat2Val) {
        stat2Val.textContent = item.stat2Val;
        stat2Val.style.opacity = '1';
        stat2Val.style.transform = 'translateY(0)';
      }
      if (stat2Lbl) stat2Lbl.textContent = item.stat2Lbl + ':';
      if (stat3Val) {
        stat3Val.textContent = item.stat3Val;
        stat3Val.style.opacity = '1';
        stat3Val.style.transform = 'translateY(0)';
      }
      if (stat3Lbl) stat3Lbl.textContent = item.stat3Lbl + ':';
    }, 150);

    if (productLink) productLink.href = item.url;
    if (quoteBtn) {
      quoteBtn.setAttribute('data-product-name', item.title);
      quoteBtn.setAttribute('data-product-category', item.badge);
    }

    resetProgressBar();

    if (userTriggered) {
      restartAutoScroll();
    }
  }

  // Only auto-scroll when the hero section is visible on screen
  let isHeroVisible = true;
  if ('IntersectionObserver' in window && showcaseCard) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          isHeroVisible = entry.isIntersecting;
          if (!isHeroVisible) {
            pauseProgressBar();
          } else {
            resetProgressBar();
          }
        });
      },
      { threshold: 0.15 }
    );
    observer.observe(showcaseCard);
  }

  function startAutoScroll() {
    stopAutoScroll();
    resetProgressBar();
    autoScrollTimer = setInterval(() => {
      // Don't auto-advance if the user has scrolled past the hero section
      if (!isHeroVisible) return;
      const nextIndex = (currentIndex + 1) % showcaseItems.length;
      switchTab(nextIndex, false);
    }, AUTO_SCROLL_INTERVAL);
  }

  function stopAutoScroll() {
    if (autoScrollTimer) {
      clearInterval(autoScrollTimer);
      autoScrollTimer = null;
    }
    pauseProgressBar();
  }

  function restartAutoScroll() {
    stopAutoScroll();
    startAutoScroll();
  }

  tabs.forEach((tab) => {
    tab.addEventListener('click', (e) => {
      const idx = parseInt(e.currentTarget.getAttribute('data-index') || '0', 10);
      switchTab(idx, true);
    });
  });

  // Pause auto-scrolling when hovering over the showcase card, resume on leave
  if (showcaseCard) {
    showcaseCard.addEventListener('mouseenter', stopAutoScroll);
    showcaseCard.addEventListener('mouseleave', startAutoScroll);
    showcaseCard.addEventListener('touchstart', stopAutoScroll, { passive: true });
    showcaseCard.addEventListener('touchend', () => {
      setTimeout(startAutoScroll, 2000);
    }, { passive: true });
  }

  // Start auto-scroll initially
  startAutoScroll();
</script>
