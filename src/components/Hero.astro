---
export interface Props {
  headline?: string;
  subheadline?: string;
  heroImage?: string;
  primaryCtaText?: string;
  secondaryCtaText?: string;
}

const {
  headline = 'Advanced Graphite & Industrial Material Solutions',
  subheadline = 'Precision-manufactured high-density graphite crucibles, colloidal graphite suspensions, synthetic seals, and high-tensile doctor blades engineered for severe thermal and chemical operating environments.',
  heroImage = '/images/hero-industrial.jpg',
  primaryCtaText = 'Explore Product Range',
  secondaryCtaText = 'Request Custom Quote',
} = Astro.props;

// Headline split
const parts = headline.split('&');
const headlinePart1 = parts[0]?.trim() || headline;
const headlinePart2 = parts[1]?.trim() || '';

// Showcase Items for the Interactive Tab Switcher
const showcaseItems = [
  {
    id: 'crucibles',
    tabName: 'Graphite Crucibles',
    title: 'Isostatic Graphite Crucibles',
    tagline: 'Engineered for extreme thermal metallurgy up to 3000°C with Alubonding™ anti-oxidation protection.',
    image: '/images/products/graphite-crucibles.jpg',
    url: '/products/graphite-crucibles',
    badge: '3000°C Max Heat',
    badgeColor: 'text-amber-400 border-amber-500/30 bg-amber-500/10',
    stat1Val: '3000°C',
    stat1Lbl: 'Thermal Rating',
    stat2Val: '99.9%',
    stat2Lbl: 'Carbon Purity',
    stat3Val: '±0.02mm',
    stat3Lbl: 'CNC Precision',
    telemetryRating: '3000°C Peak',
    telemetryGrade: '99.9% Ultra-Pure',
  },
  {
    id: 'colloidal',
    tabName: 'Colloidal Dispersions',
    title: 'Colloidal Graphite Dispersions',
    tagline: 'Ultra-fine sub-micron graphite suspensions for die-casting, hot forging, and industrial mold release.',
    image: '/images/products/graphite-suspension.jpg',
    url: '/products/graphite-suspension',
    badge: 'Sub-Micron Grade',
    badgeColor: 'text-cyan-400 border-cyan-500/30 bg-cyan-500/10',
    stat1Val: '< 1µm',
    stat1Lbl: 'Particle Size',
    stat2Val: 'Water / Oil',
    stat2Lbl: 'Carrier Base',
    stat3Val: 'Zero Smoke',
    stat3Lbl: 'Eco Formulation',
    telemetryRating: '1200°C Working',
    telemetryGrade: 'Colloidal Grade A',
  },
  {
    id: 'seals',
    tabName: 'Graphite Seals & Foil',
    title: 'Pure Flexible Graphite Foil & Seals',
    tagline: 'High-pressure expanded natural graphite gaskets and tapes offering impenetrable fluid containment.',
    image: '/images/products/graphite-foil-tape.jpg',
    url: '/products/graphite-foil-tape',
    badge: '99.9% Carbon Foil',
    badgeColor: 'text-emerald-400 border-emerald-500/30 bg-emerald-500/10',
    stat1Val: '-200 to 650°C',
    stat1Lbl: 'Temp Range',
    stat2Val: '100%',
    stat2Lbl: 'Non-Asbestos',
    stat3Val: 'High PSI',
    stat3Lbl: 'Pressure Class',
    telemetryRating: '650°C Max Temp',
    telemetryGrade: 'Flexible Foil 99.9%',
  },
  {
    id: 'doctor-blades',
    tabName: 'Doctor Blades',
    title: 'Precision High-Tensile Doctor Blades',
    tagline: 'Micro-honed Swedish carbon and stainless steel doctor blades for streak-free rotogravure & flexo printing.',
    image: '/images/products/ss-doctor-blades.jpg',
    url: '/products/ss-doctor-blades',
    badge: 'Micro-Honed Edge',
    badgeColor: 'text-purple-400 border-purple-500/30 bg-purple-500/10',
    stat1Val: 'Swedish',
    stat1Lbl: 'Steel Grade',
    stat2Val: 'Lamella / Bevel',
    stat2Lbl: 'Edge Profiles',
    stat3Val: 'Zero Streak',
    stat3Lbl: 'Wiping Quality',
    telemetryRating: '600 HV Hardness',
    telemetryGrade: 'Swedish Carbon/SS',
  },
];
---

<section class="relative min-h-[85vh] lg:min-h-[90vh] flex items-center overflow-hidden bg-[#07090e] pt-8 pb-16 lg:pt-14 lg:pb-20 industrial-grid-bg">

  <!-- Ambient Glowing Backdrops (Lightweight GPU-optimized) -->
  <div class="absolute top-1/4 -left-32 w-[500px] h-[500px] bg-[radial-gradient(circle,rgba(255,102,54,0.12)_0%,transparent_70%)] pointer-events-none"></div>
  <div class="absolute -top-24 right-1/4 w-[500px] h-[500px] bg-[radial-gradient(circle,rgba(255,160,128,0.08)_0%,transparent_70%)] pointer-events-none"></div>

  <div class="absolute bottom-0 inset-x-0 h-24 bg-gradient-to-t from-[#07090e] via-[#07090e]/80 to-transparent pointer-events-none z-10"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-20 w-full">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-center">

      <!-- LEFT: Hero Animated Entrance Content -->
      <div class="lg:col-span-6 space-y-6">
        
        <!-- Entrance Element 1: ISO Live Badge -->
        <!-- Entrance Element 1: ISO Live Badge -->
        <div>
          <div class="inline-flex items-center gap-3 bg-white/[0.04] border border-white/10 text-slate-200 text-xs font-semibold px-4 py-2 rounded-full shadow-md">
            <span class="inline-block w-2.5 h-2.5 rounded-full bg-[var(--primary)]"></span>
            <span class="tracking-wide">ISO 9001:2015 Certified B2B Manufacturer</span>
            <span class="hidden sm:inline-block text-[10px] uppercase font-mono px-2 py-0.5 rounded bg-[var(--primary)]/20 text-[var(--primary-bright)] border border-[var(--primary)]/30 ml-1">Live Operations</span>
          </div>
        </div>

        <!-- Entrance Element 2: Main Headline with Solid High-Contrast Accent -->
        <div class="space-y-1">
          <h1 class="text-3xl sm:text-4xl lg:text-[3.25rem] font-black text-white tracking-tight leading-[1.08]" style="font-family:'Outfit',sans-serif;">
            {headlinePart1}
            {headlinePart2 && (
              <span class="block text-theme font-black mt-1.5">
                &amp; {headlinePart2}
              </span>
            )}
          </h1>
        </div>

        <!-- Entrance Element 3: Subheadline -->
        <div>
          <p class="text-slate-300 text-sm sm:text-base max-w-xl leading-relaxed font-normal">
            {subheadline}
          </p>
        </div>

        <!-- Entrance Element 4: High-Conversion CTA Buttons -->
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3.5 pt-2">
          <a
            href="/products"
            class="forge-btn-primary rounded-full px-7 py-3.5 text-sm font-bold shadow-md"
          >
            <span>{primaryCtaText}</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
            </svg>
          </a>
          <button
            type="button"
            data-open-quote-modal
            class="forge-btn-ghost rounded-full px-7 py-3.5 text-sm font-semibold hover:bg-white/[0.06]"
          >
            <svg class="w-4 h-4 text-[var(--primary-text)]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
            </svg>
            <span>{secondaryCtaText}</span>
          </button>
        </div>

        <!-- Entrance Element 5: Key Plant Competencies -->
        <div class="pt-3">
          <div class="text-[11px] font-mono uppercase tracking-wider text-slate-400 mb-2.5 flex items-center gap-2">
            <span class="w-1.5 h-1.5 rounded-full bg-[var(--primary)]"></span>
            <span>Core Manufacturing Capabilities</span>
          </div>
          <div class="flex flex-wrap items-center gap-2 text-xs text-slate-300 font-mono">
            <span class="flex items-center gap-1.5 bg-white/[0.04] border border-white/[0.09] px-3 py-1.5 rounded-lg">
              <span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span>
              Isostatic Hot Pressing
            </span>
            <span class="flex items-center gap-1.5 bg-white/[0.04] border border-white/[0.09] px-3 py-1.5 rounded-lg">
              <span class="w-1.5 h-1.5 rounded-full bg-[var(--primary-bright)]"></span>
              Sub-Micron Dispersions
            </span>
            <span class="flex items-center gap-1.5 bg-white/[0.04] border border-white/[0.09] px-3 py-1.5 rounded-lg">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
              CNC Machining ±0.02mm
            </span>
            <span class="flex items-center gap-1.5 bg-white/[0.04] border border-white/[0.09] px-3 py-1.5 rounded-lg">
              <span class="w-1.5 h-1.5 rounded-full bg-blue-400"></span>
              Global Export 20+ Countries
            </span>
          </div>
        </div>

      </div>

      <!-- RIGHT: Standard Clean Showcase Card -->
      <div class="lg:col-span-6 relative">

        <!-- Telemetry Header Bar -->
        <div class="flex flex-wrap items-center justify-between gap-2.5 mb-3 px-1">
          <div class="inline-flex items-center gap-2 bg-[#0e111a] border border-amber-500/30 px-3.5 py-1.5 rounded-xl shadow-md">
            <span class="w-2 h-2 rounded-full bg-amber-400 shrink-0"></span>
            <span class="text-[10px] uppercase font-mono text-slate-400 tracking-wider">Thermal Rating:</span>
            <span id="heroTelemetryRating" class="text-xs font-bold text-amber-300 font-mono">{showcaseItems[0].telemetryRating}</span>
          </div>
          <div class="inline-flex items-center gap-2 bg-[#0e111a] border border-emerald-500/30 px-3.5 py-1.5 rounded-xl shadow-md">
            <span class="w-2 h-2 rounded-full bg-emerald-400 shrink-0"></span>
            <span class="text-[10px] uppercase font-mono text-slate-400 tracking-wider">Carbon Grade:</span>
            <span id="heroTelemetryGrade" class="text-xs font-bold text-emerald-400 font-mono">{showcaseItems[0].telemetryGrade}</span>
          </div>
        </div>

        <!-- Main Showcase Frame -->
        <div class="relative bg-[#0d1017] border border-white/[0.14] rounded-3xl overflow-hidden shadow-2xl">
          
          <!-- Category Quick Selection Tabs -->
          <div class="px-3 sm:px-4 py-3 border-b border-white/[0.08] bg-white/[0.02] flex items-center justify-between gap-2 overflow-x-auto no-scrollbar">
            <div class="flex items-center gap-1.5 sm:gap-2 w-full">
              {showcaseItems.map((item, idx) => (
                <button
                  type="button"
                  class={`hero-tab text-xs font-mono font-medium py-1.5 px-3 rounded-xl transition-colors shrink-0 cursor-pointer ${
                    idx === 0
                      ? 'bg-[var(--primary)] text-white shadow-md font-bold'
                      : 'text-slate-400 hover:text-white hover:bg-white/[0.05]'
                  }`}
                  data-index={idx}
                >
                  {item.tabName}
                </button>
              ))}
            </div>
          </div>

          <!-- Product Image & Highlight Banner -->
          <div class="relative h-60 sm:h-72 overflow-hidden bg-black/60">
            {showcaseItems.map((item, idx) => (
              <div
                class={`hero-image-slide absolute inset-0 ${
                  idx === 0 ? 'block' : 'hidden'
                }`}
                data-slide-index={idx}
              >
                <img
                  src={item.image}
                  alt={item.title}
                  class="w-full h-full object-cover opacity-90"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-[#0d1017] via-[#0d1017]/40 to-transparent"></div>
                
                <!-- Info Tag Inside Slide -->
                <div class="absolute bottom-4 left-4 right-4 z-10 space-y-1">
                  <span class={`inline-block text-[10px] font-mono font-bold uppercase tracking-wider px-2.5 py-0.5 rounded-md border ${item.badgeColor}`}>
                    {item.badge}
                  </span>
                  <h3 class="text-lg sm:text-xl font-bold text-white tracking-tight" style="font-family:'Outfit',sans-serif;">
                    {item.title}
                  </h3>
                  <p class="text-xs text-slate-300 line-clamp-1 font-normal">
                    {item.tagline}
                  </p>
                </div>
              </div>
            ))}
          </div>

          <!-- Dynamic Specification Grid -->
          <div class="grid grid-cols-3 divide-x divide-white/[0.08] bg-white/[0.02] border-t border-b border-white/[0.08]">
            <div class="py-3 px-3 text-center">
              <div id="stat1Val" class="text-base sm:text-lg font-black text-white font-mono leading-none">{showcaseItems[0].stat1Val}</div>
              <div id="stat1Lbl" class="text-[10px] text-slate-400 font-mono uppercase tracking-wider mt-1">{showcaseItems[0].stat1Lbl}</div>
            </div>
            <div class="py-3 px-3 text-center">
              <div id="stat2Val" class="text-base sm:text-lg font-black text-theme-bright font-mono leading-none">{showcaseItems[0].stat2Val}</div>
              <div id="stat2Lbl" class="text-[10px] text-slate-400 font-mono uppercase tracking-wider mt-1">{showcaseItems[0].stat2Lbl}</div>
            </div>
            <div class="py-3 px-3 text-center">
              <div id="stat3Val" class="text-base sm:text-lg font-black text-slate-200 font-mono leading-none">{showcaseItems[0].stat3Val}</div>
              <div id="stat3Lbl" class="text-[10px] text-slate-400 font-mono uppercase tracking-wider mt-1">{showcaseItems[0].stat3Lbl}</div>
            </div>
          </div>

          <!-- Footer Action Bar -->
          <div class="px-5 py-3.5 bg-black/40 flex items-center justify-between">
            <a
              id="showcaseProductUrl"
              href={showcaseItems[0].url}
              class="text-xs font-bold text-white hover:text-[var(--primary-bright)] transition-colors flex items-center gap-1.5"
            >
              <span>View Technical Specs</span>
              <span>→</span>
            </a>
            <button
              type="button"
              id="showcaseQuoteBtn"
              data-open-quote-modal
              data-product-name={showcaseItems[0].title}
              class="text-xs font-semibold px-3.5 py-1.5 rounded-xl bg-[var(--primary)]/20 border border-[var(--primary)]/40 text-[var(--primary-bright)] hover:bg-[var(--primary)] hover:text-white transition-colors font-mono cursor-pointer shadow-sm"
            >
              Request Quote
            </button>
          </div>

        </div>

      </div>

    </div>
  </div>

</section>

<!-- Tab Switcher Script -->
<script is:inline define:vars={{ itemsData: showcaseItems }}>
  (function() {
    const tabs = document.querySelectorAll('.hero-tab');
    const slides = document.querySelectorAll('.hero-image-slide');
    const stat1Val = document.getElementById('stat1Val');
    const stat1Lbl = document.getElementById('stat1Lbl');
    const stat2Val = document.getElementById('stat2Val');
    const stat2Lbl = document.getElementById('stat2Lbl');
    const stat3Val = document.getElementById('stat3Val');
    const stat3Lbl = document.getElementById('stat3Lbl');
    const telemetryRating = document.getElementById('heroTelemetryRating');
    const telemetryGrade = document.getElementById('heroTelemetryGrade');
    const productUrl = document.getElementById('showcaseProductUrl');
    const quoteBtn = document.getElementById('showcaseQuoteBtn');

    function switchShowcase(index) {
      const item = itemsData[index];
      if (!item) return;

      tabs.forEach((tab, i) => {
        if (i === index) {
          tab.classList.add('bg-[var(--primary)]', 'text-white', 'shadow-md', 'font-bold');
          tab.classList.remove('text-slate-400', 'hover:text-white', 'hover:bg-white/[0.05]');
        } else {
          tab.classList.remove('bg-[var(--primary)]', 'text-white', 'shadow-md', 'font-bold');
          tab.classList.add('text-slate-400', 'hover:text-white', 'hover:bg-white/[0.05]');
        }
      });

      slides.forEach((sl, i) => {
        if (i === index) {
          sl.classList.remove('hidden');
          sl.classList.add('block');
        } else {
          sl.classList.add('hidden');
          sl.classList.remove('block');
        }
      });

      if (telemetryRating && item.telemetryRating) telemetryRating.textContent = item.telemetryRating;
      if (telemetryGrade && item.telemetryGrade) telemetryGrade.textContent = item.telemetryGrade;

      if (stat1Val) stat1Val.textContent = item.stat1Val;
      if (stat1Lbl) stat1Lbl.textContent = item.stat1Lbl;
      if (stat2Val) stat2Val.textContent = item.stat2Val;
      if (stat2Lbl) stat2Lbl.textContent = item.stat2Lbl;
      if (stat3Val) stat3Val.textContent = item.stat3Val;
      if (stat3Lbl) stat3Lbl.textContent = item.stat3Lbl;

      if (productUrl) productUrl.setAttribute('href', item.url);
      if (quoteBtn) quoteBtn.setAttribute('data-product-name', item.title);
    }

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        const idx = parseInt(tab.getAttribute('data-index') || '0', 10);
        switchShowcase(idx);
      });
    });
  })();
</script>

<style>
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>
