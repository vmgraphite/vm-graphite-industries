---
export interface Props {
  headline?: string;
  subheadline?: string;
  heroImage?: string;
  primaryCtaText?: string;
  secondaryCtaText?: string;
}

const {
  headline = 'Advanced Graphite & Industrial Material Solutions',
  subheadline = 'Precision-manufactured high-density graphite crucibles, colloidal graphite suspensions, synthetic seals, and high-tensile doctor blades engineered for severe thermal and chemical operating environments.',
  heroImage: propHeroImage,
  primaryCtaText = 'Explore Products',
  secondaryCtaText = 'Get a Quote',
} = Astro.props;

const heroImage = propHeroImage || '/images/hero-industrial.jpg';

// Split headline for styled treatment
const parts = headline.split('&');
const headlinePart1 = parts[0]?.trim() || headline;
const headlinePart2 = parts[1]?.trim() || '';
---

<section class="relative flex items-center overflow-hidden bg-[#0a0b0f] pt-8 pb-14 lg:pt-10 lg:pb-16">

  <!-- Background layers -->
  <!-- Radial amber glow -->
  <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[900px] h-[600px] bg-[radial-gradient(ellipse_at_top,rgba(232,160,32,0.12),transparent_65%)] pointer-events-none"></div>
  <!-- Bottom fade -->
  <div class="absolute bottom-0 inset-x-0 h-40 bg-gradient-to-t from-[#0a0b0f] to-transparent pointer-events-none"></div>
  <!-- Vertical amber rule - decorative -->
  <div class="absolute top-0 left-[62%] bottom-0 w-px bg-gradient-to-b from-transparent via-[rgba(232,160,32,0.15)] to-transparent pointer-events-none hidden lg:block"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 w-full">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">

      <!-- LEFT: Headline + CTA -->
      <div class="lg:col-span-7 space-y-8 reveal-on-scroll">
        
        <!-- Trust badge -->
        <div class="inline-flex items-center gap-2.5 px-4 py-1.5 rounded-full border border-[rgba(232,160,32,0.3)] bg-[rgba(232,160,32,0.07)] text-[#e8a020] font-mono text-[11px] font-bold uppercase tracking-widest">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[#e8a020] opacity-60"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-[#e8a020]"></span>
          </span>
          ISO 9001:2015 Certified B2B Manufacturer
        </div>

        <!-- Main headline -->
        <h1 class="font-black text-white tracking-tighter leading-[1.05]" style="font-size: clamp(2.4rem, 5vw, 4.2rem); font-family: 'Outfit', sans-serif;">
          {headlinePart1}
          {headlinePart2 && (
            <>
              <span class="block text-amber-gradient font-black">&amp; {headlinePart2}</span>
            </>
          )}
        </h1>

        <!-- Subheadline -->
        <p class="text-slate-400 text-sm max-w-md leading-relaxed font-normal">
          {subheadline}
        </p>

        <!-- CTAs -->
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 pt-2">
          <a href="/products" class="forge-btn-primary rounded-lg">
            {primaryCtaText}
            <svg class="w-4 h-4 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
          </a>
          <button type="button" data-open-quote-modal class="forge-btn-ghost rounded-lg">
            <svg class="w-4 h-4 text-[#e8a020]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
            {secondaryCtaText}
          </button>
        </div>
      </div>

      <!-- RIGHT: Compact data card -->
      <div class="lg:col-span-5 reveal-on-scroll">
        <div class="bg-[#111318] rounded-xl border border-white/8 overflow-hidden shadow-[0_8px_40px_rgba(0,0,0,0.6)]">

          <!-- HUD header -->
          <div class="flex items-center justify-between px-4 py-2.5 border-b border-white/8 bg-[#0e1016]">
            <div class="flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-[#e8a020] animate-ambient-pulse"></span>
              <span class="text-[10px] font-bold text-[#e8a020] uppercase tracking-widest font-mono">Material Specs</span>
            </div>
            <span class="text-[10px] text-slate-600 font-mono">ISO 9001:2015</span>
          </div>

          <!-- Metrics grid -->
          <div class="grid grid-cols-3 divide-x divide-white/8">
            <div class="px-4 py-5 text-center">
              <div class="text-xl font-black text-[#e8a020] font-mono leading-none">99.9%</div>
              <div class="text-[10px] font-bold text-slate-500 uppercase tracking-wider mt-1 font-mono">Purity</div>
            </div>
            <div class="px-4 py-5 text-center">
              <div class="text-xl font-black text-white font-mono leading-none">3000°C</div>
              <div class="text-[10px] font-bold text-slate-500 uppercase tracking-wider mt-1 font-mono">Max Temp</div>
            </div>
            <div class="px-4 py-5 text-center">
              <div class="text-xl font-black text-[#7dd3fc] font-mono leading-none">20+</div>
              <div class="text-[10px] font-bold text-slate-500 uppercase tracking-wider mt-1 font-mono">Countries</div>
            </div>
          </div>

          <!-- Feature list -->
          <div class="px-4 py-4 border-t border-white/8 space-y-2.5">
            {[
              'Isostatic pressed high-density graphite',
              'Custom CNC machining to ±0.02mm',
              'Colloidal suspensions for die casting',
              'Flexible graphite foil & sealing tapes',
            ].map((f) => (
              <div class="flex items-center gap-2.5 text-xs text-slate-400">
                <span class="w-1 h-1 rounded-full bg-[#e8a020] shrink-0"></span>
                {f}
              </div>
            ))}
          </div>

          <!-- Bottom link -->
          <div class="px-4 py-3 bg-[#0e1016] border-t border-white/8 flex justify-end">
            <a href="/products" class="text-[11px] font-bold text-[#e8a020] hover:text-[#f7c355] transition-colors font-mono uppercase tracking-wider">View Catalog →</a>
          </div>
        </div>
      </div>

    </div>
  </div>


</section>
