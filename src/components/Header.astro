---
import type { SiteSettings, Category } from '../lib/mockData';

export interface Props {
  siteSettings: SiteSettings;
  categories: Category[];
}

const { siteSettings, categories } = Astro.props;
const currentPath = Astro.url.pathname;

const navItems = [
  { name: 'Home', href: '/' },
  { name: 'About', href: '/about' },
  { name: 'Products', href: '/products', hasDropdown: true },
  { name: 'Downloads', href: '/downloads' },
  { name: 'Contact', href: '/contact' },
];
---

<header id="site-header" class="fixed top-0 z-50 w-full transition-all duration-300">
  <!-- Amber ticker strip -->
  <div class="hidden lg:block bg-[#e8a020] text-[#0a0b0f] text-[11px] font-bold tracking-widest uppercase overflow-hidden">
    <div class="max-w-7xl mx-auto px-8 flex justify-between items-center h-8">
      <span class="font-mono flex items-center gap-2">
        <span class="w-1.5 h-1.5 rounded-full bg-[#0a0b0f] animate-pulse inline-block"></span>
        ISO 9001:2015 Certified Manufacturer
      </span>
      <div class="flex items-center gap-6">
        <a href={`tel:${siteSettings.primaryPhone}`} class="hover:underline font-mono">{siteSettings.primaryPhone}</a>
        <span>|</span>
        <span class="font-mono">{siteSettings.workingHours}</span>
        <a
          href={`https://wa.me/${siteSettings.whatsappNumber}?text=Hello%20VM%20Graphite,%20I%20have%20a%20product%20inquiry.`}
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-1.5 hover:underline"
        >
          <svg class="w-3 h-3" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          WhatsApp
        </a>
      </div>
    </div>
  </div>

  <!-- Main navbar -->
  <div id="navbar-inner" class="glass-frosted transition-all duration-300">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between h-[68px]">
        
        <!-- Logo -->
        <a href="/" class="flex items-center gap-3 group focus:outline-none shrink-0" aria-label="VM Graphite Industries Home">
          <img src="/images/logo.svg" alt="VM Graphite Industries" class="h-11 w-auto transition-all duration-300 group-hover:brightness-110" />
        </a>

        <!-- Desktop nav -->
        <nav class="hidden md:flex items-center gap-1">
          {navItems.map((item) => {
            const isActive = currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href));
            if (item.hasDropdown) {
              return (
                <div class="relative group">
                  <a
                    href={item.href}
                    class={`px-4 py-2 text-sm font-semibold flex items-center gap-1.5 transition-all rounded-md relative ${
                      isActive ? 'text-[#e8a020]' : 'text-slate-300 hover:text-white'
                    }`}
                  >
                    {item.name}
                    <svg class="w-3.5 h-3.5 opacity-60 group-hover:rotate-180 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"/></svg>
                    {isActive && <span class="absolute bottom-0 left-4 right-4 h-px bg-[#e8a020] rounded-full"></span>}
                  </a>

                  <div class="absolute left-0 top-full pt-3 w-72 opacity-0 translate-y-2 pointer-events-none group-hover:opacity-100 group-hover:translate-y-0 group-hover:pointer-events-auto transition-all duration-250 z-50">
                    <div class="bg-[#111318] rounded-xl shadow-[0_20px_60px_rgba(0,0,0,0.9)] p-3 border border-white/8 space-y-0.5">
                      <a href="/products" class="flex items-center gap-2 px-3 py-2.5 rounded-lg text-xs font-bold text-[#e8a020] uppercase tracking-widest hover:bg-white/5 transition-colors font-mono">
                        All Products →
                      </a>
                      <div class="h-px bg-white/8 my-1"></div>
                      {categories.map((cat) => (
                        <a
                          href={`/products?category=${cat.slug}`}
                          class="block px-3 py-2.5 rounded-lg hover:bg-white/5 transition-colors group/item"
                        >
                          <div class="text-sm font-semibold text-white group-hover/item:text-[#e8a020] transition-colors">{cat.name}</div>
                          <div class="text-[11px] text-slate-400 line-clamp-1 mt-0.5">{cat.description}</div>
                        </a>
                      ))}
                    </div>
                  </div>
                </div>
              );
            }

            return (
              <a
                href={item.href}
                class={`px-4 py-2 text-sm font-semibold transition-all rounded-md relative ${
                  isActive ? 'text-[#e8a020]' : 'text-slate-300 hover:text-white'
                }`}
              >
                {item.name}
                {isActive && <span class="absolute bottom-0 left-4 right-4 h-px bg-[#e8a020] rounded-full"></span>}
              </a>
            );
          })}
        </nav>

        <!-- Desktop CTA -->
        <div class="hidden md:flex items-center gap-3">
          <button
            type="button"
            data-open-quote-modal
            class="forge-btn-primary text-xs px-5 py-2.5 rounded-md"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
            Get a Quote
          </button>
        </div>

        <!-- Mobile toggle -->
        <button
          id="mobile-menu-btn"
          type="button"
          class="flex md:hidden p-2 text-slate-300 hover:text-white transition-colors"
          aria-label="Toggle Navigation"
        >
          <svg id="menu-icon-open" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h10"/></svg>
          <svg id="menu-icon-close" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile overlay menu -->
  <div
    id="mobile-menu"
    class="hidden fixed inset-0 top-[calc(68px+32px)] bg-[#0a0b0f]/98 backdrop-blur-xl z-40 flex-col md:hidden overflow-y-auto"
  >
    <div class="p-6 space-y-1 border-b border-white/8">
      {navItems.map((item) => (
        <a
          href={item.href}
          class="flex items-center justify-between px-4 py-4 rounded-xl text-xl font-bold text-white hover:text-[#e8a020] hover:bg-white/5 transition-all"
        >
          {item.name}
          <svg class="w-5 h-5 opacity-30" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        </a>
      ))}
    </div>

    <div class="p-6 space-y-2">
      <div class="text-[10px] font-bold text-[#e8a020] uppercase tracking-widest font-mono mb-3">Product Divisions</div>
      {categories.map((cat) => (
        <a
          href={`/products?category=${cat.slug}`}
          class="block px-4 py-2.5 rounded-lg text-slate-300 hover:text-white hover:bg-white/5 transition-colors text-sm font-medium"
        >
          {cat.name}
        </a>
      ))}
    </div>

    <div class="p-6 border-t border-white/8 mt-auto">
      <button
        type="button"
        data-open-quote-modal
        class="forge-btn-primary w-full justify-center text-sm rounded-xl py-4"
      >
        Request Commercial Quote
      </button>
    </div>
  </div>
</header>

<!-- Spacer for fixed header -->
<div class="h-[68px] lg:h-[100px]"></div>

<script>
  // Mobile menu toggle
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');

  btn?.addEventListener('click', () => {
    const isOpen = !menu?.classList.contains('hidden');
    menu?.classList.toggle('hidden');
    menu?.classList.toggle('flex');
    iconOpen?.classList.toggle('hidden', !isOpen);
    iconClose?.classList.toggle('hidden', isOpen);
  });

  // Scroll-compressed header
  const header = document.getElementById('site-header');
  const navbarInner = document.getElementById('navbar-inner');
  
  const handleScroll = () => {
    if (window.scrollY > 60) {
      navbarInner?.classList.add('shadow-[0_4px_30px_rgba(0,0,0,0.9)]');
    } else {
      navbarInner?.classList.remove('shadow-[0_4px_30px_rgba(0,0,0,0.9)]');
    }
  };

  window.addEventListener('scroll', handleScroll, { passive: true });
  handleScroll();
</script>
