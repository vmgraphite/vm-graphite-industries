---
import type { SiteSettings, Category } from '../lib/mockData';

export interface Props {
  siteSettings: SiteSettings;
  categories: Category[];
}

const { siteSettings, categories } = Astro.props;
const currentPath = Astro.url.pathname;

const navItems = [
  { name: 'Home', href: '/' },
  { name: 'About Us', href: '/about' },
  { name: 'Products Catalog', href: '/products', hasDropdown: true },
  { name: 'Downloads', href: '/downloads' },
  { name: 'Contact Us', href: '/contact' },
];
---

<header class="sticky top-0 z-40 w-full bg-[#080a10] border-b border-gold-500/30 text-slate-100 transition-all shadow-[0_10px_35px_rgba(0,0,0,0.95)]">
  <!-- Top Utility Bar with PDF Tagline -->
  <div class="hidden lg:block bg-[#040508] text-slate-400 text-xs py-2 border-b border-white/10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex justify-between items-center">
      <div class="flex items-center gap-6">
        <span class="flex items-center gap-1.5 text-gold-400 font-medium tracking-wide">
          <svg class="w-3.5 h-3.5 text-gold-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
          A Complete Solution For Coating &amp; Metalizer
        </span>
        <span class="text-slate-600">|</span>
        <span class="flex items-center gap-1.5 font-mono text-slate-300">
          <svg class="w-3.5 h-3.5 text-gold-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          {siteSettings.workingHours}
        </span>
      </div>
      <div class="flex items-center gap-6">
        <a href={`tel:${siteSettings.primaryPhone}`} class="hover:text-gold-300 flex items-center gap-1.5 transition-colors font-mono">
          <svg class="w-3.5 h-3.5 text-gold-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
          {siteSettings.primaryPhone}
        </a>
        <a href={`https://wa.me/${siteSettings.whatsappNumber}?text=Hello%20VM%20Graphite,%20I%20have%20a%20product%20inquiry.`} target="_blank" rel="noopener noreferrer" class="text-emerald-400 hover:text-emerald-300 flex items-center gap-1.5 transition-colors font-mono font-medium">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
          </span>
          WhatsApp Chat
        </a>
      </div>
    </div>
  </div>

  <!-- Main Navbar -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      
      <!-- Brand Logo (Vector SVG from PDF) -->
      <a href="/" class="flex items-center gap-3 group focus:outline-none" aria-label="VM Graphite Industries LLP Home">
        <img src="/images/logo.svg" alt="VM Graphite Industries Logo" class="h-13 w-auto transition-transform duration-300 group-hover:scale-105" />
      </a>

      <!-- Desktop Navigation Links -->
      <nav class="hidden md:flex items-center space-x-1 lg:space-x-2">
        {navItems.map((item) => {
          const isActive = currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href));
          
          if (item.hasDropdown) {
            return (
              <div class="relative group">
                <a
                  href={item.href}
                  class={`px-4 py-2 rounded-xl text-sm font-semibold flex items-center gap-1.5 transition-all ${
                    isActive ? 'text-gold-400 bg-gold-500/15 border border-gold-500/30' : 'text-slate-300 hover:text-white hover:bg-white/5'
                  }`}
                >
                  <span>{item.name}</span>
                  <svg class="w-4 h-4 text-gold-400 group-hover:rotate-180 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
                </a>

                {/* Dropdown Menu */}
                <div class="absolute left-0 top-full pt-2 w-80 opacity-0 translate-y-3 pointer-events-none group-hover:opacity-100 group-hover:translate-y-0 group-hover:pointer-events-auto transition-all duration-300 z-50">
                  <div class="bg-[#0e131f] rounded-2xl shadow-[0_20px_50px_rgba(0,0,0,0.9)] p-4 space-y-1.5 border border-gold-500/30">
                    <a href="/products" class="block px-3.5 py-2.5 rounded-xl text-xs font-bold text-gold-400 uppercase tracking-wider hover:bg-white/5 transition-colors font-mono">
                      All Categories Overview &rarr;
                    </a>
                    <div class="h-px bg-white/10 my-1"></div>
                    {categories.map((cat) => (
                      <a
                        href={`/products?category=${cat.slug}`}
                        class="block px-3.5 py-2.5 rounded-xl text-sm text-slate-300 hover:text-white hover:bg-white/5 transition-colors"
                      >
                        <div class="font-semibold text-white group-hover:text-gold-400">{cat.name}</div>
                        <div class="text-[11px] text-slate-400 line-clamp-1">{cat.description}</div>
                      </a>
                    ))}
                  </div>
                </div>
              </div>
            );
          }

          return (
            <a
              href={item.href}
              class={`px-4 py-2 rounded-xl text-sm font-semibold transition-all ${
                isActive ? 'text-gold-400 bg-gold-500/15 border border-gold-500/30' : 'text-slate-300 hover:text-white hover:bg-white/5'
              }`}
            >
              {item.name}
            </a>
          );
        })}
      </nav>

      <!-- Desktop Quote CTA -->
      <div class="hidden md:flex items-center gap-3">
        <button
          type="button"
          data-open-quote-modal
          class="px-6 py-2.5 bg-gradient-to-r from-amber-400 via-gold-400 to-amber-500 hover:from-amber-300 hover:via-gold-300 hover:to-amber-400 text-slate-950 font-black text-sm rounded-xl border border-amber-200/80 shadow-[0_4px_20px_rgba(245,158,11,0.35),0_0_0_1px_rgba(251,191,36,0.3)] hover:shadow-[0_6px_25px_rgba(245,158,11,0.5)] transition-all transform hover:-translate-y-0.5 active:translate-y-0 cursor-pointer flex items-center gap-2 tracking-wide font-sans"
        >
          <svg class="w-4 h-4 text-slate-950" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
          <span>Get a Quote</span>
        </button>
      </div>

      <!-- Mobile Menu Toggle Button -->
      <div class="flex md:hidden">
        <button
          id="mobile-menu-btn"
          type="button"
          class="p-2.5 text-slate-300 hover:text-white hover:bg-white/10 rounded-xl focus:outline-none transition-colors"
          aria-label="Toggle Navigation Menu"
        >
          <svg id="menu-icon" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
          <svg id="close-icon" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Menu Drawer -->
  <div id="mobile-menu" class="hidden md:hidden bg-[#0c101a] border-b border-gold-500/30 px-4 pt-3 pb-6 space-y-4 shadow-2xl">
    <div class="space-y-1">
      {navItems.map((item) => (
        <a
          href={item.href}
          class="block px-4 py-3 rounded-xl text-base font-semibold text-slate-200 hover:text-white hover:bg-white/5 transition-colors"
        >
          {item.name}
        </a>
      ))}
    </div>

    <div class="pt-3 border-t border-white/10 space-y-2">
      <div class="text-xs font-bold text-gold-400 uppercase tracking-wider px-4 font-mono">Product Divisions</div>
      {categories.map((cat) => (
        <a
          href={`/products?category=${cat.slug}`}
          class="block px-4 py-2 text-sm text-slate-400 hover:text-white transition-colors"
        >
          • {cat.name}
        </a>
      ))}
    </div>

    <div class="pt-4 border-t border-white/10">
      <button
        type="button"
        data-open-quote-modal
        class="w-full py-3.5 bg-gradient-to-r from-amber-400 via-gold-400 to-amber-500 hover:from-amber-300 hover:to-amber-400 text-slate-950 text-center font-black rounded-xl border border-amber-200/80 shadow-[0_4px_20px_rgba(245,158,11,0.35)] cursor-pointer block text-base uppercase tracking-wider font-sans"
      >
        Request Commercial Quote
      </button>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const menuIcon = document.getElementById('menu-icon');
  const closeIcon = document.getElementById('close-icon');

  btn?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
    menuIcon?.classList.toggle('hidden');
    closeIcon?.classList.toggle('hidden');
  });
</script>
