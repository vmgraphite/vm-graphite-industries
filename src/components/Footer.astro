---
import type { SiteSettings, Category } from '../lib/mockData';

export interface Props {
  siteSettings: SiteSettings;
  categories: Category[];
}

const { siteSettings, categories } = Astro.props;
const currentYear = new Date().getFullYear();
---

<footer class="bg-[#040508] text-slate-400 border-t border-gold-500/20 pt-20 pb-12 relative overflow-hidden industrial-grid-bg">
  
  <!-- Ambient Gradient Aura -->
  <div class="absolute top-0 right-10 w-96 h-96 bg-gold-500/10 rounded-full blur-[120px] pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-10 pb-16 border-b border-white/10">
      
      <!-- Company Branding Column (2 cols wide) -->
      <div class="lg:col-span-2 space-y-5">
        <a href="/" class="inline-block group focus:outline-none">
          <img src="/images/logo.svg" alt="VM Graphite Industries Logo" class="h-13 w-auto transition-transform duration-300 group-hover:scale-105" />
        </a>
        <p class="text-sm text-slate-300 max-w-sm leading-relaxed font-normal">
          {siteSettings.tagline}. Leading manufacturer and exporter of high-density graphite crucibles, colloidal suspensions, flexible foil gaskets, and metering doctor blades for metallurgical and manufacturing processes worldwide.
        </p>

        <div class="flex items-center gap-3 pt-2">
          <a
            href={siteSettings.companyBrochureUrl || '/docs/VM_Graphite_Corporate_Brochure.pdf'}
            target="_blank"
            download
            class="inline-flex items-center gap-2 px-4 py-2.5 bg-[#0e131f] hover:bg-[#141b2d] text-gold-400 border border-gold-500/30 rounded-xl text-xs font-bold transition-all shadow-md font-mono"
          >
            <svg class="w-4 h-4 text-gold-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
            <span>Download Corporate Brochure</span>
          </a>
        </div>
      </div>

      <!-- Product Categories Column -->
      <div class="space-y-4">
        <h3 class="text-xs font-bold text-gold-400 uppercase tracking-widest font-mono">Product Divisions</h3>
        <ul class="space-y-3 text-sm">
          {categories.map((cat) => (
            <li>
              <a href={`/products?category=${cat.slug}`} class="text-slate-300 hover:text-gold-300 transition-colors">
                {cat.name}
              </a>
            </li>
          ))}
          <li class="pt-1">
            <a href="/products" class="text-gold-400 hover:text-gold-300 text-xs font-bold font-mono">
              View Complete Catalog &rarr;
            </a>
          </li>
        </ul>
      </div>

      <!-- Quick Links Column -->
      <div class="space-y-4">
        <h3 class="text-xs font-bold text-gold-400 uppercase tracking-widest font-mono">Quick Navigation</h3>
        <ul class="space-y-3 text-sm">
          <li><a href="/" class="text-slate-300 hover:text-gold-300 transition-colors">Home Page</a></li>
          <li><a href="/about" class="text-slate-300 hover:text-gold-300 transition-colors">About Company</a></li>
          <li><a href="/products" class="text-slate-300 hover:text-gold-300 transition-colors">Product Catalog</a></li>
          <li><a href="/downloads" class="text-slate-300 hover:text-gold-300 transition-colors">Resources &amp; Downloads</a></li>
          <li><a href="/contact" class="text-slate-300 hover:text-gold-300 transition-colors">Contact &amp; Plant Location</a></li>
        </ul>
      </div>

      <!-- Contact Info Column -->
      <div class="space-y-4">
        <h3 class="text-xs font-bold text-gold-400 uppercase tracking-widest font-mono">Factory &amp; Offices</h3>
        <div class="space-y-3 text-xs leading-relaxed">
          <div>
            <span class="block font-bold text-slate-200 mb-0.5">Corporate Office:</span>
            <span class="text-slate-400">{siteSettings.officeAddress}</span>
          </div>
          <div>
            <span class="block font-bold text-slate-200 mb-0.5">Manufacturing Plant:</span>
            <span class="text-slate-400">{siteSettings.plantAddress}</span>
          </div>
          <div class="pt-1 space-y-1 font-mono">
            <span class="block text-slate-400">
              <strong class="text-slate-200">Sales:</strong> <a href={`tel:${siteSettings.primaryPhone}`} class="hover:text-gold-300">{siteSettings.primaryPhone}</a>
            </span>
            <span class="block text-slate-400">
              <strong class="text-slate-200">Email:</strong> <a href={`mailto:${siteSettings.email}`} class="hover:text-gold-300">{siteSettings.email}</a>
            </span>
          </div>
        </div>
      </div>

    </div>

    <!-- Bottom Copyright & Compliance -->
    <div class="pt-8 flex flex-col sm:flex-row justify-between items-center text-xs text-slate-400 gap-4">
      <div>
        &copy; {currentYear} {siteSettings.companyName}. All rights reserved. Industrial B2B Manufacturer.
      </div>
      <div class="flex items-center gap-6 font-mono text-[11px]">
        <span class="flex items-center gap-1.5"><span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>ISO 9001:2015 Quality Assured</span>
        <span class="text-gold-400 font-semibold">A Complete Solution For Coating &amp; Metalizer</span>
      </div>
    </div>
  </div>
</footer>
