---
import type { SiteSettings, Category } from '../lib/mockData';

export interface Props {
  siteSettings: SiteSettings;
  categories: Category[];
}

const { siteSettings, categories } = Astro.props;
const currentYear = new Date().getFullYear();
---

<footer class="bg-slate-950 text-slate-400 border-t border-slate-800 pt-16 pb-12">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-10 pb-12 border-b border-slate-800/80">
      
      <!-- Company Branding Column (2 cols wide) -->
      <div class="lg:col-span-2 space-y-4">
        <a href="/" class="inline-block">
          <img src="/images/logo.svg" alt="VM Graphite Industries Logo" class="h-12 w-auto" />
        </a>
        <p class="text-sm text-slate-400 max-w-sm leading-relaxed">
          {siteSettings.tagline}. Leading manufacturer and exporter of high-density graphite crucibles, colloidal suspensions, flexible foil gaskets, and metering doctor blades for metallurgical and manufacturing processes worldwide.
        </p>

        <div class="flex items-center gap-3 pt-2">
          <a
            href={siteSettings.companyBrochureUrl || '/docs/VM_Graphite_Corporate_Brochure.pdf'}
            target="_blank"
            download
            class="inline-flex items-center gap-2 px-4 py-2 bg-slate-900 hover:bg-slate-800 text-industrial-copper border border-industrial-copper/30 rounded-lg text-xs font-bold transition-colors"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
            <span>Download Corporate Brochure</span>
          </a>
        </div>
      </div>

      <!-- Product Categories Column -->
      <div class="space-y-4">
        <h4 class="text-sm font-bold text-white uppercase tracking-wider">Product Categories</h4>
        <ul class="space-y-2.5 text-sm">
          {categories.map((cat) => (
            <li>
              <a href={`/products?category=${cat.slug}`} class="hover:text-industrial-copper transition-colors">
                {cat.name}
              </a>
            </li>
          ))}
          <li>
            <a href="/products" class="text-industrial-copper hover:underline text-xs font-semibold">
              View Complete Catalog &rarr;
            </a>
          </li>
        </ul>
      </div>

      <!-- Quick Links Column -->
      <div class="space-y-4">
        <h4 class="text-sm font-bold text-white uppercase tracking-wider">Quick Navigation</h4>
        <ul class="space-y-2.5 text-sm">
          <li><a href="/" class="hover:text-industrial-copper transition-colors">Home Page</a></li>
          <li><a href="/about" class="hover:text-industrial-copper transition-colors">About Company</a></li>
          <li><a href="/products" class="hover:text-industrial-copper transition-colors">Product Catalog</a></li>
          <li><a href="/downloads" class="hover:text-industrial-copper transition-colors">Resources & Downloads</a></li>
          <li><a href="/contact" class="hover:text-industrial-copper transition-colors">Contact & Factory Location</a></li>
          <li><a href="/admin" class="hover:text-slate-200 transition-colors text-xs text-slate-500">Sanity CMS Portal</a></li>
        </ul>
      </div>

      <!-- Contact Info Column -->
      <div class="space-y-4">
        <h4 class="text-sm font-bold text-white uppercase tracking-wider">Factory & Offices</h4>
        <div class="space-y-3 text-xs leading-relaxed">
          <div>
            <span class="block font-bold text-slate-200 mb-0.5">Corporate Office:</span>
            <span class="text-slate-400">{siteSettings.officeAddress}</span>
          </div>
          <div>
            <span class="block font-bold text-slate-200 mb-0.5">Manufacturing Plant:</span>
            <span class="text-slate-400">{siteSettings.plantAddress}</span>
          </div>
          <div class="pt-1">
            <span class="block text-slate-400">
              <strong class="text-slate-300">Sales:</strong> <a href={`tel:${siteSettings.primaryPhone}`} class="hover:text-industrial-copper">{siteSettings.primaryPhone}</a>
            </span>
            <span class="block text-slate-400">
              <strong class="text-slate-300">Email:</strong> <a href={`mailto:${siteSettings.email}`} class="hover:text-industrial-copper">{siteSettings.email}</a>
            </span>
          </div>
        </div>
      </div>

    </div>

    <!-- Bottom Copyright & Compliance -->
    <div class="pt-8 flex flex-col sm:flex-row justify-between items-center text-xs text-slate-500 gap-4">
      <div>
        &copy; {currentYear} {siteSettings.companyName}. All rights reserved. Industrial B2B Manufacturer.
      </div>
      <div class="flex items-center gap-6">
        <span>ISO 9001:2015 Quality Assured</span>
        <span>High-Temperature Materials Expert</span>
      </div>
    </div>
  </div>
</footer>
