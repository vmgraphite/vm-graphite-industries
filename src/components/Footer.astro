---
import { getSiteSettings } from '../lib/data';

const siteSettings = await getSiteSettings();

const safeTagline = siteSettings.footerTagline || 'Advanced Industrial Graphite & Sealing Material Solutions. Premier manufacturer and exporter of high-density graphite solutions for metallurgical, coating, and severe-duty manufacturing processes.';
const safeFooterDesc = siteSettings.footerBadgeText || 'A Complete Solution For Coating & Metalizer';
const safeDownloadBtn = siteSettings.footerDownloadButtonText || 'Download Brochure';
const safeCopyright = siteSettings.footerCopyrightText || '© 2006 VM Graphite Industries LLP. All rights reserved.';

// Determine Footer Locations (Dynamic unlimited array support with fallbacks)
const defaultFooterLocations = [
  {
    title: siteSettings.corporateOfficeTitle || 'Corporate Office',
    badge: 'Corporate HQ',
    address: siteSettings.officeAddress || 'Plot No. 42, Industrial Area, Phase II, New Delhi - 110020, India',
    phone: siteSettings.footerPhone || siteSettings.primaryPhone || '+91 94221 02425',
    email: siteSettings.email || 'info@vmgraphiteindustries.com',
  },
  {
    title: siteSettings.plantTitle || 'Manufacturing Plant',
    badge: 'Manufacturing Unit',
    address: siteSettings.plantAddress || 'Survey No. 108/2, GIDC Industrial Estate, Sector 3, Gujarat - 392130, India',
    phone: siteSettings.footerPhone || siteSettings.primaryPhone || '+91 94221 02425',
    email: siteSettings.email || 'info@vmgraphiteindustries.com',
  },
];

const footerLocationsList = Array.isArray(siteSettings.footerLocations) && siteSettings.footerLocations.length > 0
  ? siteSettings.footerLocations
  : defaultFooterLocations;

const numLocations = footerLocationsList.length;

// Layout classes based on number of addresses
// 1 location: left brand (7 cols) + compact right location (5 cols)
// 2 locations: left brand (5 cols) + 2-col location grid (7 cols)
// 3+ locations: left brand (4 cols) + multi-col location grid (8 cols)
const brandColSpan =
  numLocations === 1
    ? 'lg:col-span-7 space-y-6 max-w-xl'
    : numLocations === 2
    ? 'lg:col-span-5 space-y-6'
    : 'lg:col-span-4 space-y-6';

const locationsColSpan =
  numLocations === 1
    ? 'lg:col-span-5'
    : numLocations === 2
    ? 'lg:col-span-7'
    : 'lg:col-span-8';

const locationsGridClass =
  numLocations === 1
    ? ''
    : numLocations === 2
    ? 'grid grid-cols-1 md:grid-cols-2 gap-5'
    : 'grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-5';
---

<footer class="bg-[#05070a] text-slate-400 border-t border-white/[0.08] relative overflow-hidden">
  <!-- Subtle top illumination -->
  <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[800px] h-[2px] bg-gradient-to-r from-transparent via-[var(--primary)] to-transparent pointer-events-none"></div>

  <!-- Main Footer Content -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
      
      <!-- Brand & Capabilities (Left Column) -->
      <div class={brandColSpan}>
        <div class="flex items-center gap-3">
          {siteSettings.logo?.asset?.url ? (
            <img src={siteSettings.logo.asset.url} alt={siteSettings.companyName || 'VM Graphite'} class="h-10 w-auto object-contain" />
          ) : (
            <div class="w-10 h-10 rounded-xl bg-theme-tint border border-theme flex items-center justify-center font-black text-theme-bright font-mono text-base">
              VM
            </div>
          )}
          <div>
            <span class="font-extrabold text-white text-lg tracking-tight block font-['Outfit']">{siteSettings.companyName || 'VM GRAPHITE'}</span>
            <span class="text-[10px] font-mono text-slate-400 tracking-wider uppercase block">INDUSTRIES LLP</span>
          </div>
        </div>
        
        <p class="text-xs sm:text-sm text-slate-300 leading-relaxed font-normal">
          {safeTagline}
        </p>

        <p class="text-xs text-slate-400 font-mono">
          {safeFooterDesc}
        </p>
        {siteSettings.companyBrochureUrl && (
          <a
            href={siteSettings.companyBrochureUrl}
            target="_blank"
            download
            class="forge-btn-ghost rounded-full text-xs px-5 py-2.5 font-semibold inline-flex items-center gap-2"
          >
            <svg class="w-4 h-4 text-[var(--primary)]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
            <span>{safeDownloadBtn}</span>
          </a>
        )}
      </div>

      <!-- Factory & Offices (Adaptive layout based on number of addresses) -->
      <div class={locationsColSpan}>
        {numLocations === 1 ? (
          /* Single Location: Box aligned right, Title left-aligned to the box */
          <div class="max-w-sm w-full lg:ml-auto space-y-3">
            <h3 class="text-[11px] font-bold text-theme-bright uppercase tracking-[0.2em] font-mono text-left">
              {siteSettings.footerLocationHeading || 'Factory & Corporate Locations'}
            </h3>
            {footerLocationsList.map((loc: any) => {
              const isPlant = loc.badge?.toLowerCase().includes('plant') || loc.badge?.toLowerCase().includes('unit') || loc.title?.toLowerCase().includes('plant');
              const dotColor = isPlant ? 'bg-emerald-400' : 'bg-[var(--primary)]';

              return (
                <div class="bg-white/[0.03] border border-white/[0.07] rounded-2xl p-5 space-y-3 w-full hover:border-white/15 transition-colors text-left">
                  <div>
                    <div class="flex items-center justify-between gap-2 mb-1.5">
                      <div class="flex items-center gap-2">
                        <span class={`w-1.5 h-1.5 rounded-full ${dotColor}`}></span>
                        <span class="font-bold text-slate-200 text-xs uppercase tracking-wider font-mono">{loc.title}</span>
                      </div>
                      {loc.badge && (
                        <span class="text-[9px] font-mono text-theme-bright bg-white/5 border border-white/10 px-1.5 py-0.5 rounded uppercase">
                          {loc.badge}
                        </span>
                      )}
                    </div>
                    <p class="text-xs text-slate-400 leading-relaxed font-normal whitespace-pre-line">{loc.address}</p>
                  </div>

                  {(loc.phone || loc.email) && (
                    <div class="pt-2 border-t border-white/[0.06] flex flex-col gap-1.5">
                      {loc.phone && (
                        <a href={`tel:${loc.phone}`} class="text-xs text-slate-300 hover:text-white transition-colors font-mono flex items-center gap-2">
                          <svg class="w-3.5 h-3.5 text-[var(--primary)] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
                          <span>{loc.phone}</span>
                        </a>
                      )}
                      {loc.email && (
                        <a href={`mailto:${loc.email}`} class="text-xs text-slate-300 hover:text-white transition-colors font-mono flex items-center gap-2 break-all">
                          <svg class="w-3.5 h-3.5 text-emerald-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                          <span>{loc.email}</span>
                        </a>
                      )}
                    </div>
                  )}
                </div>
              );
            })}
          </div>
        ) : (
          /* Multiple Locations: Responsive 2-col or 3-col Grid */
          <div class="space-y-4">
            <h3 class="text-[11px] font-bold text-theme-bright uppercase tracking-[0.2em] font-mono">{siteSettings.footerLocationHeading || 'Factory & Corporate Locations'}</h3>
            <div class={locationsGridClass}>
              {footerLocationsList.map((loc: any) => {
                const isPlant = loc.badge?.toLowerCase().includes('plant') || loc.badge?.toLowerCase().includes('unit') || loc.title?.toLowerCase().includes('plant');
                const dotColor = isPlant ? 'bg-emerald-400' : 'bg-[var(--primary)]';

                return (
                  <div class="bg-white/[0.03] border border-white/[0.07] rounded-2xl p-5 space-y-3 flex flex-col justify-between hover:border-white/15 transition-colors">
                    <div>
                      <div class="flex items-center justify-between gap-2 mb-1.5">
                        <div class="flex items-center gap-2">
                          <span class={`w-1.5 h-1.5 rounded-full ${dotColor}`}></span>
                          <span class="font-bold text-slate-200 text-xs uppercase tracking-wider font-mono">{loc.title}</span>
                        </div>
                        {loc.badge && (
                          <span class="text-[9px] font-mono text-theme-bright bg-white/5 border border-white/10 px-1.5 py-0.5 rounded uppercase">
                            {loc.badge}
                          </span>
                        )}
                      </div>
                      <p class="text-xs text-slate-400 leading-relaxed font-normal whitespace-pre-line">{loc.address}</p>
                    </div>

                    {(loc.phone || loc.email) && (
                      <div class="pt-2 border-t border-white/[0.06] flex flex-col gap-1.5">
                        {loc.phone && (
                          <a href={`tel:${loc.phone}`} class="text-xs text-slate-300 hover:text-white transition-colors font-mono flex items-center gap-2">
                            <svg class="w-3.5 h-3.5 text-[var(--primary)] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
                            <span>{loc.phone}</span>
                          </a>
                        )}
                        {loc.email && (
                          <a href={`mailto:${loc.email}`} class="text-xs text-slate-300 hover:text-white transition-colors font-mono flex items-center gap-2 break-all">
                            <svg class="w-3.5 h-3.5 text-emerald-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                            <span>{loc.email}</span>
                          </a>
                        )}
                      </div>
                    )}
                  </div>
                );
              })}
            </div>
          </div>
        )}
      </div>

    </div>

    <!-- Bottom Bar -->
    <div class="mt-12 pt-8 border-t border-white/[0.06] flex flex-col sm:flex-row items-center justify-between gap-4 text-xs">
      <p class="text-slate-400 font-mono text-[11px]">
        {safeCopyright}
      </p>

      <div class="flex items-center gap-6 text-slate-400 text-xs">
        <a href="/products" class="hover:text-white transition-colors">Products</a>
        <a href="/about" class="hover:text-white transition-colors">About Us</a>
        <a href="/downloads" class="hover:text-white transition-colors">Downloads</a>
        <a href="/contact" class="hover:text-white transition-colors">Contact</a>
        <a href="/admin" class="text-slate-500 hover:text-slate-300 transition-colors font-mono text-[11px]">Admin</a>
      </div>
    </div>
  </div>
</footer>
