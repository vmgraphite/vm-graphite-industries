---
import type { SiteSettings, Category } from '../lib/mockData';

export interface Props {
  siteSettings: SiteSettings;
  categories: Category[];
}

const { siteSettings, categories } = Astro.props;
const currentYear = new Date().getFullYear();

const marqueItems = [
  'ISO 9001:2015 Certified',
  '20+ Countries Served',
  'Zero Defect Policy',
  '100% Batch Inspection',
  'Custom Dimensions Available',
  'Export-Standard Packaging',
  'Isostatic Pressed Graphite',
  '99.9% Carbon Purity',
];
---

<footer class="bg-[#080a0e] text-slate-400 border-t border-[rgba(232,160,32,0.25)] relative overflow-hidden">

  <!-- Top amber thick rule -->
  <div class="h-1 w-full bg-gradient-to-r from-transparent via-[#e8a020] to-transparent"></div>

  <!-- Subtle ambient -->
  <div class="absolute top-0 right-0 w-[500px] h-[400px] bg-[radial-gradient(circle,rgba(232,160,32,0.06),transparent_70%)] pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">

    <!-- Main footer grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10 py-16 border-b border-white/8">

      <!-- Company column -->
      <div class="lg:col-span-1 space-y-5">
        <a href="/" class="inline-block group focus:outline-none">
          <img src="/images/logo.svg" alt="VM Graphite Industries Logo" class="h-12 w-auto transition-all duration-300 group-hover:brightness-110" />
        </a>
        <p class="text-sm text-slate-400 leading-relaxed">
          {siteSettings.tagline}. Premier manufacturer and exporter of high-density graphite solutions for metallurgical and manufacturing processes worldwide.
        </p>
        <a
          href={siteSettings.companyBrochureUrl || '/docs/VM_Graphite_Corporate_Brochure.pdf'}
          target="_blank"
          download
          class="inline-flex items-center gap-2 px-4 py-2.5 bg-[#111318] hover:bg-[rgba(232,160,32,0.08)] text-[#e8a020] border border-[rgba(232,160,32,0.2)] hover:border-[rgba(232,160,32,0.4)] rounded-lg text-xs font-bold transition-all font-mono uppercase tracking-wider"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
          Download Brochure
        </a>
      </div>

      <!-- Product divisions -->
      <div class="space-y-5">
        <h3 class="text-[10px] font-bold text-[#e8a020] uppercase tracking-[0.2em] font-mono">Product Divisions</h3>
        <ul class="space-y-3">
          {categories.map((cat) => (
            <li>
              <a href={`/products?category=${cat.slug}`} class="text-sm text-slate-400 hover:text-[#e8a020] transition-colors flex items-center gap-2 group">
                <span class="w-1 h-1 rounded-full bg-white/20 group-hover:bg-[#e8a020] transition-colors"></span>
                {cat.name}
              </a>
            </li>
          ))}
          <li class="pt-1">
            <a href="/products" class="text-xs font-bold text-[#e8a020] hover:text-[#f7c355] transition-colors font-mono uppercase tracking-wider">
              View Complete Catalog →
            </a>
          </li>
        </ul>
      </div>

      <!-- Quick navigation -->
      <div class="space-y-5">
        <h3 class="text-[10px] font-bold text-[#e8a020] uppercase tracking-[0.2em] font-mono">Quick Navigation</h3>
        <ul class="space-y-3 text-sm">
          {[
            { name: 'Home Page', href: '/' },
            { name: 'About Company', href: '/about' },
            { name: 'Product Catalog', href: '/products' },
            { name: 'Resources & Downloads', href: '/downloads' },
            { name: 'Contact & Plant Location', href: '/contact' },
          ].map((link) => (
            <li>
              <a href={link.href} class="text-slate-400 hover:text-[#e8a020] transition-colors flex items-center gap-2 group">
                <span class="w-1 h-1 rounded-full bg-white/20 group-hover:bg-[#e8a020] transition-colors"></span>
                {link.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Contact info -->
      <div class="space-y-5">
        <h3 class="text-[10px] font-bold text-[#e8a020] uppercase tracking-[0.2em] font-mono">Factory & Offices</h3>
        <div class="space-y-4 text-xs">
          <div>
            <span class="block font-bold text-slate-200 mb-1 text-[11px] uppercase tracking-wider font-mono">Corporate Office</span>
            <span class="text-slate-400 leading-relaxed">{siteSettings.officeAddress}</span>
          </div>
          <div>
            <span class="block font-bold text-slate-200 mb-1 text-[11px] uppercase tracking-wider font-mono">Manufacturing Plant</span>
            <span class="text-slate-400 leading-relaxed">{siteSettings.plantAddress}</span>
          </div>
          <div class="space-y-2 pt-1 font-mono">
            <div class="flex items-center gap-2">
              <svg class="w-3.5 h-3.5 text-[#e8a020] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
              <a href={`tel:${siteSettings.primaryPhone}`} class="hover:text-[#e8a020] transition-colors">{siteSettings.primaryPhone}</a>
            </div>
            <div class="flex items-center gap-2">
              <svg class="w-3.5 h-3.5 text-[#e8a020] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
              <a href={`mailto:${siteSettings.email}`} class="hover:text-[#e8a020] transition-colors break-all">{siteSettings.email}</a>
            </div>
          </div>
        </div>
      </div>

    </div>

    <!-- Copyright bar -->
    <div class="py-6 flex flex-col sm:flex-row justify-between items-center text-xs text-slate-500 gap-4">
      <div class="font-mono">
        &copy; {currentYear} {siteSettings.companyName}. All rights reserved.
      </div>
      <div class="flex items-center gap-1.5 font-mono text-[11px]">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
        <span>A Complete Solution For Coating &amp; Metalizer</span>
      </div>
    </div>

  </div>

  <!-- Scrolling marquee ticker at very bottom -->
  <div class="border-t border-white/5 bg-[#060709] py-3 overflow-hidden">
    <div class="flex">
      <div class="animate-marquee flex items-center gap-8 text-[10px] font-bold text-slate-600 uppercase tracking-[0.2em] font-mono">
        {[...marqueItems, ...marqueItems].map((item) => (
          <span class="flex items-center gap-4 shrink-0">
            <span class="w-1 h-1 rounded-full bg-[#e8a020] opacity-60"></span>
            {item}
          </span>
        ))}
      </div>
    </div>
  </div>

</footer>
