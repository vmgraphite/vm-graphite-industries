---
import type { ResourceItem } from '../lib/mockData';

export interface Props {
  resource: ResourceItem;
}

const { resource } = Astro.props;

const categoryBadges: Record<string, { label: string; bg: string }> = {
  brochure: { label: 'Company Brochure', bg: 'bg-amber-500/15 text-[#f7c355] border-amber-500/30' },
  catalog: { label: 'Product Catalog', bg: 'bg-sky-500/15 text-sky-400 border-sky-500/30' },
  datasheet: { label: 'Technical Datasheet', bg: 'bg-emerald-500/15 text-emerald-400 border-emerald-500/30' },
  certification: { label: 'Quality Certificate', bg: 'bg-purple-500/15 text-purple-400 border-purple-500/30' },
};

const badge = categoryBadges[resource.category] || { label: 'PDF Document', bg: 'bg-slate-800 text-slate-300 border-slate-700' };
---

<div class="glow-card rounded-2xl p-6 sm:p-7 shadow-xl flex flex-col justify-between h-full group bg-[#0d1017] reveal-on-scroll">
  <div class="space-y-4">
    <div class="flex items-center justify-between gap-3">
      <span class={`px-3 py-1 rounded-md text-[10px] font-bold border font-mono uppercase tracking-wider ${badge.bg}`}>
        {badge.label}
      </span>
      <span class="text-[11px] font-mono text-slate-400">PDF</span>
    </div>

    <h3 class="text-lg sm:text-xl font-bold text-white group-hover:text-[#f7c355] transition-colors leading-snug" style="font-family:'Outfit',sans-serif;">
      {resource.title}
    </h3>

    <p class="text-xs sm:text-sm text-slate-400 leading-relaxed font-normal">
      {resource.description}
    </p>
  </div>

  <div class="pt-6 border-t border-white/10 mt-6">
    <a
      href={resource.fileUrl}
      target="_blank"
      download
      class="forge-btn-primary w-full justify-center rounded-xl py-3 text-xs"
    >
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
      <span>Download PDF</span>
    </a>
  </div>
</div>
