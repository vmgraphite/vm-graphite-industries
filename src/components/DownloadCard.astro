---
import type { ResourceItem } from '../lib/mockData';

export interface Props {
  resource: ResourceItem;
}

const { resource } = Astro.props;

const categoryBadges: Record<string, { label: string; bg: string }> = {
  brochure: { label: 'Company Brochure', bg: 'bg-amber-100 text-amber-900 border-amber-300' },
  catalog: { label: 'Product Catalog', bg: 'bg-sky-100 text-sky-900 border-sky-300' },
  datasheet: { label: 'Technical Datasheet', bg: 'bg-emerald-100 text-emerald-900 border-emerald-300' },
  certification: { label: 'Quality Certificate', bg: 'bg-purple-100 text-purple-900 border-purple-300' },
};

const badge = categoryBadges[resource.category] || { label: 'PDF Document', bg: 'bg-slate-100 text-slate-800 border-slate-300' };
---

<div class="bg-white rounded-2xl p-6 border border-slate-200 shadow-industrial hover:border-industrial-copper/60 transition-all duration-300 flex flex-col justify-between h-full group">
  <div class="space-y-4">
    <div class="flex items-center justify-between gap-3">
      <span class={`px-3 py-1 rounded-full text-xs font-bold border ${badge.bg}`}>
        {badge.label}
      </span>
      <span class="text-xs font-mono font-bold text-slate-400">PDF Document</span>
    </div>

    <h3 class="text-xl font-bold text-slate-900 group-hover:text-industrial-copper transition-colors">
      {resource.title}
    </h3>

    <p class="text-xs text-slate-600 leading-relaxed">
      {resource.description}
    </p>
  </div>

  <div class="pt-6 border-t border-slate-100 mt-6">
    <a
      href={resource.fileUrl}
      target="_blank"
      download
      class="w-full py-3 px-4 bg-slate-900 hover:bg-industrial-copper text-white text-xs font-bold rounded-xl shadow-sm transition-colors flex items-center justify-center gap-2"
    >
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
      <span>Download Technical PDF</span>
    </a>
  </div>
</div>
