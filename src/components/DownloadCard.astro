---
import type { ResourceItem } from '../lib/mockData';

export interface Props {
  resource: ResourceItem;
}

const { resource } = Astro.props;

const categoryBadges: Record<string, { label: string; bg: string }> = {
  brochure: { label: 'Company Brochure', bg: 'bg-gold-500/20 text-gold-400 border-gold-500/40' },
  catalog: { label: 'Product Catalog', bg: 'bg-sky-500/20 text-sky-400 border-sky-500/40' },
  datasheet: { label: 'Technical Datasheet', bg: 'bg-emerald-500/20 text-emerald-400 border-emerald-500/40' },
  certification: { label: 'Quality Certificate', bg: 'bg-purple-500/20 text-purple-400 border-purple-500/40' },
};

const badge = categoryBadges[resource.category] || { label: 'PDF Document', bg: 'bg-slate-800 text-slate-300 border-slate-700' };
---

<div class="glass-card-dark rounded-2xl p-6 border border-gold-500/20 hover:border-gold-400 shadow-2xl transition-all duration-300 flex flex-col justify-between h-full group">
  <div class="space-y-4">
    <div class="flex items-center justify-between gap-3">
      <span class={`px-3 py-1 rounded-full text-xs font-bold border font-mono ${badge.bg}`}>
        {badge.label}
      </span>
      <span class="text-xs font-mono font-bold text-slate-400">PDF Document</span>
    </div>

    <h3 class="text-xl font-bold text-white group-hover:text-gold-400 transition-colors">
      {resource.title}
    </h3>

    <p class="text-xs text-slate-300 leading-relaxed font-normal">
      {resource.description}
    </p>
  </div>

  <div class="pt-6 border-t border-white/10 mt-6">
    <a
      href={resource.fileUrl}
      target="_blank"
      download
      class="w-full py-3 px-4 bg-gradient-to-r from-amber-400 via-gold-400 to-amber-500 hover:from-amber-300 hover:to-amber-400 text-slate-950 text-xs font-black rounded-xl border border-amber-200/80 shadow-[0_4px_15px_rgba(245,158,11,0.3)] transition-all flex items-center justify-center gap-2 uppercase tracking-wider font-sans"
    >
      <svg class="w-4 h-4 text-slate-950" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
      <span>Download Technical PDF</span>
    </a>
  </div>
</div>
