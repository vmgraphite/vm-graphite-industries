---
export interface ProductShowcaseItem {
  name: string;
  slug: string;
  image: string;
  category: string;
  badge?: string;
  spec?: string;
}

const showcaseProducts: ProductShowcaseItem[] = [
  { name: 'Colloidal Graphite Suspension', slug: 'graphite-suspension', image: '/images/products/graphite-suspension.jpg', category: 'Liquid Formulations', badge: 'Flagship Formulation', spec: '99.9% Purity • High Dispersibility' },
  { name: 'High-Density Graphite Crucibles', slug: 'graphite-crucibles', image: '/images/products/graphite-crucibles.jpg', category: 'Foundry & Metallurgy', badge: 'High Thermal', spec: 'Up to 3000°C Max Temp' },
  { name: 'Flexible Graphite Foil Tape & Sheet', slug: 'graphite-foil-tape', image: '/images/products/graphite-foil-tape.jpg', category: 'Thermal Gasketing', badge: 'Alubonding Tech', spec: 'Custom Slit Widths' },
  { name: 'Carbon Steel Doctor Blades', slug: 'carbon-steel-doctor-blades', image: '/images/products/carbon-steel-doctor-blades.jpg', category: 'Flexo & Gravure', badge: 'Precision Ground', spec: 'Lamella / Bevel Edges' },
  { name: 'Graphite Gland Rope & Packing', slug: 'graphite-gland-rope', image: '/images/products/graphite-gland-rope.jpg', category: 'High-Temp Sealing', badge: 'Severe Duty', spec: 'Inconel Wire Reinforced' },
  { name: 'Graphite Machined Sleeves & Bushings', slug: 'graphite-sleeves', image: '/images/products/graphite-sleeves.jpg', category: 'Precision CNC', badge: 'CNC Machined', spec: '±0.02mm Tolerance' },
];

const [heroProduct, ...gridProducts] = showcaseProducts;
---

<section class="py-24 relative overflow-hidden bg-[#07090e] border-t border-white/8 dot-matrix-bg">

  <!-- Ambient Glow -->
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,var(--primary-glow-subtle),transparent_70%)] pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">

    <!-- Section header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-14 gap-6">
      <div class="max-w-2xl space-y-3">
        <span class="theme-pill">Product Portfolio</span>
        <h2 class="display-lg text-white font-black tracking-tight" style="font-family:'Outfit',sans-serif;">
          What We <span class="text-theme-gradient">Manufacture &amp; Supply</span>
        </h2>
        <p class="text-slate-400 text-sm sm:text-base leading-relaxed">
          Engineered for ultra-high temperature endurance, chemical inertness, and tight mechanical tolerances. Every product is 100% batch inspected.
        </p>
      </div>
      <a href="/products" class="forge-btn-ghost rounded-xl text-xs px-5 py-3 shrink-0 self-start md:self-auto">
        <span>Browse All Products</span>
        <span class="text-theme-bright">→</span>
      </a>
    </div>

    <!-- Bento Grid Showcase -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

      <!-- Hero Bento Card (Large - Spans 2 cols on LG) -->
      <div class="lg:col-span-2 glow-card rounded-2xl overflow-hidden group border border-white/10 flex flex-col justify-between min-h-[440px] relative bg-[#0d1117]">
        <div class="absolute inset-0 overflow-hidden">
          <img
            src={heroProduct.image}
            alt={heroProduct.name}
            class="w-full h-full object-cover opacity-60 group-hover:opacity-75 transition-opacity"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-[#07090e] via-[#07090e]/60 to-transparent"></div>
        </div>

        <!-- Top Badges -->
        <div class="relative z-10 p-6 flex justify-between items-start">
          <div class="space-y-1">
            <span class="text-[10px] font-bold text-theme-bright bg-theme-tint border border-theme px-3 py-1 rounded-md font-mono uppercase tracking-widest backdrop-blur-md">
              {heroProduct.category}
            </span>
            <div class="text-[11px] text-emerald-400 font-mono flex items-center gap-1.5 pt-1">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
              {heroProduct.badge}
            </div>
          </div>

          <button
            type="button"
            data-open-quote-modal
            data-product-name={heroProduct.name}
            data-product-category={heroProduct.category}
            class="forge-btn-primary text-xs px-4 py-2 rounded-lg cursor-pointer shadow-lg"
          >
            <span>Quote</span>
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
          </button>
        </div>

        <!-- Bottom Content -->
        <div class="relative z-10 p-6 sm:p-8 space-y-3">
          <h3 class="text-2xl sm:text-3xl font-black text-white leading-tight group-hover:text-theme-bright transition-colors" style="font-family:'Outfit',sans-serif;">
            <a href={`/products/${heroProduct.slug}`}>{heroProduct.name}</a>
          </h3>
          <p class="text-slate-300 text-sm max-w-xl leading-relaxed">
            High-purity liquid graphite formulations engineered for forging dies, aluminum extrusion, and heavy metallurgical lubrication with superior heat dispersion.
          </p>
          <div class="pt-2 flex items-center justify-between">
            <span class="text-xs font-mono text-slate-400 bg-white/5 border border-white/10 px-3 py-1 rounded-md">
              {heroProduct.spec}
            </span>
            <a href={`/products/${heroProduct.slug}`} class="text-xs font-bold text-theme-bright font-mono uppercase tracking-wider flex items-center gap-1 hover:underline">
              <span>Specifications</span>
              <span>→</span>
            </a>
          </div>
        </div>
      </div>

      <!-- Secondary Bento Card 1 -->
      <div class="glow-card rounded-2xl overflow-hidden group border border-white/10 flex flex-col justify-between min-h-[440px] relative bg-[#0d1117]">
        <div class="absolute inset-0 overflow-hidden">
          <img
            src={gridProducts[0].image}
            alt={gridProducts[0].name}
            class="w-full h-full object-cover opacity-60 group-hover:opacity-75 transition-opacity"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-[#07090e] via-[#07090e]/60 to-transparent"></div>
        </div>

        <div class="relative z-10 p-6 flex justify-between items-start">
          <span class="text-[10px] font-bold text-theme-bright bg-theme-tint border border-theme px-3 py-1 rounded-md font-mono uppercase tracking-widest backdrop-blur-md">
            {gridProducts[0].category}
          </span>
          <button
            type="button"
            data-open-quote-modal
            data-product-name={gridProducts[0].name}
            data-product-category={gridProducts[0].category}
            class="p-2 rounded-lg bg-[var(--primary)] text-slate-950 hover:bg-[var(--primary-hover)] transition-colors cursor-pointer"
            aria-label="Request Quote"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
          </button>
        </div>

        <div class="relative z-10 p-6 space-y-2">
          <div class="text-[11px] text-theme-bright font-mono">{gridProducts[0].badge}</div>
          <h3 class="text-xl font-black text-white leading-snug group-hover:text-theme-bright transition-colors" style="font-family:'Outfit',sans-serif;">
            <a href={`/products/${gridProducts[0].slug}`}>{gridProducts[0].name}</a>
          </h3>
          <p class="text-xs text-slate-400 font-mono pt-1">{gridProducts[0].spec}</p>
          <div class="pt-3">
            <a href={`/products/${gridProducts[0].slug}`} class="text-xs font-bold text-theme-bright font-mono uppercase tracking-wider flex items-center gap-1 hover:underline">
              <span>View Details</span>
              <span>→</span>
            </a>
          </div>
        </div>
      </div>

    </div>

    <!-- Remaining Grid Products -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mt-6">
      {gridProducts.slice(1).map((item) => (
        <div class="glow-card rounded-2xl overflow-hidden group border border-white/10 flex flex-col justify-between min-h-[300px] relative bg-[#0d1117]">
          <!-- Background Image with Gradient -->
          <div class="absolute inset-0 overflow-hidden">
            <img
              src={item.image}
              alt={item.name}
              class="w-full h-full object-cover opacity-50 group-hover:opacity-70 transition-opacity"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-[#07090e] via-[#07090e]/75 to-transparent"></div>
          </div>

          <!-- Top Category Tag -->
          <div class="relative z-10 p-4 flex justify-between items-start">
            <span class="text-[9px] font-bold text-theme-bright bg-[#07090e]/80 border border-theme px-2.5 py-0.5 rounded font-mono uppercase tracking-wider">
              {item.category}
            </span>
          </div>

          <!-- Bottom Card Info -->
          <div class="relative z-10 p-5 space-y-2">
            <span class="text-[10px] text-theme-bright font-mono block">{item.badge}</span>
            <h3 class="text-base font-bold text-white leading-snug group-hover:text-theme-bright transition-colors" style="font-family:'Outfit',sans-serif;">
              <a href={`/products/${item.slug}`}>{item.name}</a>
            </h3>
            <p class="text-[11px] text-slate-400 font-mono line-clamp-1">{item.spec}</p>

            <div class="pt-2 flex items-center justify-between border-t border-white/10">
              <a href={`/products/${item.slug}`} class="text-[11px] font-bold text-theme-bright font-mono uppercase tracking-wider flex items-center gap-1">
                <span>Specs</span>
                <span>→</span>
              </a>
              <button
                type="button"
                data-open-quote-modal
                data-product-name={item.name}
                data-product-category={item.category}
                class="text-[10px] font-mono font-bold text-slate-300 hover:text-white bg-white/5 hover:bg-white/10 border border-white/10 px-2.5 py-1 rounded cursor-pointer transition-colors"
              >
                Quote
              </button>
            </div>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
