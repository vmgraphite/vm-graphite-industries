---
export interface ProductShowcaseItem {
  name: string;
  slug: string;
  image: string;
  category: string;
}

const showcaseProducts: ProductShowcaseItem[] = [
  { name: 'Colloidal Graphite Suspension', slug: 'graphite-suspension', image: '/images/products/graphite-suspension.jpg', category: 'Liquid Formulations' },
  { name: 'Graphite Gland Rope & Packing', slug: 'graphite-gland-rope', image: '/images/products/graphite-gland-rope.jpg', category: 'High-Temp Sealing' },
  { name: 'High-Density Graphite Crucibles', slug: 'graphite-crucibles', image: '/images/products/graphite-crucibles.jpg', category: 'Foundry & Metallurgy' },
  { name: 'Carbon Steel Doctor Blades', slug: 'carbon-steel-doctor-blades', image: '/images/products/carbon-steel-doctor-blades.jpg', category: 'Flexo & Gravure Printing' },
  { name: 'Polymer Doctor Blades', slug: 'polymer-doctor-blades', image: '/images/products/polymer-doctor-blades.jpg', category: 'Flexo & Gravure Printing' },
  { name: 'Graphite Foil Tape & Sheet', slug: 'graphite-foil-tape', image: '/images/products/graphite-foil-tape.jpg', category: 'Thermal Gasketing' },
  { name: 'High-Temp End Seals', slug: 'end-seals', image: '/images/products/end-seals.jpg', category: 'Chamber Sealing' },
  { name: 'Graphite Machined Sleeves & Bushings', slug: 'graphite-sleeves', image: '/images/products/graphite-sleeves.jpg', category: 'Precision CNC Machining' },
];

// First product is the hero bento item
const [heroProduct, ...gridProducts] = showcaseProducts;
---

<section class="py-24 lg:py-32 relative overflow-hidden dot-matrix-bg border-t border-white/5">

  <!-- Ambient glow -->
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,rgba(232,160,32,0.06),transparent_65%)] pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">

    <!-- Section header -->
    <div class="max-w-3xl space-y-4 mb-16 reveal-on-scroll">
      <span class="amber-pill">Product Portfolio</span>
      <h2 class="display-lg text-white font-black tracking-tighter" style="font-family:'Outfit',sans-serif;">
        What We <span class="text-amber-gradient">Have</span>
      </h2>
      <p class="text-slate-400 text-base sm:text-lg leading-relaxed">
        We pride ourselves on our exceptional production capacity and commitment to timely delivery, ensuring that your orders are fulfilled on schedule with the highest standards of quality.
      </p>
    </div>

    <!-- Bento Grid -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 lg:gap-5">

      <!-- Hero bento cell — spans 2 cols and 2 rows -->
      <div class="col-span-2 row-span-2 group relative bg-[#111318] rounded-2xl overflow-hidden border border-white/8 hover:border-[rgba(232,160,32,0.3)] transition-all duration-500 shadow-[0_12px_40px_rgba(0,0,0,0.6)] reveal-on-scroll" style="min-height: 420px;">
        <a href={`/products/${heroProduct.slug}`} class="block h-full">
          <div class="absolute inset-0 overflow-hidden">
            <img
              src={heroProduct.image}
              alt={heroProduct.name}
              class="w-full h-full object-cover opacity-75 group-hover:opacity-90 group-hover:scale-105 transition-all duration-700"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-[#0a0b0f] via-[rgba(10,11,15,0.4)] to-transparent"></div>
          </div>

          <!-- Content overlay at bottom -->
          <div class="absolute bottom-0 left-0 right-0 p-6 space-y-3">
            <span class="text-[10px] font-bold text-[#e8a020] bg-[rgba(232,160,32,0.12)] border border-[rgba(232,160,32,0.25)] px-3 py-1 rounded font-mono uppercase tracking-widest">
              {heroProduct.category}
            </span>
            <h3 class="text-2xl font-black text-white leading-tight tracking-tight" style="font-family:'Outfit',sans-serif;">
              {heroProduct.name}
            </h3>
            <div class="flex items-center gap-2 text-sm font-bold text-[#e8a020] font-mono uppercase tracking-wider opacity-0 group-hover:opacity-100 transition-all duration-300 translate-y-2 group-hover:translate-y-0">
              Explore Specs
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
            </div>
          </div>

          <!-- Quote button -->
          <button
            type="button"
            data-open-quote-modal
            data-product-name={heroProduct.name}
            data-product-category={heroProduct.category}
            class="absolute top-4 right-4 bg-[#0a0b0f]/80 backdrop-blur-md border border-[rgba(232,160,32,0.3)] text-[#e8a020] text-[11px] font-bold font-mono px-3 py-1.5 rounded-md hover:bg-[#e8a020] hover:text-[#0a0b0f] transition-all cursor-pointer uppercase tracking-wider"
            onclick="event.preventDefault(); event.stopPropagation();"
          >
            Quote →
          </button>
        </a>
      </div>

      <!-- Remaining grid cells -->
      {gridProducts.map((item) => (
        <div class="group relative bg-[#111318] rounded-2xl overflow-hidden border border-white/8 hover:border-[rgba(232,160,32,0.3)] transition-all duration-400 shadow-[0_4px_20px_rgba(0,0,0,0.4)] reveal-on-scroll" style="min-height: 195px;">
          <a href={`/products/${item.slug}`} class="block h-full">
            <!-- Image background -->
            <div class="absolute inset-0 overflow-hidden">
              <img
                src={item.image}
                alt={item.name}
                class="w-full h-full object-cover opacity-50 group-hover:opacity-70 group-hover:scale-105 transition-all duration-500"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-[#0a0b0f] via-[rgba(10,11,15,0.6)] to-transparent"></div>
            </div>

            <!-- Content -->
            <div class="absolute bottom-0 left-0 right-0 p-4 space-y-1.5">
              <span class="text-[9px] font-bold text-[#e8a020] font-mono uppercase tracking-widest">
                {item.category}
              </span>
              <h3 class="text-sm font-bold text-white leading-snug group-hover:text-[#f7c355] transition-colors">
                {item.name}
              </h3>
            </div>

            <!-- Quote mini button -->
            <button
              type="button"
              data-open-quote-modal
              data-product-name={item.name}
              data-product-category={item.category}
              class="absolute top-3 right-3 bg-[rgba(232,160,32,0.12)] border border-[rgba(232,160,32,0.25)] text-[#e8a020] text-[10px] font-bold font-mono px-2.5 py-1 rounded hover:bg-[#e8a020] hover:text-[#0a0b0f] transition-all cursor-pointer opacity-0 group-hover:opacity-100"
              onclick="event.preventDefault(); event.stopPropagation();"
            >
              Quote
            </button>
          </a>
        </div>
      ))}

    </div>

    <!-- Bottom statement -->
    <div class="mt-12 flex flex-col sm:flex-row items-center justify-between gap-6 pt-8 border-t border-white/8 reveal-on-scroll">
      <p class="text-lg font-bold text-slate-200 max-w-xl leading-snug" style="font-family:'Outfit',sans-serif;">
        Delivering Premium <span class="text-amber-gradient font-black">Graphite Solutions</span> with Unmatched Quality and Speed.
      </p>
      <a href="/products" class="forge-btn-ghost rounded-lg shrink-0">
        View Full Catalog
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
      </a>
    </div>

  </div>
</section>
