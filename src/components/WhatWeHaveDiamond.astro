---
export interface Props {
  badge?: string;
  title?: string;
  description?: string;
  buttonText?: string;
  cardLinkText?: string;
  products?: Array<{
    name: string;
    slug: string;
    categoryName?: string;
    shortDescription?: string;
    mainImage?: string;
    specifications?: Array<{ name: string; value: string }>;
  }>;
}

const {
  badge,
  title,
  description,
  buttonText,
  cardLinkText,
  products = [],
} = Astro.props;

const safeBadge = badge || 'Product Portfolio';
const safeTitle = title || 'What We Manufacture & Supply';
const safeDesc = description || 'Engineered for ultra-high temperature endurance, chemical inertness, and tight mechanical tolerances. Every product is 100% batch inspected.';
const safeBtnText = buttonText || 'Browse All Products';
const safeLinkText = cardLinkText || 'View Full Specs';

// Default fallback items if no products are explicitly selected in Sanity yet
const defaultProducts = [
  { name: 'Colloidal Graphite Suspension', slug: 'graphite-suspension', mainImage: '/images/products/graphite-suspension.jpg', categoryName: 'Liquid Formulations', shortDescription: 'High-purity liquid graphite formulations engineered for forging dies, aluminum extrusion, and heavy metallurgical lubrication with superior heat dispersion.', specifications: [{ name: 'Purity', value: '99.9% Purity • High Dispersibility' }] },
  { name: 'High-Density Graphite Crucibles', slug: 'graphite-crucibles', mainImage: '/images/products/graphite-crucibles.jpg', categoryName: 'Foundry & Metallurgy', shortDescription: 'Isostatic pressed crucibles engineered for continuous non-ferrous and precious metal melting up to 3000°C.', specifications: [{ name: 'Rating', value: 'Up to 3000°C Max Temp' }] },
  { name: 'Flexible Graphite Foil Tape & Sheet', slug: 'graphite-foil-tape', mainImage: '/images/products/graphite-foil-tape.jpg', categoryName: 'Thermal Gasketing', shortDescription: 'Pure expanded flexible mineral graphite tape with proprietary Alubonding adhesive.', specifications: [{ name: 'Slitting', value: 'Custom Slit Widths' }] },
  { name: 'Carbon Steel Doctor Blades', slug: 'carbon-steel-doctor-blades', mainImage: '/images/products/carbon-steel-doctor-blades.jpg', categoryName: 'Flexo & Gravure', shortDescription: 'Swedish carbon steel doctor blades micro-honed with precision lamella and bevel edges.', specifications: [{ name: 'Edge', value: 'Lamella / Bevel Edges' }] },
  { name: 'Graphite Gland Rope & Packing', slug: 'graphite-gland-rope', mainImage: '/images/products/graphite-gland-rope.jpg', categoryName: 'High-Temp Sealing', shortDescription: 'Inconel wire reinforced braided expanded graphite gland packing for extreme pressure valves.', specifications: [{ name: 'Duty', value: 'Inconel Wire Reinforced' }] },
  { name: 'Graphite Machined Sleeves & Bushings', slug: 'graphite-sleeves', mainImage: '/images/products/graphite-sleeves.jpg', categoryName: 'Precision CNC', shortDescription: 'Custom 5-axis CNC turned self-lubricating graphite sleeves for submerged bearings.', specifications: [{ name: 'Tolerance', value: '±0.02mm Tolerance' }] },
];

const rawList = Array.isArray(products) && products.length > 0 ? products.filter(Boolean) : defaultProducts;
const [heroProduct, ...gridProducts] = rawList.length > 0 ? rawList : defaultProducts;
---

<section class="py-24 relative overflow-hidden bg-[#07090e] border-t border-white/8 dot-matrix-bg">

  <!-- Ambient Glow -->
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,var(--primary-glow-subtle),transparent_70%)] pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">

    <!-- Section header with entrance reveal -->
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-14 gap-6" data-reveal="fade-up">
      <div class="max-w-2xl space-y-3">
        <span class="theme-pill">{safeBadge}</span>
        <h2 class="display-lg text-white font-black tracking-tight" style="font-family:'Outfit',sans-serif;">
          {safeTitle.includes('&') ? (
            <>
              {safeTitle.split('&')[0]} &amp; <span class="text-theme-gradient">{safeTitle.split('&')[1]}</span>
            </>
          ) : (
            <span>{safeTitle}</span>
          )}
        </h2>
        <p class="text-slate-400 text-sm sm:text-base leading-relaxed">
          {safeDesc}
        </p>
      </div>
      <a href="/products" data-magnetic class="forge-btn-ghost rounded-xl text-xs px-5 py-3 shrink-0 self-start md:self-auto">
        <span>{safeBtnText}</span>
        <span class="text-theme-bright">→</span>
      </a>
    </div>

    <!-- Bento Grid Showcase -->
    {heroProduct && (
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6" data-reveal="stagger">

        <!-- Hero Bento Card (Large - Spans 2 cols on LG) -->
        <div
          data-tilt
          data-tilt-max="4"
          data-spotlight
          class="lg:col-span-2 glow-card rounded-2xl overflow-hidden group border border-white/10 flex flex-col justify-between min-h-[440px] relative bg-[#0d1117]"
        >
          <div class="absolute inset-0 overflow-hidden">
            <img
              src={heroProduct.mainImage || '/images/products/graphite-suspension.jpg'}
              alt={heroProduct.name}
              class="w-full h-full object-cover opacity-60 group-hover:opacity-75 group-hover:scale-105 transition-all duration-700"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-[#07090e] via-[#07090e]/60 to-transparent"></div>
          </div>

          <!-- Top Badges -->
          <div class="relative z-10 p-6 flex justify-between items-start">
            <div class="space-y-1">
              <span class="text-[10px] font-bold text-theme-bright bg-[var(--primary)]/15 border border-[var(--primary)]/30 px-3 py-1 rounded-md font-mono uppercase tracking-widest backdrop-blur-md">
                {heroProduct.categoryName || 'Flagship Item'}
              </span>
              <div class="text-[11px] text-emerald-400 font-mono flex items-center gap-1.5 pt-1">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                <span>Flagship Product</span>
              </div>
            </div>

            <button
              type="button"
              data-open-quote-modal
              data-product-name={heroProduct.name}
              data-product-category={heroProduct.categoryName}
              class="forge-btn-primary text-xs px-4 py-2 rounded-lg cursor-pointer shadow-lg"
            >
              <span>Quote</span>
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
            </button>
          </div>

          <!-- Bottom Content -->
          <div class="relative z-10 p-6 sm:p-8 space-y-3">
            <h3 class="text-2xl sm:text-3xl font-black text-white leading-tight group-hover:text-theme-bright transition-colors" style="font-family:'Outfit',sans-serif;">
              <a href={`/products/${heroProduct.slug}`}>{heroProduct.name}</a>
            </h3>
            <p class="text-slate-300 text-sm max-w-xl leading-relaxed">
              {heroProduct.shortDescription}
            </p>
            <div class="pt-2 flex items-center justify-between">
              <span class="text-xs font-mono text-slate-400 bg-white/5 border border-white/10 px-3 py-1 rounded-md">
                {heroProduct.specifications?.[0]?.value || 'Certified Industrial Grade'}
              </span>
              <a href={`/products/${heroProduct.slug}`} class="text-xs font-bold text-theme-bright font-mono uppercase tracking-wider flex items-center gap-1 hover:underline">
                <span>{safeLinkText}</span>
                <span>→</span>
              </a>
            </div>
          </div>
        </div>

        <!-- Grid Cards for Remaining Showcase Products -->
        {gridProducts.map((product) => (
          <div
            data-tilt
            data-tilt-max="5"
            data-spotlight
            class="glow-card rounded-2xl overflow-hidden group border border-white/10 flex flex-col justify-between min-h-[340px] h-full relative bg-[#0d1117]"
          >
            <div class="absolute inset-0 overflow-hidden">
              <img
                src={product.mainImage || '/images/products/graphite-crucibles.jpg'}
                alt={product.name}
                class="w-full h-full object-cover opacity-50 group-hover:opacity-70 group-hover:scale-105 transition-all duration-700"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-[#07090e] via-[#07090e]/70 to-transparent"></div>
            </div>

            <!-- Top Badge -->
            <div class="relative z-10 p-5 flex justify-between items-start">
              <span class="text-[10px] font-bold text-slate-300 bg-black/60 border border-white/15 px-2.5 py-0.5 rounded font-mono uppercase tracking-wider backdrop-blur-md max-w-[70%] truncate">
                {product.categoryName || 'Industrial Item'}
              </span>

              <button
                type="button"
                data-open-quote-modal
                data-product-name={product.name}
                data-product-category={product.categoryName}
                class="p-2 rounded-lg bg-white/10 hover:bg-[var(--primary)] text-white transition-colors cursor-pointer"
                title="Get Quote"
              >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
              </button>
            </div>

            <!-- Bottom Content -->
            <div class="relative z-10 p-5 space-y-2.5 mt-auto">
              <h4 class="text-lg font-bold text-white leading-snug group-hover:text-theme-bright transition-colors line-clamp-1 h-7" style="font-family:'Outfit',sans-serif;">
                <a href={`/products/${product.slug}`} title={product.name}>{product.name}</a>
              </h4>
              <p class="text-xs text-slate-300 line-clamp-2 h-9 leading-relaxed">
                {product.shortDescription}
              </p>
              <div class="pt-2 border-t border-white/[0.08] flex items-center justify-between">
                <span class="text-[11px] font-mono text-slate-400 truncate max-w-[60%]">
                  {product.specifications?.[0]?.value || 'Tight Tolerances'}
                </span>
                <a href={`/products/${product.slug}`} class="text-xs font-bold text-theme-bright hover:underline flex items-center gap-1 font-mono shrink-0">
                  <span>{safeLinkText} →</span>
                </a>
              </div>
            </div>
          </div>
        ))}

      </div>
    )}

  </div>
</section>
