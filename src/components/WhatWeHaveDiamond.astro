---
export interface ProductShowcaseItem {
  name: string;
  slug: string;
  image: string;
  category: string;
}

const showcaseProducts: ProductShowcaseItem[] = [
  { name: 'Colloidal Graphite Suspension', slug: 'graphite-suspension', image: '/images/products/graphite-suspension.jpg', category: 'Liquid Formulations' },
  { name: 'Graphite Gland Rope & Packing', slug: 'graphite-gland-rope', image: '/images/products/graphite-gland-rope.jpg', category: 'High-Temp Sealing' },
  { name: 'High-Density Graphite Crucibles', slug: 'graphite-crucibles', image: '/images/products/graphite-crucibles.jpg', category: 'Foundry & Metallurgy' },
  { name: 'Carbon Steel Doctor Blades', slug: 'carbon-steel-doctor-blades', image: '/images/products/carbon-steel-doctor-blades.jpg', category: 'Flexo & Gravure Printing' },
  { name: 'Polymer Doctor Blades', slug: 'polymer-doctor-blades', image: '/images/products/polymer-doctor-blades.jpg', category: 'Flexo & Gravure Printing' },
  { name: 'Graphite Foil Tape & Sheet', slug: 'graphite-foil-tape', image: '/images/products/graphite-foil-tape.jpg', category: 'Thermal Gasketing' },
  { name: 'High-Temp End Seals', slug: 'end-seals', image: '/images/products/end-seals.jpg', category: 'Chamber Sealing' },
  { name: 'Graphite Machined Sleeves & Bushings', slug: 'graphite-sleeves', image: '/images/products/graphite-sleeves.jpg', category: 'Precision CNC Machining' },
];
---

<section class="py-28 lg:py-36 bg-[#07090e] border-t border-b border-white/5 relative overflow-hidden">
  <!-- Soft Ambient Glow -->
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[800px] bg-[radial-gradient(ellipse_at_center,rgba(212,175,55,0.08),transparent_70%)] pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Section Header -->
    <div class="max-w-3xl mx-auto text-center space-y-5 mb-20 reveal-on-scroll">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-gold-500/10 border border-gold-500/25 text-gold-400 text-xs font-bold uppercase tracking-widest font-mono">
        Product Portfolio Overview
      </div>

      <h2 class="text-3xl sm:text-5xl lg:text-6xl font-black text-white tracking-tight leading-tight">
        What We <span class="text-gold-gradient font-black">Have</span>
      </h2>

      <p class="text-slate-300 text-base sm:text-lg font-normal leading-relaxed">
        We pride ourselves on our exceptional production capacity and commitment to timely delivery, ensuring that your orders are fulfilled on schedule with the highest standards of quality. Discover how our solutions can meet your industrial needs with speed and excellence.
      </p>
    </div>

    <!-- Spacious Modern Product Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
      {showcaseProducts.map((item) => (
        <div class="group relative bg-[#0d111a] rounded-2xl overflow-hidden border border-white/10 hover:border-gold-500/40 transition-all duration-500 hover:-translate-y-2 shadow-2xl flex flex-col justify-between reveal-on-scroll">
          
          <div>
            <!-- Image Frame -->
            <div class="aspect-4/3 overflow-hidden relative bg-[#040508]">
              <img
                src={item.image}
                alt={item.name}
                class="w-full h-full object-cover group-hover:scale-108 transition-transform duration-700 opacity-90 group-hover:opacity-100"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-[#0d111a] via-transparent to-transparent"></div>
              
              <!-- Category Badge -->
              <div class="absolute top-3 left-3 bg-[#07090e]/90 backdrop-blur-md px-3 py-1 rounded-full text-[10px] font-bold text-gold-400 border border-gold-500/30 font-mono shadow-md">
                {item.category}
              </div>
            </div>

            <!-- Content -->
            <div class="p-6 space-y-2">
              <h3 class="text-lg font-bold text-white group-hover:text-gold-400 transition-colors leading-snug">
                {item.name}
              </h3>
            </div>
          </div>

          <!-- Bottom Action Link -->
          <div class="px-6 pb-6 pt-2 flex items-center justify-between border-t border-white/5 mt-2">
            <a
              href={`/products/${item.slug}`}
              class="text-xs font-bold text-gold-400 hover:text-gold-300 flex items-center gap-1.5 font-mono tracking-wide transition-colors"
            >
              <span>Explore Specs</span>
              <svg class="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform text-gold-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/></svg>
            </a>

            <button
              type="button"
              data-open-quote-modal
              data-product-name={item.name}
              data-product-category={item.category}
              class="px-3 py-1.5 bg-gold-500/10 hover:bg-gold-500/20 text-gold-300 border border-gold-500/30 rounded-lg text-[11px] font-semibold transition-colors cursor-pointer"
            >
              Quote &rarr;
            </button>
          </div>

        </div>
      ))}
    </div>

    <!-- Bottom Statement Banner -->
    <div class="mt-20 p-8 sm:p-12 rounded-3xl bg-gradient-to-r from-[#0d111a] via-[#121724] to-[#0d111a] border border-gold-500/25 text-center max-w-4xl mx-auto shadow-2xl reveal-on-scroll">
      <p class="text-base sm:text-xl font-bold text-slate-200 uppercase tracking-wide leading-relaxed font-heading">
        Delivering Premium <span class="text-gold-gradient font-black">Graphite Solutions</span> with Unmatched Quality and Speed.
      </p>
    </div>

  </div>
</section>
