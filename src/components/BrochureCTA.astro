---
export interface Props {
  brochureUrl?: string;
}

const { brochureUrl = '/docs/VM_Graphite_Corporate_Brochure.pdf' } = Astro.props;
---

<section class="py-28 lg:py-36 bg-[#07090e] text-slate-100 relative overflow-hidden border-b border-white/5">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <div class="bg-[#0e131f] rounded-3xl p-8 sm:p-16 shadow-2xl border border-white/10 flex flex-col lg:flex-row items-center justify-between gap-12 relative overflow-hidden reveal-on-scroll">
      
      <!-- Background Ambient Glow -->
      <div class="absolute -right-20 -bottom-20 w-96 h-96 bg-[radial-gradient(circle,rgba(212,175,55,0.1),transparent_70%)] pointer-events-none"></div>

      <div class="space-y-5 max-w-2xl text-center lg:text-left relative z-10">
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-gold-500/10 text-gold-400 border border-gold-500/25 text-xs font-bold uppercase tracking-widest font-mono">
          Official Technical Documentation
        </div>
        <h3 class="text-3xl sm:text-4xl lg:text-5xl font-black text-white leading-tight tracking-tight">
          Download VM Graphite <span class="text-gold-gradient font-black">Corporate Catalog &amp; Brochure</span>
        </h3>
        <p class="text-slate-300 text-base sm:text-lg leading-relaxed font-normal">
          Access complete product dimensions, thermal performance charts, chemical resistance matrices, and ISO manufacturing certifications in a single convenient PDF brochure.
        </p>
      </div>

      <div class="flex flex-col sm:flex-row items-center gap-4 relative z-10 shrink-0 w-full sm:w-auto">
        <a
          href={brochureUrl}
          target="_blank"
          download="VM_Graphite_Industries_Brochure.pdf"
          class="w-full sm:w-auto px-8 py-4 bg-gradient-to-r from-amber-400 via-gold-400 to-amber-500 hover:from-amber-300 hover:to-amber-400 text-slate-950 font-black rounded-xl border border-amber-200/80 shadow-[0_4px_25px_rgba(245,158,11,0.4)] flex items-center justify-center gap-3 transition-all transform hover:-translate-y-0.5 active:translate-y-0 text-base font-sans uppercase tracking-wider"
          aria-label="Download VM Graphite Corporate PDF Brochure"
        >
          <svg class="w-5 h-5 text-slate-950" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
          <span>Download PDF Brochure</span>
        </a>

        <a
          href="/downloads"
          class="w-full sm:w-auto px-6 py-4 bg-[#141b2d] hover:bg-[#1e293b] text-slate-200 border border-white/10 text-base font-bold rounded-xl transition-colors text-center shadow-md"
        >
          View Datasheets
        </a>
      </div>

    </div>

  </div>
</section>
