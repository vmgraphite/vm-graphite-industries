---
export interface Props {
  brochureUrl?: string;
}

const { brochureUrl = '/docs/VM_Graphite_Corporate_Brochure.pdf' } = Astro.props;
---

<section class="py-20 bg-slate-50/80 text-slate-900 relative overflow-hidden border-b border-slate-200/80">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <div class="glass-card-light rounded-3xl p-8 sm:p-14 shadow-lg border border-amber-500/20 flex flex-col lg:flex-row items-center justify-between gap-10 relative overflow-hidden reveal-on-scroll">
      
      <!-- Background Technical Light Accent -->
      <div class="absolute -right-16 -bottom-16 w-96 h-96 bg-amber-500/10 rounded-full blur-[100px] pointer-events-none"></div>

      <div class="space-y-4 max-w-2xl text-center lg:text-left relative z-10">
        <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-amber-500/10 text-industrial-copper border border-amber-500/20 text-xs font-bold uppercase tracking-wider font-mono">
          Official Technical Documentation
        </div>
        <h3 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-slate-900 leading-tight tracking-tight">
          Download VM Graphite Corporate Brochure &amp; Technical Catalog
        </h3>
        <p class="text-slate-600 text-base sm:text-lg leading-relaxed font-normal">
          Access complete product dimensions, thermal performance charts, chemical resistance matrices, and ISO manufacturing certifications in a single convenient PDF datasheet.
        </p>
      </div>

      <div class="flex flex-col sm:flex-row items-center gap-4 relative z-10 shrink-0 w-full sm:w-auto">
        <a
          href={brochureUrl}
          target="_blank"
          download="VM_Graphite_Industries_Brochure.pdf"
          class="w-full sm:w-auto px-8 py-4 bg-gradient-to-r from-industrial-copper to-amber-600 hover:from-amber-600 hover:to-industrial-copper text-white font-bold rounded-xl shadow-[0_4px_20px_rgba(217,119,6,0.3)] flex items-center justify-center gap-3 transition-all transform hover:-translate-y-0.5 active:translate-y-0 text-base"
          aria-label="Download VM Graphite Corporate PDF Brochure"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
          <span>Download PDF Brochure</span>
        </a>

        <a
          href="/downloads"
          class="w-full sm:w-auto px-6 py-4 bg-white hover:bg-slate-50 text-slate-800 border border-slate-300 text-base font-bold rounded-xl transition-colors text-center shadow-2xs"
        >
          View Datasheets
        </a>
      </div>

    </div>

  </div>
</section>


