---
export interface Props {
  brochureUrl?: string;
}

const { brochureUrl = '/docs/VM_Graphite_Corporate_Brochure.pdf' } = Astro.props;
---

<section class="relative overflow-hidden border-t border-white/8 bg-[#07090e]">
  
  <!-- Radiant Ambient Forge Gradient -->
  <div class="absolute inset-0 bg-gradient-to-br from-[#1c1202] via-[#0c0f17] to-[#07090e]"></div>
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_70%_50%,rgba(232,160,32,0.18),transparent_70%)]"></div>
  
  <!-- Glowing Section Dividers -->
  <div class="absolute top-0 inset-x-0 h-px bg-gradient-to-r from-transparent via-amber-500/60 to-transparent"></div>
  <div class="absolute bottom-0 inset-x-0 h-px bg-gradient-to-r from-transparent via-amber-500/30 to-transparent"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 lg:py-28 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">

      <!-- Left: Copy & Bullet Features -->
      <div class="lg:col-span-7 space-y-6 reveal-on-scroll">
        <span class="amber-pill">Official Technical Documentation</span>
        
        <h2 class="display-lg text-white font-black tracking-tight leading-tight" style="font-family:'Outfit',sans-serif;">
          Download VM Graphite<br/>
          <span class="text-gold-gradient">Corporate Catalog</span><br/>
          &amp; Technical Brochure
        </h2>

        <p class="text-slate-300 text-sm sm:text-base leading-relaxed max-w-xl font-normal">
          Access complete product dimensions, thermal performance charts, chemical resistance matrices, and ISO manufacturing certifications in a single convenient PDF brochure.
        </p>

        <!-- Feature list -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-2">
          {[
            'Product dimensions & tolerances',
            'Thermal performance charts',
            'ISO 9001:2015 certifications',
            'Spectrographic analysis data',
          ].map((f) => (
            <div class="flex items-center gap-2.5 text-xs sm:text-sm text-slate-200">
              <span class="w-5 h-5 rounded-md bg-amber-500/10 border border-amber-500/30 flex items-center justify-center shrink-0">
                <svg class="w-3 h-3 text-[#f7c355]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg>
              </span>
              <span>{f}</span>
            </div>
          ))}
        </div>
      </div>

      <!-- Right: Stamp CTA Card -->
      <div class="lg:col-span-5 flex justify-center lg:justify-end reveal-scale">
        <div class="relative w-full max-w-md">
          
          <div class="glow-card rounded-2xl border border-amber-500/30 p-7 sm:p-8 space-y-6 bg-[#0d1017] shadow-[0_20px_60px_rgba(0,0,0,0.9),0_0_40px_rgba(232,160,32,0.15)]">
            
            <!-- Document Header -->
            <div class="flex items-center justify-between">
              <div class="w-14 h-14 rounded-xl bg-amber-500/10 border border-amber-500/30 flex items-center justify-center shadow-inner">
                <svg class="w-7 h-7 text-[#f7c355]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"/>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 10v6m0 0l-3-3m3 3l3-3"/>
                </svg>
              </div>
              <span class="text-[10px] font-mono font-bold text-[#f7c355] bg-amber-500/10 border border-amber-500/25 px-2.5 py-1 rounded uppercase tracking-wider">
                PDF Specification
              </span>
            </div>

            <div>
              <h3 class="text-xl font-black text-white leading-snug" style="font-family:'Outfit',sans-serif;">
                Corporate Brochure<br/>&amp; Product Catalog
              </h3>
              <p class="text-slate-400 text-xs mt-1.5 font-normal">Comprehensive technical reference for engineers &amp; buyers</p>
            </div>

            <!-- Action Buttons -->
            <div class="space-y-3">
              <a
                href={brochureUrl}
                target="_blank"
                download="VM_Graphite_Industries_Brochure.pdf"
                class="forge-btn-primary w-full justify-center rounded-xl py-3.5 text-xs"
                aria-label="Download VM Graphite Corporate PDF Brochure"
              >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                <span>Download PDF Brochure</span>
              </a>

              <a
                href="/downloads"
                class="forge-btn-ghost w-full justify-center rounded-xl py-3 text-xs"
              >
                <span>View All Technical Datasheets</span>
              </a>
            </div>

            <!-- Certified documentation badge -->
            <div class="flex items-center gap-2 pt-2 border-t border-white/10">
              <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
              <span class="text-[11px] text-slate-400 font-mono">ISO 9001:2015 Certified Documentation</span>
            </div>

          </div>
        </div>
      </div>

    </div>
  </div>
</section>
