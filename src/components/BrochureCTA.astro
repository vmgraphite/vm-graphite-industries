---
export interface Props {
  brochureUrl?: string;
}

const { brochureUrl = '/docs/VM_Graphite_Corporate_Brochure.pdf' } = Astro.props;
---

<section class="relative overflow-hidden border-t border-white/5">
  <!-- Full-bleed amber-to-dark diagonal gradient -->
  <div class="absolute inset-0 bg-gradient-to-br from-[#1a1000] via-[#0f0a00] to-[#0a0b0f]"></div>
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_60%_50%,rgba(232,160,32,0.15),transparent_70%)]"></div>
  <!-- Top amber rule -->
  <div class="absolute top-0 inset-x-0 h-px bg-gradient-to-r from-transparent via-[rgba(232,160,32,0.6)] to-transparent"></div>
  <!-- Bottom amber rule -->
  <div class="absolute bottom-0 inset-x-0 h-px bg-gradient-to-r from-transparent via-[rgba(232,160,32,0.2)] to-transparent"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-24 lg:py-32 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center">

      <!-- Left: Copy -->
      <div class="space-y-6 reveal-on-scroll">
        <span class="amber-pill">Official Technical Documentation</span>
        
        <h2 class="font-black text-white tracking-tighter leading-tight" style="font-size: clamp(2.2rem, 5vw, 4rem); font-family:'Outfit',sans-serif;">
          Download VM Graphite<br/>
          <span class="text-amber-gradient">Corporate Catalog</span><br/>
          &amp; Brochure
        </h2>

        <p class="text-slate-400 text-base sm:text-lg leading-relaxed max-w-lg">
          Access complete product dimensions, thermal performance charts, chemical resistance matrices, and ISO manufacturing certifications in a single convenient PDF brochure.
        </p>

        <!-- Feature list -->
        <ul class="space-y-2.5">
          {[
            'Complete product dimensions & tolerances',
            'Thermal performance & chemical resistance charts',
            'ISO 9001:2015 manufacturing certifications',
            'Spectrographic analysis data sheets',
          ].map((f) => (
            <li class="flex items-start gap-3 text-sm text-slate-300">
              <span class="w-5 h-5 rounded bg-[rgba(232,160,32,0.12)] border border-[rgba(232,160,32,0.25)] flex items-center justify-center shrink-0 mt-0.5">
                <svg class="w-3 h-3 text-[#e8a020]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg>
              </span>
              {f}
            </li>
          ))}
        </ul>
      </div>

      <!-- Right: Stamp CTA card -->
      <div class="flex justify-center lg:justify-end reveal-on-scroll">
        <div class="relative w-full max-w-sm">
          <!-- Outer stamp frame -->
          <div class="absolute inset-0 rounded-2xl border-2 border-dashed border-[rgba(232,160,32,0.25)] -m-3"></div>
          
          <div class="bg-[#111318] rounded-xl border border-[rgba(232,160,32,0.2)] p-8 space-y-6 shadow-[0_20px_60px_rgba(0,0,0,0.7),0_0_40px_rgba(232,160,32,0.08)]">
            <!-- Document icon -->
            <div class="w-16 h-16 rounded-xl bg-[rgba(232,160,32,0.1)] border border-[rgba(232,160,32,0.2)] flex items-center justify-center">
              <svg class="w-8 h-8 text-[#e8a020]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"/>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 10v6m0 0l-3-3m3 3l3-3"/>
              </svg>
            </div>

            <div>
              <div class="text-[10px] font-mono font-bold text-[#e8a020] uppercase tracking-widest mb-1">PDF Document</div>
              <h3 class="text-xl font-black text-white leading-snug" style="font-family:'Outfit',sans-serif;">
                Corporate Brochure<br/>& Product Catalog
              </h3>
              <p class="text-slate-500 text-sm mt-2">Comprehensive B2B industrial reference</p>
            </div>

            <div class="space-y-3">
              <a
                href={brochureUrl}
                target="_blank"
                download="VM_Graphite_Industries_Brochure.pdf"
                class="forge-btn-primary w-full justify-center rounded-lg"
                aria-label="Download VM Graphite Corporate PDF Brochure"
              >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                Download PDF Brochure
              </a>

              <a
                href="/downloads"
                class="forge-btn-ghost w-full justify-center rounded-lg"
              >
                View All Datasheets
              </a>
            </div>

            <!-- Stamp badge -->
            <div class="flex items-center gap-2 pt-2 border-t border-white/8">
              <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
              <span class="text-[11px] text-slate-500 font-mono">ISO 9001:2015 Certified Documentation</span>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
