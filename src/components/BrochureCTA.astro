---
export interface Props {
  brochureUrl?: string;
  badge?: string;
  title?: string;
  description?: string;
  features?: string[];
  cardTag?: string;
  cardTitle?: string;
  cardSubtitle?: string;
  buttonText?: string;
  secondaryButtonText?: string;
  cardCertText?: string;
}

const {
  brochureUrl,
  badge,
  title,
  description,
  features,
  cardTag,
  cardTitle,
  cardSubtitle,
  buttonText,
  secondaryButtonText,
  cardCertText,
} = Astro.props;

const safeBadge = badge || 'Official Technical Documentation';
const safeTitle = title || 'Download VM Graphite Corporate Catalog & Technical Brochure';
const safeDesc = description || 'Access complete product dimensions, thermal performance charts, chemical resistance matrices, and ISO manufacturing certifications in a single convenient PDF brochure.';
const safeBtnText = buttonText || 'Download PDF Brochure';
const safeSecBtnText = secondaryButtonText || 'View All Technical Datasheets';
const safeCardTag = cardTag || 'PDF Specification';
const safeCardTitle = cardTitle || 'Corporate Brochure & Product Catalog';
const safeCardSubtitle = cardSubtitle || 'Comprehensive technical reference for engineers & buyers';
const safeCardCert = cardCertText || 'ISO 9001:2015 Certified Documentation';

const defaultFeatures = [
  'Product dimensions & tolerances',
  'Thermal performance charts',
  'ISO 9001:2015 certifications',
  'Spectrographic analysis data',
];

const featureList = Array.isArray(features) && features.length > 0 ? features.filter(Boolean) : defaultFeatures;
---

<section class="relative overflow-hidden border-t border-white/[0.06] bg-[#07090e]">
  
  <!-- Subtle Ambient Glow -->
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_70%_50%,var(--primary-glow-subtle),transparent_70%)] pointer-events-none"></div>
  
  <!-- Subtle Dividers -->
  <div class="absolute top-0 inset-x-0 h-px bg-gradient-to-r from-transparent via-[var(--primary)] to-transparent opacity-60"></div>
  <div class="absolute bottom-0 inset-x-0 h-px bg-gradient-to-r from-transparent via-[var(--primary)] to-transparent opacity-40"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 lg:py-28 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">

      <!-- Left: Copy & Bullet Features -->
      <div class="lg:col-span-7 space-y-6" data-reveal="fade-up">
        <span class="theme-pill">{safeBadge}</span>
        
        <h2 class="display-lg text-white font-black tracking-tight leading-tight" style="font-family:'Outfit',sans-serif;">
          {safeTitle.includes('&') ? (
            <>
              {safeTitle.split('&')[0]}<br/>
              <span class="text-theme-gradient">{safeTitle.split('&')[1]}</span>
            </>
          ) : (
            <span>{safeTitle}</span>
          )}
        </h2>

        <p class="text-slate-300 text-sm sm:text-base leading-relaxed max-w-xl font-normal">
          {safeDesc}
        </p>

        <!-- Feature list with Stagger -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-2" data-reveal="stagger">
          {featureList.map((f) => (
            <div class="flex items-center gap-2.5 text-xs sm:text-sm text-slate-200">
              <span class="w-5 h-5 rounded-md bg-theme-tint border border-theme flex items-center justify-center shrink-0">
                <svg class="w-3 h-3 text-[var(--primary)]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg>
              </span>
              <span>{f}</span>
            </div>
          ))}
        </div>
      </div>

      <!-- Right: Stamp CTA Card -->
      <div class="lg:col-span-5 flex justify-center lg:justify-end" data-reveal="zoom-in" data-reveal-delay="200">
        <div class="relative w-full max-w-md">
          
          <div
            data-tilt
            data-tilt-max="6"
            data-spotlight
            class="glow-card rounded-2xl border border-white/[0.08] p-7 sm:p-8 space-y-6 bg-[#0f1118] shadow-[0_20px_60px_rgba(0,0,0,0.9)]"
          >
            
            <!-- Document Header -->
            <div class="flex items-center justify-between">
              <div class="w-12 h-12 rounded-xl bg-white/[0.04] border border-white/[0.1] flex items-center justify-center shadow-inner">
                <svg class="w-6 h-6 text-theme-bright" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"/>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 10v6m0 0l-3-3m3 3l3-3"/>
                </svg>
              </div>
              <span class="text-[10px] font-mono font-bold text-theme-bright bg-theme-tint border border-theme px-2.5 py-1 rounded uppercase tracking-wider">
                {safeCardTag}
              </span>
            </div>

            <div>
              <h3 class="text-xl font-black text-white leading-snug" style="font-family:'Outfit',sans-serif;">
                {safeCardTitle}
              </h3>
              <p class="text-slate-400 text-xs mt-1.5 font-normal">{safeCardSubtitle}</p>
            </div>

            <!-- Action Buttons -->
            <div class="space-y-3">
              {brochureUrl ? (
                <a
                  href={brochureUrl}
                  target="_blank"
                  download
                  data-magnetic
                  class="forge-btn-primary w-full justify-center rounded-full py-3 text-xs font-semibold"
                  aria-label="Download VM Graphite Corporate PDF Brochure"
                >
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                  <span>{safeBtnText}</span>
                </a>
              ) : null}

              <a
                href="/downloads"
                data-magnetic
                class="forge-btn-ghost w-full justify-center rounded-full py-2.5 text-xs font-semibold"
              >
                <span>{safeSecBtnText}</span>
              </a>
            </div>

            <!-- Certified documentation badge -->
            <div class="flex items-center gap-2 pt-2 border-t border-white/[0.06]">
              <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
              <span class="text-[11px] text-slate-400 font-mono">{safeCardCert}</span>
            </div>

          </div>
        </div>
      </div>

    </div>
  </div>
</section>
