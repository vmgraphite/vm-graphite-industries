---
export interface BreadcrumbItem {
  name: string;
  href?: string;
}

export interface Props {
  items: BreadcrumbItem[];
}

const { items } = Astro.props;
---

<nav aria-label="Breadcrumb" class="py-3 px-4 bg-slate-900/60 rounded-xl border border-slate-800/80 mb-6 text-xs">
  <ol class="flex flex-wrap items-center gap-2 text-slate-400">
    <li>
      <a href="/" class="hover:text-industrial-copper flex items-center gap-1 transition-colors">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>
        <span>Home</span>
      </a>
    </li>
    {items.map((item, index) => (
      <li class="flex items-center gap-2">
        <svg class="w-3.5 h-3.5 text-slate-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        {item.href && index < items.length - 1 ? (
          <a href={item.href} class="hover:text-industrial-copper transition-colors">
            {item.name}
          </a>
        ) : (
          <span class="text-white font-semibold">{item.name}</span>
        )}
      </li>
    ))}
  </ol>
</nav>
