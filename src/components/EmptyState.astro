---
export interface Props {
  title?: string;
  message?: string;
  actionText?: string;
  actionUrl?: string;
  actionId?: string;
}

const {
  title = 'No Products Found',
  message = 'We could not find any products matching your current search or category filter. Try clearing your filters or contact our technical team for custom material sourcing.',
  actionText = 'Clear All Filters',
  actionUrl = '/products',
  actionId = 'empty-state-action-btn',
} = Astro.props;
---

<div class="bg-[#0d1017] border border-white/10 rounded-2xl p-10 sm:p-12 text-center max-w-lg mx-auto my-12 shadow-2xl space-y-4 glow-card">
  <div class="w-16 h-16 bg-white/5 border border-white/10 text-theme-bright rounded-2xl flex items-center justify-center mx-auto shadow-inner">
    <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
  </div>
  <h3 class="text-xl font-bold text-white" style="font-family:'Outfit',sans-serif;">{title}</h3>
  <p class="text-xs sm:text-sm text-slate-400 leading-relaxed max-w-md mx-auto">{message}</p>
  <div class="pt-4">
    <a
      id={actionId}
      href={actionUrl}
      class="forge-btn-primary rounded-xl px-6 py-2.5 text-xs font-bold inline-flex items-center gap-2 cursor-pointer shadow-lg"
    >
      <span>{actionText}</span>
      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
    </a>
  </div>
</div>

