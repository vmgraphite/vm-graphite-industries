---
const capabilities = [
  {
    step: '01',
    title: 'Isostatic & Hydrostatic Pressing',
    desc: 'High-density graphite forming under multi-directional hydrostatic pressure for ultra-fine grain uniformity and zero micro-voids.',
    metric: '1.95 g/cm³ Density',
  },
  {
    step: '02',
    title: '5-Axis Precision CNC Machining',
    desc: 'High-speed CNC milling and turning centers capable of executing tight-tolerance graphite sleeve and crucible geometry.',
    metric: '±0.02 mm Tolerance',
  },
  {
    step: '03',
    title: 'Thermal Metalizing & Coating',
    desc: 'Automated spray coating lines applying protective micro-graphite, boron nitride, and ceramic thermal barrier films.',
    metric: '3000°C Thermal Limit',
  },
  {
    step: '04',
    title: 'Spectrographic Purity Analysis',
    desc: 'In-house spectrographic purity analysis, ash content verification, and ultrasonic density scans for every manufactured batch.',
    metric: '99.9% Carbon Assurance',
  },
];
---

<section class="py-24 relative overflow-hidden bg-[#07090e] border-t border-white/8 scanline-bg">

  <!-- Top amber glowing line -->
  <div class="absolute top-0 inset-x-0 h-px bg-gradient-to-r from-transparent via-amber-500/50 to-transparent pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">

    <!-- Section header & Facility Stats -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-start mb-16">
      
      <div class="lg:col-span-5 space-y-6 reveal-on-scroll">
        <span class="amber-pill">Manufacturing Infrastructure</span>
        <h2 class="display-lg text-white font-black tracking-tight" style="font-family:'Outfit',sans-serif;">
          State-of-the-Art<br/>
          <span class="text-gold-gradient">Plant Capabilities</span>
        </h2>
        <p class="text-slate-300 text-sm sm:text-base leading-relaxed font-normal">
          Our specialized manufacturing units house high-tech machinery engineered for extreme material processing. From high-purity synthetic graphite machining to automated colloidal dispersions, we enforce zero-defect quality control.
        </p>

        <!-- Facility Live Stats -->
        <div class="grid grid-cols-2 gap-4 pt-2">
          <div class="glow-card p-5 rounded-xl border border-white/10 bg-[#0d1017]">
            <div
              class="text-3xl font-black text-white font-mono mb-1"
              data-counter-target="50000"
              data-counter-decimals="0"
              data-counter-suffix="+"
            >
              50,000+
            </div>
            <div class="text-xs text-slate-400 font-medium">Sq. Ft. Production Floor</div>
          </div>
          <div class="glow-card p-5 rounded-xl border border-white/10 bg-[#0d1017]">
            <div
              class="text-3xl font-black text-[#f7c355] font-mono mb-1"
              data-counter-target="100"
              data-counter-decimals="0"
              data-counter-suffix="%"
            >
              100%
            </div>
            <div class="text-xs text-slate-400 font-medium">Batch Spectro Inspection</div>
          </div>
        </div>
      </div>

      <!-- Right: 4-Stage Pipeline Grid -->
      <div class="lg:col-span-7">
        <!-- Connecting Pipeline Header line (desktop) -->
        <div class="hidden lg:block h-px bg-gradient-to-r from-amber-500/20 via-amber-500/60 to-amber-500/20 mb-10 relative">
          <div class="absolute -top-1.5 left-0 w-3 h-3 rounded-full bg-amber-400 shadow-[0_0_10px_#f59e0b]"></div>
          <div class="absolute -top-1.5 right-0 w-3 h-3 rounded-full bg-amber-400 shadow-[0_0_10px_#f59e0b]"></div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
          {capabilities.map((cap, idx) => (
            <div class="glow-card p-6 rounded-2xl border border-white/10 hover:border-amber-500/30 transition-all duration-400 reveal-on-scroll shadow-xl">
              
              <!-- Watermark step number -->
              <div class="absolute top-2 right-4 font-black font-mono text-5xl leading-none opacity-[0.05] text-[#f7c355] select-none pointer-events-none">
                {cap.step}
              </div>

              <!-- Stage Badge & Metric Pill -->
              <div class="flex items-center justify-between mb-4">
                <span class="text-[10px] font-black font-mono text-[#f7c355] bg-amber-500/10 border border-amber-500/25 px-2.5 py-1 rounded-md uppercase tracking-wider">
                  Stage {cap.step}
                </span>
                <span class="text-[11px] font-bold text-[#38bdf8] bg-sky-500/10 border border-sky-500/20 px-2.5 py-1 rounded-md font-mono">
                  {cap.metric}
                </span>
              </div>

              <!-- Step Progress Bar Indicator -->
              <div class="w-full h-1 bg-white/8 rounded-full mb-4 relative overflow-hidden">
                <div
                  class="absolute top-0 left-0 h-full bg-gradient-to-r from-amber-400 to-amber-500 rounded-full"
                  style={`width: ${(idx + 1) * 25}%`}
                ></div>
              </div>

              <h3 class="text-base sm:text-lg font-bold text-white mb-2 group-hover:text-[#f7c355] transition-colors leading-snug" style="font-family:'Outfit',sans-serif;">
                {cap.title}
              </h3>
              <p class="text-xs sm:text-sm text-slate-400 leading-relaxed font-normal">
                {cap.desc}
              </p>
            </div>
          ))}
        </div>
      </div>

    </div>

  </div>
</section>
