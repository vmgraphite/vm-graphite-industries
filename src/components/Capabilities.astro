---
const capabilities = [
  {
    step: '01',
    title: 'Isostatic & Hydrostatic Pressing',
    desc: 'High-density graphite forming under multi-directional hydrostatic pressure for ultra-fine grain uniformity.',
    metric: '1.95 g/cm³ Density',
  },
  {
    step: '02',
    title: '5-Axis Precision CNC Machining',
    desc: 'High-speed CNC milling and turning centers capable of executing tight-tolerance graphite sleeve and mold geometry.',
    metric: '±0.02 mm Tolerance',
  },
  {
    step: '03',
    title: 'Thermal Metalizing & Coating',
    desc: 'Automated spray coating lines applying protective micro-graphite, boron nitride, and ceramic thermal barrier films.',
    metric: '3000°C Thermal Limit',
  },
  {
    step: '04',
    title: 'Spectrographic Purity Analysis',
    desc: 'In-house spectrographic purity analysis, ash content verification, and ultrasonic density scans for every batch.',
    metric: '99.9% Carbon Assurance',
  },
];
---

<section class="py-24 lg:py-32 relative overflow-hidden scanline-bg border-t border-white/5">

  <!-- Top amber glow -->
  <div class="absolute top-0 inset-x-0 h-px bg-gradient-to-r from-transparent via-[rgba(232,160,32,0.4)] to-transparent pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">

    <!-- Section header — left aligned -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-start mb-16">
      <div class="lg:col-span-5 space-y-5 reveal-on-scroll">
        <span class="amber-pill">Manufacturing Infrastructure</span>
        <h2 class="display-lg text-white font-black tracking-tighter" style="font-family:'Outfit',sans-serif;">
          State-of-the-Art<br/>
          <span class="text-amber-gradient">Plant Capabilities</span>
        </h2>
        <p class="text-slate-400 text-base leading-relaxed">
          Our specialized manufacturing plants house high-tech machinery engineered for extreme material processing. From high-purity synthetic graphite machining to automated colloidal suspensions, we maintain strict quality control.
        </p>

        <!-- Facility stats -->
        <div class="grid grid-cols-2 gap-4 pt-4">
          <div class="bg-[#111318] border border-white/8 rounded-xl p-5 hover:border-[rgba(232,160,32,0.25)] transition-colors">
            <div class="text-3xl font-black text-white font-mono mb-1">50,000<span class="text-[#e8a020]">+</span></div>
            <div class="text-xs text-slate-500 font-medium">Sq. Ft. Production Floor</div>
          </div>
          <div class="bg-[#111318] border border-white/8 rounded-xl p-5 hover:border-[rgba(232,160,32,0.25)] transition-colors">
            <div class="text-3xl font-black text-[#e8a020] font-mono mb-1">100%</div>
            <div class="text-xs text-slate-500 font-medium">Batch Spectro Inspection</div>
          </div>
        </div>
      </div>

      <!-- Right: Pipeline steps -->
      <div class="lg:col-span-7">
        <!-- Connecting pipeline line (desktop) -->
        <div class="hidden lg:block h-px bg-gradient-to-r from-[rgba(232,160,32,0.15)] via-[rgba(232,160,32,0.4)] to-[rgba(232,160,32,0.15)] mb-12 relative">
          <div class="absolute -top-1.5 left-0 w-3 h-3 rounded-full bg-[#e8a020]"></div>
          <div class="absolute -top-1.5 right-0 w-3 h-3 rounded-full bg-[#e8a020] opacity-40"></div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
          {capabilities.map((cap, idx) => (
            <div class="group relative bg-[#111318] rounded-xl border border-white/8 hover:border-[rgba(232,160,32,0.3)] transition-all duration-400 p-6 hover:-translate-y-1 reveal-on-scroll shadow-[0_4px_24px_rgba(0,0,0,0.4)]">
              
              <!-- Watermark step number -->
              <div class="absolute top-2 right-4 font-black font-mono text-6xl leading-none opacity-[0.04] text-[#e8a020] select-none pointer-events-none">
                {cap.step}
              </div>

              <!-- Stage badge -->
              <div class="flex items-center justify-between mb-4">
                <span class="text-[10px] font-black font-mono text-[#e8a020] bg-[rgba(232,160,32,0.1)] border border-[rgba(232,160,32,0.2)] px-2.5 py-1 rounded uppercase tracking-[0.15em]">
                  Stage {cap.step}
                </span>
                <span class="text-[11px] font-bold text-[#7dd3fc] bg-[rgba(125,211,252,0.08)] border border-[rgba(125,211,252,0.15)] px-2.5 py-1 rounded font-mono">
                  {cap.metric}
                </span>
              </div>

              <!-- Step indicator -->
              <div class="w-full h-px bg-white/8 mb-4 relative">
                <div
                  class="absolute top-0 left-0 h-full bg-gradient-to-r from-[#e8a020] to-transparent transition-all duration-500 group-hover:opacity-100"
                  style={`width: ${(idx + 1) * 25}%`}
                ></div>
              </div>

              <h3 class="text-lg font-bold text-white mb-2.5 group-hover:text-[#f7c355] transition-colors leading-snug" style="font-family:'Outfit',sans-serif;">
                {cap.title}
              </h3>
              <p class="text-sm text-slate-400 leading-relaxed">
                {cap.desc}
              </p>
            </div>
          ))}
        </div>
      </div>
    </div>

  </div>
</section>
