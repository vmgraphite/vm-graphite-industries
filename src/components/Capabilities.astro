---
const capabilities = [
  {
    step: '01',
    title: 'Isostatic & Hydrostatic Pressing',
    desc: 'High-density graphite forming under multi-directional hydrostatic pressure for ultra-fine grain uniformity.',
    metric: '1.95 g/cm³ Density',
  },
  {
    step: '02',
    title: '5-Axis Precision CNC Machining',
    desc: 'High-speed CNC milling and turning centers capable of executing tight-tolerance graphite sleeve and mold geometry.',
    metric: '±0.02 mm Tolerance',
  },
  {
    step: '03',
    title: 'Thermal Metalizing & Coating',
    desc: 'Automated spray coating lines applying protective micro-graphite, boron nitride, and ceramic thermal barrier films.',
    metric: '3000°C Thermal Limit',
  },
  {
    step: '04',
    title: 'Spectrographic Purity Analysis',
    desc: 'In-house spectrographic purity analysis, ash content verification, and ultrasonic density scans for every batch.',
    metric: '99.9% Carbon Assurance',
  },
];
---

<section class="py-28 lg:py-36 bg-[#090c15] text-slate-100 relative overflow-hidden border-b border-white/5">
  
  <!-- Subtle Ambient Glow -->
  <div class="absolute bottom-0 left-1/3 w-[600px] h-[600px] bg-[radial-gradient(circle,rgba(212,175,55,0.06),transparent_70%)] pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
      
      <!-- Left Column Text & Facility Stats -->
      <div class="lg:col-span-5 space-y-8 reveal-on-scroll">
        <div class="space-y-4">
          <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-gold-500/10 text-gold-400 border border-gold-500/25 text-xs font-bold uppercase tracking-widest font-mono">
            Manufacturing Infrastructure
          </div>
          <h2 class="text-3xl sm:text-5xl lg:text-6xl font-black text-white tracking-tight leading-tight">
            State-of-the-Art <span class="text-gold-gradient font-black">Plant Capabilities</span>
          </h2>
          <p class="text-slate-300 text-base sm:text-lg leading-relaxed font-normal">
            Our specialized manufacturing plants house high-tech machinery engineered for extreme material processing. From high-purity synthetic graphite machining to automated colloidal suspensions, we maintain strict quality control.
          </p>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div class="bg-[#0e131f] p-6 rounded-2xl border border-white/10 shadow-xl">
            <div class="text-3xl font-black text-white font-mono mb-1">50,000+</div>
            <div class="text-xs font-medium text-slate-400">Sq. Ft. Production Floor</div>
          </div>
          <div class="bg-[#0e131f] p-6 rounded-2xl border border-white/10 shadow-xl">
            <div class="text-3xl font-black text-gold-400 font-mono mb-1">100%</div>
            <div class="text-xs font-medium text-slate-400">Batch Spectro Inspection</div>
          </div>
        </div>
      </div>

      <!-- Right Column Stages Grid -->
      <div class="lg:col-span-7 grid grid-cols-1 sm:grid-cols-2 gap-6">
        {capabilities.map((cap) => (
          <div class="bg-[#0e131f] p-8 rounded-3xl relative group transition-all duration-500 hover:-translate-y-1.5 reveal-on-scroll border border-white/10 hover:border-gold-500/40 shadow-2xl flex flex-col justify-between space-y-4">
            <div class="flex items-center justify-between">
              <span class="text-xs font-black text-gold-400 bg-gold-500/10 px-3 py-1 rounded-lg border border-gold-500/25 font-mono">
                STAGE {cap.step}
              </span>
              <span class="text-[11px] font-bold text-slate-300 font-mono bg-[#07090e] px-3 py-1 rounded-lg border border-white/10">{cap.metric}</span>
            </div>

            <div>
              <h3 class="text-xl font-bold text-white mb-2 group-hover:text-gold-400 transition-colors">{cap.title}</h3>
              <p class="text-sm text-slate-300 leading-relaxed font-normal">{cap.desc}</p>
            </div>
          </div>
        ))}
      </div>

    </div>

  </div>
</section>
