---
const advantages = [
  {
    title: 'Zero Thermal Cracking',
    desc: 'High thermal shock resistance prevents cracking during rapid induction heating cycles.',
  },
  {
    title: 'Extremely Low Ash Content',
    desc: 'Purified carbon formulation (<0.1% ash) guarantees clean melt pools without slag inclusions.',
  },
  {
    title: 'Chemical Inertness',
    desc: 'Resistant to strong acids, molten aluminum, zinc alloys, and aggressive flexographic inks.',
  },
  {
    title: 'Self-Lubricating Surface',
    desc: 'Eliminates friction and dry-wear in high-pressure steam pump packing and valve stems.',
  },
  {
    title: 'Strict Quality Traceability',
    desc: 'Every shipment includes spectrographic test certificates and physical parameter logs.',
  },
  {
    title: 'Global Export Readiness',
    desc: 'Export-standard sea-worthy wooden pallet packaging for safe global transit.',
  },
];
---

<section class="py-24 bg-[#07090e] text-slate-100 border-b border-white/[0.06] relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <div class="text-center max-w-3xl mx-auto space-y-4 mb-16">
      <span class="theme-pill">
        Engineering Excellence
      </span>
      <h2 class="display-lg font-extrabold text-white tracking-tight" style="font-family:'Outfit',sans-serif;">The <span class="text-theme-gradient font-black">VM Graphite Advantage</span></h2>
      <p class="text-slate-400 text-base sm:text-lg leading-relaxed font-normal">
        Delivering consistent material purity, extended operational life, and reduced maintenance downtime for modern industrial operations.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {advantages.map((adv) => (
        <div class="glow-card p-7 rounded-2xl flex items-start gap-4 transition-colors border border-white/[0.08] hover:border-theme bg-[#0f1118]">
          <div class="w-10 h-10 rounded-xl bg-theme-tint text-theme-bright border border-theme flex items-center justify-center shrink-0 mt-0.5 shadow-md font-mono font-bold">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
          </div>
          <div>
            <h3 class="text-lg font-bold text-white mb-1.5" style="font-family:'Outfit',sans-serif;">{adv.title}</h3>
            <p class="text-xs sm:text-sm text-slate-400 leading-relaxed font-normal">{adv.desc}</p>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
