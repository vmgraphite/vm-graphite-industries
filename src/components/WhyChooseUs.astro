---
const advantages = [
  {
    title: 'Zero Thermal Cracking',
    desc: 'High thermal shock resistance prevents cracking during rapid induction heating cycles.',
  },
  {
    title: 'Extremely Low Ash Content',
    desc: 'Purified carbon formulation (<0.1% ash) guarantees clean melt pools without slag inclusions.',
  },
  {
    title: 'Chemical Inertness',
    desc: 'Resistant to strong acids, molten aluminum, zinc alloys, and aggressive flexographic inks.',
  },
  {
    title: 'Self-Lubricating Surface',
    desc: 'Eliminates friction and dry-wear in high-pressure steam pump packing and valve stems.',
  },
  {
    title: 'Strict Quality Traceability',
    desc: 'Every shipment includes spectrographic test certificates and physical parameter logs.',
  },
  {
    title: 'Global Export Readiness',
    desc: 'Export-standard sea-worthy wooden pallet packaging for safe global transit.',
  },
];
---

<section class="py-24 bg-[#080a10] text-slate-100 border-b border-gold-500/20 relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <div class="text-center max-w-3xl mx-auto space-y-4 mb-16 reveal-on-scroll">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-gold-500/15 text-gold-400 border border-gold-500/30 text-xs font-bold uppercase tracking-widest font-mono">
        Engineering Excellence
      </div>
      <h2 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight">The <span class="text-gold-gradient font-black">VM Graphite Advantage</span></h2>
      <p class="text-slate-300 text-base sm:text-lg leading-relaxed font-normal">
        Delivering consistent material purity, extended operational life, and reduced maintenance downtime for modern industrial operations.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {advantages.map((adv) => (
        <div class="glass-card-dark p-7 rounded-2xl flex items-start gap-4 transition-all duration-300 transform hover:-translate-y-1 reveal-on-scroll border border-gold-500/20 hover:border-gold-400">
          <div class="w-10 h-10 rounded-xl bg-gold-500/20 text-gold-400 border border-gold-500/40 flex items-center justify-center shrink-0 mt-0.5 shadow-md font-mono font-bold">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
          </div>
          <div>
            <h3 class="text-lg font-bold text-white mb-1.5">{adv.title}</h3>
            <p class="text-xs sm:text-sm text-slate-300 leading-relaxed font-normal">{adv.desc}</p>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
