---
import Layout from '../../layouts/Layout.astro';

export function getStaticPaths() {
  return [{ params: { index: undefined } }];
}
---

<Layout title="Sanity CMS Admin | VM Graphite Industries LLP">
  <div id="sanity-studio-root" class="min-h-screen bg-slate-950 text-white">
    <div class="p-8 text-center space-y-4 max-w-lg mx-auto pt-20">
      <div class="w-12 h-12 rounded-xl bg-industrial-copper/20 text-industrial-copper flex items-center justify-center mx-auto animate-pulse">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
      </div>
      <h1 class="text-2xl font-extrabold text-white">VM Graphite Content Studio</h1>
      <p class="text-xs text-slate-400 leading-relaxed">
        Initializing Sanity CMS Admin Interface. Connect your cloud credentials in <code class="text-industrial-copper">.env</code> to activate real-time editing.
      </p>
      
      <div class="pt-4 text-left bg-slate-900 border border-slate-800 p-4 rounded-xl text-xs space-y-2 font-mono text-slate-300">
        <div><strong class="text-white">Route:</strong> /admin</div>
        <div><strong class="text-white">Status:</strong> Ready for Sanity Cloud Sync</div>
        <div><strong class="text-white">CLI Command:</strong> <span class="text-amber-400">npx sanity@latest init</span></div>
      </div>
    </div>
  </div>

  <script>
    import { renderStudio } from 'sanity';
    import config from '../../../sanity.config';

    const rootElement = document.getElementById('sanity-studio-root');
    if (rootElement && import.meta.env.PUBLIC_SANITY_PROJECT_ID) {
      try {
        renderStudio(rootElement, config);
      } catch (err) {
        console.log('Sanity Studio initialization waiting for credentials:', err);
      }
    }
  </script>
</Layout>
