---
import '../../../styles/global.css';
import SanityStudioEmbed from '../../../components/admin/SanityStudioEmbed';

export function getStaticPaths() {
  const paths = [
    undefined,
    'structure',
    'structure/siteSettings',
    'structure/homePage',
    'structure/aboutPage',
    'structure/category',
    'structure/product',
    'structure/resource',
    'vision',
  ];
  return paths.map((index) => ({ params: { index } }));
}
---

<!DOCTYPE html>
<html lang="en" class="h-full bg-[#07090e]">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>Sanity Studio | VM Graphite Industries</title>
    <link rel="icon" type="image/png" href="/images/logo.png" />
    <link rel="icon" type="image/svg+xml" href="/images/logo.svg" />
    <link rel="apple-touch-icon" href="/images/logo.png" />
    <meta name="robots" content="noindex, nofollow" />
    
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&family=Outfit:wght@500;600;700;800&display=swap" rel="stylesheet" />
    <style>
      html, body {
        height: 100%;
        margin: 0;
        padding: 0;
        background-color: #07090e;
        overflow: hidden;
      }
    </style>
  </head>
  <body class="h-full bg-[#07090e] text-slate-100 font-sans antialiased overflow-hidden selection:bg-[#e8a020] selection:text-[#07090e]">
    <SanityStudioEmbed client:only="react" />
  </body>
</html>
