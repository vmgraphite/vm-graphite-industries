---
import SanityStudioEmbed from '../../../components/admin/SanityStudioEmbed';

export function getStaticPaths() {
  const paths = [
    undefined,
    'structure',
    'structure/siteSettings',
    'structure/homePage',
    'structure/aboutPage',
    'structure/category',
    'structure/product',
    'structure/resource',
    'vision',
  ];
  return paths.map((index) => ({ params: { index } }));
}
---

<!DOCTYPE html>
<html lang="en" style="height: 100%; margin: 0; padding: 0;">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>Sanity Studio | VM Graphite Industries</title>
    <link rel="icon" type="image/svg+xml" href="/images/logo.svg" />
    <meta name="robots" content="noindex, nofollow" />
    <style>
      html, body {
        height: 100%;
        margin: 0;
        padding: 0;
        background-color: #07090e;
        overflow: hidden;
      }
    </style>
  </head>
  <body>
    <SanityStudioEmbed client:only="react" />
  </body>
</html>
