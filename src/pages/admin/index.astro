---
import AdminLayout from '../../layouts/AdminLayout.astro';
import AdminDashboard from '../../components/admin/AdminDashboard';

const projectId = import.meta.env.PUBLIC_SANITY_PROJECT_ID || 'twycammz';
const dataset = import.meta.env.PUBLIC_SANITY_DATASET || 'production';
const contactEmail = import.meta.env.CONTACT_EMAIL || 'kanikaagrawal1997@gmail.com';
---

<AdminLayout title="VM Graphite Admin Portal & Studio">
  <AdminDashboard
    client:only="react"
    projectId={projectId}
    dataset={dataset}
    contactEmail={contactEmail}
  />
</AdminLayout>
