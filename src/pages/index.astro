---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import FeaturedCategories from '../components/FeaturedCategories.astro';
import WhatWeHaveDiamond from '../components/WhatWeHaveDiamond.astro';
import Capabilities from '../components/Capabilities.astro';
import CompanyStrengths from '../components/CompanyStrengths.astro';
import BrochureCTA from '../components/BrochureCTA.astro';

import {
  getSiteSettings,
  getCategories,
  getHomePageContent,
} from '../lib/data';

const siteSettings = await getSiteSettings();
const categories = await getCategories();
const homeContent = await getHomePageContent();
---

<Layout
  title="VM Graphite Industries LLP | Advanced Industrial Graphite Solutions"
  description="Premier manufacturer of high-purity industrial graphite crucibles, colloidal graphite suspensions, sealing foil tapes, and doctor blades in India."
>

  <!-- ① Hero Section -->
  <Hero
    headline={homeContent?.heroHeadline}
    subheadline={homeContent?.heroSubheadline}
    heroImage={homeContent?.heroImageUrl || '/images/hero-industrial.jpg'}
    primaryCtaText={homeContent?.primaryCtaText}
    secondaryCtaText={homeContent?.secondaryCtaText}
  />

  <!-- ② Interactive Metrics Bar with Live Animated Counters -->
  <div class="bg-[#0b0e15] border-t border-b border-white/10 relative z-20 shadow-md">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 lg:grid-cols-4 divide-y sm:divide-y-0 sm:divide-x divide-white/10">
        {[
          { metric: '99.9', suffix: '%', decimals: 1, label: 'Carbon Purity', color: 'text-theme-bright', sub: 'Ultra-pure synthetic grades' },
          { metric: '3000', suffix: '°C', decimals: 0, label: 'Max Thermal Rating', color: 'text-white', sub: 'Extreme heat resistance' },
          { metric: '20', suffix: '+', decimals: 0, label: 'Countries Served', color: 'text-theme-light', sub: 'Worldwide export network' },
          { metric: '100', suffix: '%', decimals: 0, label: 'ISO 9001:2015', color: 'text-emerald-400', sub: 'Zero defect inspection' },
        ].map((item, idx) => (
          <div class={`py-6 px-6 text-center hover:bg-white/[0.02] transition-colors reveal-on-scroll stagger-${idx + 1}`}>
            <div
              class={`text-3xl lg:text-4xl font-black font-mono tracking-tight ${item.color}`}
              data-counter-target={item.metric}
              data-counter-decimals={item.decimals}
              data-counter-suffix={item.suffix}
            >
              {item.metric}{item.suffix}
            </div>
            <div class="text-xs text-slate-200 mt-1.5 font-bold uppercase tracking-wider font-mono">{item.label}</div>
            <div class="text-[11px] text-slate-400 mt-0.5 font-normal">{item.sub}</div>
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- ③ Product Divisions (Featured Categories) -->
  <FeaturedCategories categories={categories} />

  <!-- ④ Flagship Products Bento Showcase (What We Have) -->
  <WhatWeHaveDiamond />

  <!-- ⑤ State-of-the-Art Plant Capabilities & Infrastructure Pipeline -->
  <Capabilities
    headline={homeContent?.capabilitiesHeadline}
    description={homeContent?.capabilitiesDescription}
  />

  <!-- ⑥ Why Industrial Leaders Choose VM Graphite (Strengths & Alubonding) -->
  <CompanyStrengths
    headline={homeContent?.whyChooseUsHeadline || homeContent?.strengthsHeadline}
  />

  <!-- ⑦ High-Conversion Official Technical Brochure & Custom Orders CTA -->
  <BrochureCTA brochureUrl={siteSettings.companyBrochureUrl} />

</Layout>
