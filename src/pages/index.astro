---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import WhatWeHaveDiamond from '../components/WhatWeHaveDiamond.astro';
import CompanyStrengths from '../components/CompanyStrengths.astro';
import FeaturedCategories from '../components/FeaturedCategories.astro';
import Capabilities from '../components/Capabilities.astro';
import FeaturedProducts from '../components/FeaturedProducts.astro';
import BrochureCTA from '../components/BrochureCTA.astro';

import {
  getSiteSettings,
  getCategories,
  getFeaturedProducts,
  getHomePageContent,
} from '../lib/data';

const siteSettings = await getSiteSettings();
const categories = await getCategories();
const featuredProducts = await getFeaturedProducts();
const homeContent = await getHomePageContent();
---

<Layout
  title="VM Graphite Industries LLP | Advanced Industrial Graphite Solutions"
  description="Premier manufacturer of industrial graphite crucibles, colloidal graphite suspensions, sealing foil tapes, and doctor blades in India. Iso-pressed quality, high thermal stability."
>
  <!-- Hero Section -->
  <Hero
    headline={homeContent?.heroHeadline}
    subheadline={homeContent?.heroSubheadline}
    heroImage={homeContent?.heroImageUrl || '/images/hero-industrial.jpg'}
    primaryCtaText={homeContent?.primaryCtaText}
    secondaryCtaText={homeContent?.secondaryCtaText}
  />

  <!-- Specialized Material Divisions -->
  <FeaturedCategories categories={categories} />

  <!-- Product Portfolio Showcase -->
  <WhatWeHaveDiamond />

  <!-- Manufacturing Capabilities & Infrastructure -->
  <Capabilities />

  <!-- B2B Manufacturing Advantage & Strengths -->
  <CompanyStrengths />

  <!-- Featured Industrial Products Grid -->
  <FeaturedProducts products={featuredProducts} />

  <!-- Technical Brochure & Catalog Download Banner -->
  <BrochureCTA brochureUrl={siteSettings.companyBrochureUrl} />

  <!-- Final Custom Engineering Lead Banner -->
  <section class="py-28 lg:py-36 bg-[#07090e] text-white border-t border-white/5 relative overflow-hidden">
    <!-- Ambient Soft Radial Glow -->
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,rgba(212,175,55,0.08),transparent_70%)] pointer-events-none"></div>

    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-8 relative z-10 reveal-on-scroll">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-gold-500/10 text-gold-400 border border-gold-500/25 text-xs font-bold uppercase tracking-widest font-mono">
        Custom Material Engineering
      </div>
      
      <h2 class="text-3xl sm:text-5xl lg:text-6xl font-black text-white tracking-tight leading-tight">
        Looking for a Specific Industrial Material or Custom Dimension?
      </h2>
      
      <p class="text-slate-300 text-base sm:text-xl max-w-3xl mx-auto leading-relaxed font-normal">
        Our metallurgists and engineering team specialize in custom grain sizes, specialized liquid formulations, and high-precision CNC turned graphite parts.
      </p>

      <div class="pt-4 flex flex-col sm:flex-row items-center justify-center gap-4">
        <button
          type="button"
          data-open-quote-modal
          class="w-full sm:w-auto px-9 py-4 bg-gradient-to-r from-amber-400 via-gold-400 to-amber-500 hover:from-amber-300 hover:to-amber-400 text-slate-950 font-black rounded-xl border border-amber-200/80 shadow-[0_4px_25px_rgba(245,158,11,0.4)] flex items-center justify-center gap-2 transition-all transform hover:-translate-y-0.5 active:translate-y-0 text-base cursor-pointer uppercase tracking-wider font-sans"
        >
          <svg class="w-5 h-5 text-slate-950" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
          <span>Request Custom Quotation</span>
        </button>

        <a
          href="/contact"
          class="w-full sm:w-auto px-8 py-4 bg-[#141b2d] hover:bg-[#1e293b] text-slate-200 hover:text-white font-bold rounded-xl border border-white/10 transition-colors text-base"
        >
          Contact Technical Sales
        </a>
      </div>
    </div>
  </section>
</Layout>
