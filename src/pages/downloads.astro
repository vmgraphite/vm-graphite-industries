---
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import DownloadCard from '../components/DownloadCard.astro';
import { getResources } from '../lib/data';

const resources = await getResources();
const selectedCategory = Astro.url.searchParams.get('category') || 'all';

const filteredResources = resources.filter((res) => {
  if (selectedCategory === 'all') return true;
  return res.category === selectedCategory;
});
---

<Layout
  title="Downloads & Technical Resources | VM Graphite Industries LLP"
  description="Download official VM Graphite corporate brochures, product catalogs, engineering technical datasheets, and ISO 9001 quality certificates."
  breadcrumbs={[{ name: 'Downloads', item: '/downloads' }]}
>
  <!-- Page Header -->
  <section class="bg-[#07090e] text-white py-16 industrial-grid-bg border-b border-white/10 relative overflow-hidden">
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[800px] h-[400px] bg-[radial-gradient(ellipse_at_top,rgba(232,160,32,0.12),transparent_65%)] pointer-events-none"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <Breadcrumbs items={[{ name: 'Downloads', href: '/downloads' }]} />

      <div class="max-w-3xl space-y-3 pt-6 reveal-on-scroll">
        <span class="amber-pill">Technical Documentation</span>
        <h1 class="display-lg text-white font-black tracking-tight" style="font-family:'Outfit',sans-serif;">
          Downloads &amp; <span class="text-gold-gradient">Resource Hub</span>
        </h1>
        <p class="text-slate-300 text-sm sm:text-base leading-relaxed font-normal">
          Access official PDF datasheets, product catalogs, engineering guidelines, and ISO 9001 quality certificates.
        </p>
      </div>

      <!-- Category Filter Tabs -->
      <div class="mt-10 pt-6 border-t border-white/10 flex flex-wrap items-center gap-2">
        {[
          { id: 'all', label: `All Resources (${resources.length})` },
          { id: 'catalog', label: 'Catalogs' },
          { id: 'brochure', label: 'Brochures' },
          { id: 'datasheet', label: 'Technical Datasheets' },
          { id: 'certification', label: 'Certifications' },
        ].map((tab) => {
          const isActive = selectedCategory === tab.id;
          return (
            <a
              href={`/downloads?category=${tab.id}`}
              class={`px-4 py-2 rounded-xl text-xs font-bold transition-all ${
                isActive
                  ? 'bg-gradient-to-r from-amber-400 via-amber-500 to-amber-600 text-slate-950 font-black border border-amber-300/80 shadow-md'
                  : 'bg-[#0d1017] text-slate-300 hover:bg-[#141923] border border-white/10'
              }`}
            >
              {tab.label}
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <!-- Download Grid Content -->
  <section class="py-16 bg-[#07090e] min-h-[500px]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
        {filteredResources.map((res) => (
          <DownloadCard resource={res} />
        ))}
      </div>
    </div>
  </section>
</Layout>
