---
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import BrochureCTA from '../components/BrochureCTA.astro';
import { getSiteSettings, getAboutPageContent } from '../lib/data';

const siteSettings = await getSiteSettings();
const aboutContent = await getAboutPageContent();
---

<Layout
  title="About Us | VM Graphite Industries LLP"
  description="Learn about VM Graphite Industries LLP - premier manufacturer of synthetic and natural graphite materials, crucibles, suspensions, and doctor blades in India."
  breadcrumbs={[
    { name: 'About Us', item: '/about' }
  ]}
>
  <!-- Page Header Banner -->
  <section class="bg-slate-950 text-white py-16 industrial-grid-bg border-b border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <Breadcrumbs items={[{ name: 'About Us', href: '/about' }]} />

      <div class="max-w-3xl space-y-4 pt-4">
        <span class="inline-block px-3 py-1 bg-industrial-copper/20 text-industrial-copper border border-industrial-copper/30 rounded-full text-xs font-bold uppercase tracking-wider">
          Company Profile &amp; Infrastructure
        </span>
        <h1 class="text-4xl sm:text-5xl font-black text-white tracking-tight">
          {aboutContent?.title || 'About VM Graphite Industries LLP'}
        </h1>
        <p class="text-lg text-slate-300">
          {aboutContent?.subtitle || 'Engineering High-Performance Industrial Materials & Sealing Solutions Since Inception'}
        </p>
      </div>
    </div>
  </section>

  <!-- Company Overview Section -->
  <section class="py-20 bg-white text-slate-900 border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        
        <!-- Left Image Card -->
        <div class="lg:col-span-6">
          <div class="relative rounded-2xl overflow-hidden shadow-industrial border border-slate-200 bg-slate-900">
            <img
              src="/images/facility-plant.jpg"
              alt="VM Graphite Industrial Plant Infrastructure"
              class="w-full h-auto object-cover"
            />
            <div class="p-6 bg-slate-950 text-white flex justify-between items-center">
              <div>
                <div class="text-xs font-bold text-industrial-copper uppercase">Manufacturing Hub</div>
                <div class="text-sm font-semibold">New Delhi &amp; Gujarat Units</div>
              </div>
              <div class="text-right font-mono text-xs text-slate-400">
                ISO 9001:2015 CERTIFIED
              </div>
            </div>
          </div>
        </div>

        <!-- Right Overview Content -->
        <div class="lg:col-span-6 space-y-6">
          <h2 class="text-xs font-bold text-industrial-copper uppercase tracking-widest">Who We Are</h2>
          <h3 class="text-3xl font-extrabold text-slate-900 leading-tight">
            Pioneering Material Science &amp; Technical Manufacturing Excellence
          </h3>

          <div class="prose text-slate-600 text-sm leading-relaxed space-y-4">
            <p>
              <strong>VM Graphite Industries LLP</strong> is an established industrial manufacturer specializing in synthetic and natural graphite materials, colloidal liquid suspensions, flexible graphite foil sealing products, and high-performance flexographic metering doctor blades.
            </p>
            <p>
              Headquartered with corporate operations in New Delhi and state-of-the-art manufacturing facilities in Gujarat, we serve Foundries, Steel Plants, Printing &amp; Packaging lines, Glass Manufacturers, and Chemical Processing facilities globally.
            </p>
            <p>
              Our engineering philosophy combines rigid material selection, high-density isostatic pressing, precision CNC machining, and automated chemical liquid compounding to ensure zero thermal cracking and maximum operational endurance.
            </p>
          </div>

          <!-- Key Metrics Badges -->
          <div class="grid grid-cols-3 gap-4 pt-4 border-t border-slate-200">
            <div>
              <div class="text-2xl font-black text-slate-900">99.9%</div>
              <div class="text-xs font-medium text-slate-500">Carbon Purity Grade</div>
            </div>
            <div>
              <div class="text-2xl font-black text-industrial-copper">3000°C</div>
              <div class="text-xs font-medium text-slate-500">Max Temp Limit</div>
            </div>
            <div>
              <div class="text-2xl font-black text-slate-900">20+</div>
              <div class="text-xs font-medium text-slate-500">Export Countries</div>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Quality Commitment & Facility Pillars -->
  <section class="py-20 bg-slate-900 text-white border-b border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-3xl mx-auto space-y-4 mb-16">
        <h2 class="text-xs font-bold text-industrial-copper uppercase tracking-widest">Quality Assurance</h2>
        <h3 class="text-3xl font-extrabold text-white">Rigorous Quality &amp; Production Standards</h3>
        <p class="text-slate-400 text-sm">
          Every production lot undergoes rigorous physical, thermal, and chemical laboratory testing before dispatch.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        
        <div class="bg-slate-950 border border-slate-800 p-8 rounded-2xl space-y-4">
          <div class="w-12 h-12 bg-industrial-copper/20 text-industrial-copper rounded-xl flex items-center justify-center">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          </div>
          <h4 class="text-xl font-bold text-white">Material Purity Testing</h4>
          <p class="text-xs text-slate-400 leading-relaxed">
            Spectrographic analysis ensures carbon purity standards exceeding 99.5%, guaranteeing zero slag contamination in foundry melt crucibles.
          </p>
        </div>

        <div class="bg-slate-950 border border-slate-800 p-8 rounded-2xl space-y-4">
          <div class="w-12 h-12 bg-sky-500/20 text-sky-400 rounded-xl flex items-center justify-center">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L5.6 15.13a2 2 0 00-1.022.547l-1.07 1.07a2 2 0 000 2.828l1.07 1.07a2 2 0 002.828 0l1.07-1.07a2 2 0 00.547-1.022l.477-2.387a6 6 0 00-.517-3.86l-.158-.318a6 6 0 01-.517-3.86l.477-2.387a2 2 0 00-.547-1.022l-1.07-1.07a2 2 0 00-2.828 0l-1.07 1.07a2 2 0 000 2.828l1.07 1.07z"/></svg>
          </div>
          <h4 class="text-xl font-bold text-white">Dimensional Precision</h4>
          <p class="text-xs text-slate-400 leading-relaxed">
            State-of-the-art CNC lathes and mills achieve micro-tolerances down to ±0.02mm for seamless integration in custom machinery.
          </p>
        </div>

        <div class="bg-slate-950 border border-slate-800 p-8 rounded-2xl space-y-4">
          <div class="w-12 h-12 bg-emerald-500/20 text-emerald-400 rounded-xl flex items-center justify-center">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/></svg>
          </div>
          <h4 class="text-xl font-bold text-white">Export Seaworthy Packing</h4>
          <p class="text-xs text-slate-400 leading-relaxed">
            All shipments are vacuum-sealed, moisture protected, and strapped onto export-certified wooden pallets for safe long-distance freight.
          </p>
        </div>

      </div>
    </div>
  </section>

  <!-- Brochure CTA -->
  <BrochureCTA brochureUrl={siteSettings.companyBrochureUrl} />
</Layout>
