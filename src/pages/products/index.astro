---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ProductCard from '../../components/ProductCard.astro';
import EmptyState from '../../components/EmptyState.astro';
import { getCategories, getAllProducts } from '../../lib/data';

const categories = await getCategories();
const allProducts = await getAllProducts();

const selectedCategory = Astro.url.searchParams.get('category') || 'all';
const searchQuery = Astro.url.searchParams.get('search')?.toLowerCase() || '';
---

<Layout
  title="Industrial Product Catalog | VM Graphite Industries LLP"
  description="Browse VM Graphite complete catalog of graphite crucibles, suspensions, expanded foil tapes, end seals, and metering doctor blades."
  breadcrumbs={[
    { name: 'Products Catalog', item: '/products' }
  ]}
>
  <!-- Page Header -->
  <section class="bg-[#07090e] text-white py-14 sm:py-16 industrial-grid-bg border-b border-white/10 relative overflow-hidden">
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[800px] h-[400px] bg-[radial-gradient(ellipse_at_top,var(--primary-glow-subtle),transparent_65%)] pointer-events-none"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <Breadcrumbs items={[{ name: 'Products Catalog', href: '/products' }]} />

      <div class="max-w-3xl space-y-3 pt-6" data-reveal="fade-up">
        <span class="theme-pill">Industrial Product Catalog</span>
        <h1 class="display-lg text-white font-black tracking-tight" style="font-family:'Outfit',sans-serif;">
          Precision-Manufactured <span class="text-theme-gradient">Solutions</span>
        </h1>
        <p class="text-slate-300 text-xs sm:text-sm leading-relaxed font-normal">
          Explore our complete range of high-purity industrial graphite, thermal coating suspensions, sealing products, and doctor blades.
        </p>
      </div>

      <!-- Search & Filter Controls Bar -->
      <div class="mt-8 pt-6 border-t border-white/10 flex flex-col md:flex-row items-stretch md:items-center justify-between gap-4" data-reveal="fade-up" data-reveal-delay="150">
        
        <!-- Category Filter Tabs -->
        <div id="category-tabs-container" class="flex flex-wrap items-center gap-2">
          <a
            href="/products?category=all"
            data-category-filter="all"
            class="category-tab-btn px-3.5 py-1.5 rounded-xl text-xs font-bold transition-all cursor-pointer bg-gradient-to-r from-[var(--primary-light)] via-[var(--primary)] to-[var(--primary-dark)] text-slate-950 font-black border border-white/40 shadow-md"
          >
            All Products ({allProducts.length})
          </a>
          {categories.map((cat) => {
            const count = allProducts.filter((p) => p.categorySlug === cat.slug).length;
            return (
              <a
                href={`/products?category=${cat.slug}`}
                data-category-filter={cat.slug}
                class="category-tab-btn px-3.5 py-1.5 rounded-xl text-xs font-bold transition-all cursor-pointer bg-[#0d1117] text-slate-300 hover:bg-[#141923] border border-white/10"
              >
                {cat.name} ({count})
              </a>
            );
          })}
        </div>

        <!-- Search Input -->
        <form id="product-search-form" method="GET" action="/products" class="relative max-w-xs w-full">
          <input
            id="product-search-input"
            type="text"
            name="search"
            value={searchQuery}
            placeholder="Search products & specs..."
            autocomplete="off"
            class="w-full bg-[#0d1117] border border-white/10 hover:border-theme rounded-xl pl-9 pr-4 py-2 text-xs text-white placeholder-slate-400 focus:outline-none focus:border-[var(--primary)] transition-colors"
          />
          <svg class="w-4 h-4 text-theme-bright absolute left-3 top-2.5 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
        </form>

      </div>
    </div>
  </section>

  <!-- Product Grid Content -->
  <section id="products-section" class="py-12 sm:py-16 bg-[#07090e] min-h-[550px] scroll-mt-10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-10">
      
      <!-- Top Results Bar -->
      <div class="flex items-center justify-between text-xs font-mono text-slate-400 border-b border-white/[0.06] pb-3">
        <span id="results-count-text">Showing all products</span>
        <span class="text-[11px] text-slate-500">6 items per page</span>
      </div>

      <div id="products-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8 items-stretch">
        {allProducts.map((product) => (
          <div
            class="product-card-wrapper h-full flex flex-col"
            data-category={product.categorySlug}
            data-name={product.name.toLowerCase()}
            data-desc={product.shortDescription.toLowerCase()}
            data-catname={product.categoryName.toLowerCase()}
            data-specs={product.specifications ? product.specifications.map(s => `${s.name} ${s.value}`).join(' ').toLowerCase() : ''}
          >
            <ProductCard product={product} />
          </div>
        ))}
      </div>

      <!-- Interactive Empty State -->
      <div id="products-empty-state" class="hidden">
        <EmptyState
          title="No Matching Industrial Products"
          message="No products match your selected category and search criteria. Reset your search or contact our technical team for custom formulations."
          actionText="Clear All Filters"
          actionUrl="/products"
          actionId="clear-filters-btn"
        />
      </div>

      <!-- Pagination Navigation Controls -->
      <div id="pagination-wrapper" class="pt-8 border-t border-white/[0.08] flex flex-col sm:flex-row items-center justify-between gap-4">
        
        <div class="text-xs font-mono text-slate-400" id="pagination-info">
          Page 1 of 1
        </div>

        <div id="pagination-controls" class="flex items-center gap-2">
          <!-- Prev Button -->
          <button
            type="button"
            id="pagination-prev-btn"
            class="px-3.5 py-2 rounded-xl bg-white/[0.03] border border-white/10 hover:border-theme text-xs font-semibold text-slate-300 hover:text-white transition-all disabled:opacity-30 disabled:cursor-not-allowed disabled:hover:border-white/10 flex items-center gap-1.5 cursor-pointer"
          >
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7"/></svg>
            <span>Prev</span>
          </button>

          <!-- Page Numbers Container -->
          <div id="pagination-pages-container" class="flex items-center gap-1.5">
            <!-- Dynamically populated page buttons -->
          </div>

          <!-- Next Button -->
          <button
            type="button"
            id="pagination-next-btn"
            class="px-3.5 py-2 rounded-xl bg-white/[0.03] border border-white/10 hover:border-theme text-xs font-semibold text-slate-300 hover:text-white transition-all disabled:opacity-30 disabled:cursor-not-allowed disabled:hover:border-white/10 flex items-center gap-1.5 cursor-pointer"
          >
            <span>Next</span>
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/></svg>
          </button>
        </div>

      </div>

    </div>
  </section>
</Layout>

<script>
  const ITEMS_PER_PAGE = 6;

  function setupProductFiltersAndPagination() {
    const searchInput = document.getElementById('product-search-input') as HTMLInputElement | null;
    const searchForm = document.getElementById('product-search-form') as HTMLFormElement | null;
    const tabButtons = document.querySelectorAll<HTMLElement>('.category-tab-btn');
    const productItems = Array.from(document.querySelectorAll<HTMLElement>('.product-card-wrapper'));
    const emptyState = document.getElementById('products-empty-state');
    const clearFiltersBtn = document.getElementById('clear-filters-btn');
    const productsGrid = document.getElementById('products-grid');
    const paginationWrapper = document.getElementById('pagination-wrapper');
    const paginationInfo = document.getElementById('pagination-info');
    const paginationPagesContainer = document.getElementById('pagination-pages-container');
    const prevBtn = document.getElementById('pagination-prev-btn') as HTMLButtonElement | null;
    const nextBtn = document.getElementById('pagination-next-btn') as HTMLButtonElement | null;
    const resultsCountText = document.getElementById('results-count-text');

    if (!tabButtons.length || !productItems.length) return;

    const activeClasses = ['bg-gradient-to-r', 'from-[var(--primary-light)]', 'via-[var(--primary)]', 'to-[var(--primary-dark)]', 'text-slate-950', 'font-black', 'border-white/40', 'shadow-md'];
    const inactiveClasses = ['bg-[#0d1117]', 'text-slate-300', 'hover:bg-[#141923]', 'border-white/10'];

    let currentPage = 1;
    let cardObserver: IntersectionObserver | null = null;

    function observeCards(visibleCards: HTMLElement[]) {
      if (cardObserver) {
        cardObserver.disconnect();
      }

      cardObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              const el = entry.target as HTMLElement;
              el.classList.add('card-popped-in');
              cardObserver?.unobserve(el);
            }
          });
        },
        {
          root: null,
          rootMargin: '0px 0px -40px 0px',
          threshold: 0.1,
        }
      );

      visibleCards.forEach((item, index) => {
        item.classList.remove('card-popped-in');
        // Stagger within the same row (3 columns)
        item.style.transitionDelay = `${(index % 3) * 0.1}s`;
        cardObserver?.observe(item);
      });
    }

    function getParams() {
      const params = new URLSearchParams(window.location.search);
      return {
        category: params.get('category') || 'all',
        search: params.get('search') || '',
        page: parseInt(params.get('page') || '1', 10) || 1,
      };
    }

    function updateUrl(category: string, search: string, page: number) {
      const url = new URL(window.location.href);
      if (category && category !== 'all') {
        url.searchParams.set('category', category);
      } else {
        url.searchParams.delete('category');
      }
      if (search && search.trim()) {
        url.searchParams.set('search', search.trim());
      } else {
        url.searchParams.delete('search');
      }
      if (page > 1) {
        url.searchParams.set('page', String(page));
      } else {
        url.searchParams.delete('page');
      }
      window.history.replaceState({}, '', url.toString());
    }

    function renderView(category: string, search: string, targetPage: number, updateHistory = true, shouldScroll = false) {
      const normalizedSearch = search.toLowerCase().trim();
      
      // 1. Filter matching items
      const matchingItems = productItems.filter((item) => {
        const itemCat = item.getAttribute('data-category');
        const itemName = item.getAttribute('data-name') || '';
        const itemDesc = item.getAttribute('data-desc') || '';
        const itemCatName = item.getAttribute('data-catname') || '';
        const itemSpecs = item.getAttribute('data-specs') || '';

        const matchesCat = category === 'all' || itemCat === category;
        const matchesSearch =
          !normalizedSearch ||
          itemName.includes(normalizedSearch) ||
          itemDesc.includes(normalizedSearch) ||
          itemCatName.includes(normalizedSearch) ||
          itemSpecs.includes(normalizedSearch);

        return matchesCat && matchesSearch;
      });

      const totalMatches = matchingItems.length;
      const totalPages = Math.max(1, Math.ceil(totalMatches / ITEMS_PER_PAGE));
      currentPage = Math.min(Math.max(1, targetPage), totalPages);

      // 2. Update Tab Styles
      tabButtons.forEach((btn) => {
        const btnCategory = btn.getAttribute('data-category-filter');
        const isActive = btnCategory === category;
        if (isActive) {
          btn.classList.add(...activeClasses);
          btn.classList.remove(...inactiveClasses);
        } else {
          btn.classList.remove(...activeClasses);
          btn.classList.add(...inactiveClasses);
        }
      });

      // 3. Paginate visible items with individual scroll observer
      const startIndex = (currentPage - 1) * ITEMS_PER_PAGE;
      const endIndex = startIndex + ITEMS_PER_PAGE;
      const currentlyVisible: HTMLElement[] = [];

      productItems.forEach((item) => {
        item.style.display = 'none';
        item.classList.remove('card-popped-in');
      });

      matchingItems.forEach((item, index) => {
        if (index >= startIndex && index < endIndex) {
          item.style.display = '';
          currentlyVisible.push(item);
        }
      });

      // Observe the visible page items for individual scroll-in trigger
      observeCards(currentlyVisible);

      // 4. Update Header Count Text
      if (resultsCountText) {
        if (totalMatches === 0) {
          resultsCountText.textContent = 'No products found';
        } else {
          const first = startIndex + 1;
          const last = Math.min(endIndex, totalMatches);
          resultsCountText.textContent = `Showing ${first}–${last} of ${totalMatches} products`;
        }
      }

      // 5. Update Empty State vs Grid
      if (emptyState && productsGrid && paginationWrapper) {
        if (totalMatches === 0) {
          emptyState.classList.remove('hidden');
          productsGrid.classList.add('hidden');
          paginationWrapper.classList.add('hidden');
        } else {
          emptyState.classList.add('hidden');
          productsGrid.classList.remove('hidden');
          paginationWrapper.classList.remove('hidden');
        }
      }

      // 6. Render Pagination Controls
      if (paginationInfo) {
        paginationInfo.textContent = `Page ${currentPage} of ${totalPages} (${totalMatches} items)`;
      }

      if (prevBtn) prevBtn.disabled = currentPage <= 1;
      if (nextBtn) nextBtn.disabled = currentPage >= totalPages;

      if (paginationPagesContainer) {
        paginationPagesContainer.innerHTML = '';

        for (let i = 1; i <= totalPages; i++) {
          const pageBtn = document.createElement('button');
          pageBtn.type = 'button';
          pageBtn.textContent = String(i);
          pageBtn.className =
            i === currentPage
              ? 'w-8 h-8 rounded-lg bg-[var(--primary)] text-slate-950 font-black text-xs shadow-md cursor-default'
              : 'w-8 h-8 rounded-lg bg-white/[0.04] hover:bg-white/[0.08] text-slate-300 hover:text-white border border-white/10 text-xs font-semibold cursor-pointer transition-colors';

          pageBtn.addEventListener('click', () => {
            if (i !== currentPage) {
              renderView(category, search, i, true, true);
            }
          });

          paginationPagesContainer.appendChild(pageBtn);
        }
      }

      // 7. Scroll smoothly to top of products section if requested
      if (shouldScroll) {
        const section = document.getElementById('products-section');
        if (section) {
          section.scrollIntoView({ behavior: 'smooth' });
        }
      }

      if (updateHistory) {
        updateUrl(category, search, currentPage);
      }
    }

    // Initialize from URL
    const initialParams = getParams();
    if (searchInput && initialParams.search) {
      searchInput.value = initialParams.search;
    }
    renderView(initialParams.category, initialParams.search, initialParams.page, false, false);

    // Prev / Next button listeners
    if (prevBtn) {
      prevBtn.addEventListener('click', () => {
        if (currentPage > 1) {
          const params = getParams();
          renderView(params.category, params.search, currentPage - 1, true, true);
        }
      });
    }

    if (nextBtn) {
      nextBtn.addEventListener('click', () => {
        const params = getParams();
        renderView(params.category, params.search, currentPage + 1, true, true);
      });
    }

    // Category Tabs click handlers
    tabButtons.forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        const targetCategory = btn.getAttribute('data-category-filter') || 'all';
        const currentSearch = searchInput ? searchInput.value : '';
        renderView(targetCategory, currentSearch, 1, true, false);
      });
    });

    // Search Input handler
    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        const query = (e.target as HTMLInputElement).value;
        const currentCategory = document.querySelector('.category-tab-btn.font-black')?.getAttribute('data-category-filter') || 'all';
        renderView(currentCategory, query, 1, true, false);
      });
    }

    if (searchForm) {
      searchForm.addEventListener('submit', (e) => {
        e.preventDefault();
      });
    }

    // Clear filters button handler
    if (clearFiltersBtn) {
      clearFiltersBtn.addEventListener('click', (e) => {
        e.preventDefault();
        if (searchInput) searchInput.value = '';
        renderView('all', '', 1, true, false);
      });
    }

    // Browser back/forward
    window.addEventListener('popstate', () => {
      const state = getParams();
      renderView(state.category, state.search, state.page, false, false);
    });
  }

  setupProductFiltersAndPagination();
  document.addEventListener('astro:page-load', setupProductFiltersAndPagination);
</script>
