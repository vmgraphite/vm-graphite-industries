---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ProductSpecs from '../../components/ProductSpecs.astro';
import BrochureCTA from '../../components/BrochureCTA.astro';

import { getProductBySlug, getAllProducts } from '../../lib/data';

export async function getStaticPaths() {
  const products = await getAllProducts();
  return products.map((product) => ({
    params: { slug: product.slug },
  }));
}

const { slug } = Astro.params;
const product = await getProductBySlug(slug as string);

if (!product) {
  return Astro.redirect('/404');
}

const breadcrumbItems = [
  { name: 'Products Catalog', href: '/products' },
  { name: product.categoryName, href: `/products?category=${product.categorySlug}` },
  { name: product.name },
];

function renderProductDescription(desc: any) {
  if (!desc) return '';
  if (typeof desc === 'string') return desc;
  if (Array.isArray(desc)) {
    return desc
      .map((block) => (block.children ? block.children.map((c: any) => c.text).join('') : ''))
      .filter(Boolean)
      .join('\n\n');
  }
  return String(desc);
}
---

<Layout
  title={product.seoTitle || `${product.name} | VM Graphite Industries`}
  description={product.seoDescription || product.shortDescription}
  image={product.mainImage}
  type="product"
  productData={{
    name: product.name,
    description: product.shortDescription,
    image: product.mainImage,
    category: product.categoryName,
  }}
  breadcrumbs={breadcrumbItems.map((b) => ({ name: b.name, item: b.href || Astro.url.href }))}
>
  <!-- Detail Header Banner -->
  <section class="bg-[#07090e] text-white py-14 industrial-grid-bg border-b border-white/10 relative overflow-hidden">
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[800px] h-[400px] bg-[radial-gradient(ellipse_at_top,rgba(232,160,32,0.12),transparent_65%)] pointer-events-none"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <Breadcrumbs items={breadcrumbItems} />

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start pt-6">
        
        <!-- Left Product Images Gallery (5 cols) -->
        <div class="lg:col-span-5 space-y-4">
          <div class="rounded-2xl overflow-hidden border border-white/10 bg-[#0d1017] aspect-4/3 shadow-2xl glow-card">
            <img
              id="main-product-img"
              src={product.mainImage}
              alt={product.name}
              class="w-full h-full object-cover opacity-95"
            />
          </div>

          {product.gallery && product.gallery.length > 0 && (
            <div class="flex items-center gap-3 overflow-x-auto pb-2">
              <button
                type="button"
                class="w-20 h-16 rounded-xl overflow-hidden border-2 border-[var(--primary)] shrink-0 focus:outline-none cursor-pointer"
                onclick={`document.getElementById('main-product-img').src='${product.mainImage}'`}
              >
                <img src={product.mainImage} alt={product.name} class="w-full h-full object-cover" />
              </button>
              {product.gallery.map((imgUrl) => (
                <button
                  type="button"
                  class="w-20 h-16 rounded-xl overflow-hidden border border-white/10 hover:border-[var(--primary)] shrink-0 focus:outline-none cursor-pointer transition-colors"
                  onclick={`document.getElementById('main-product-img').src='${imgUrl}'`}
                >
                  <img src={imgUrl} alt={`${product.name} gallery image`} class="w-full h-full object-cover" />
                </button>
              ))}
            </div>
          )}
        </div>

        <!-- Right Product Summary & Actions (7 cols) -->
        <div class="lg:col-span-7 space-y-6">
          <div class="space-y-2">
            <span class="theme-pill">
              {product.categoryName}
            </span>
            <h1 class="display-lg text-white font-black leading-tight" style="font-family:'Outfit',sans-serif;">
              {product.name}
            </h1>
          </div>

          <p class="text-base text-slate-300 leading-relaxed font-normal">
            {product.shortDescription}
          </p>

          <!-- Top Spec Summary Highlights -->
          {product.specifications && product.specifications.length > 0 && (
            <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 bg-[#0d1117] border border-white/10 p-4 rounded-xl">
              {product.specifications.slice(0, 3).map((spec) => (
                <div>
                  <div class="text-[11px] font-semibold text-slate-400 uppercase tracking-wider font-mono">{spec.name}</div>
                  <div class="text-sm font-bold text-theme-bright font-mono mt-0.5">{spec.value}</div>
                </div>
              ))}
            </div>
          )}

          <!-- Commercial Action CTAs -->
          <div class="pt-2 flex flex-col sm:flex-row items-stretch sm:items-center gap-3.5">
            <button
              type="button"
              data-open-quote-modal
              data-product-name={product.name}
              data-product-category={product.categoryName}
              class="forge-btn-primary rounded-xl py-3.5 px-7 text-xs"
            >
              <svg class="w-4 h-4 text-slate-950" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
              <span>Get Immediate Quote</span>
            </button>

            {product.productPdfUrl && (
              <a
                href={product.productPdfUrl}
                target="_blank"
                download
                class="forge-btn-ghost rounded-xl py-3.5 px-6 text-xs"
              >
                <svg class="w-4 h-4 text-theme" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                <span>Download Tech Datasheet (PDF)</span>
              </a>
            )}
          </div>

          <div class="text-xs text-slate-400 flex flex-wrap items-center gap-4 pt-1 font-mono">
            <span class="flex items-center gap-1.5">
              <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              In Stock &amp; Custom Sizing Available
            </span>
            <span class="flex items-center gap-1.5">
              <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              Global Seaworthy Shipping
            </span>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Specifications & Detailed Overview Section -->
  <section class="py-16 bg-[#07090e] text-slate-100 border-b border-white/10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      
      <!-- Structured Specifications Table -->
      <div class="space-y-4">
        <div class="flex items-center justify-between">
          <h2 class="text-xl sm:text-2xl font-extrabold text-white" style="font-family:'Outfit',sans-serif;">Technical Specifications Matrix</h2>
          <span class="text-xs font-mono text-theme-bright uppercase bg-theme-tint px-2.5 py-1 rounded border border-theme">ISO / ASTM METALLURGICAL</span>
        </div>
        
        <ProductSpecs specifications={product.specifications} />
      </div>

      <!-- Detailed Description / Application Notes -->
      <div class="space-y-4 pt-6 border-t border-white/10">
        <h2 class="text-xl sm:text-2xl font-extrabold text-white" style="font-family:'Outfit',sans-serif;">Detailed Product Overview &amp; Applications</h2>
        <div class="text-slate-300 text-sm leading-relaxed space-y-4 font-normal">
          <p class="whitespace-pre-line">{renderProductDescription(product.fullDescription || product.shortDescription)}</p>
          <p>
            Engineered specifically for demanding B2B industrial environments. All batches undergo non-destructive ultrasonic density scanning, spectrographic carbon purity testing, and dimensional laser inspection.
          </p>
        </div>
      </div>

      <!-- Related Products Section -->
      {product.relatedProducts && product.relatedProducts.length > 0 && (
        <div class="space-y-6 pt-12 border-t border-white/10">
          <h2 class="text-xl sm:text-2xl font-extrabold text-white" style="font-family:'Outfit',sans-serif;">Complementary Products &amp; Materials</h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
            {product.relatedProducts.map((rel: any) => (
              <a
                href={`/products/${rel.slug}`}
                class="glow-card border border-white/10 rounded-xl p-4 flex items-center gap-4 hover:border-theme transition-colors group bg-[#0d1117]"
              >
                <img src={rel.mainImage} alt={rel.name} class="w-16 h-16 rounded-lg object-cover bg-slate-950 shrink-0" />
                <div>
                  <div class="text-[10px] font-bold text-theme-bright uppercase font-mono">{rel.categoryName}</div>
                  <h4 class="text-sm font-bold text-white group-hover:text-theme-bright transition-colors leading-snug" style="font-family:'Outfit',sans-serif;">{rel.name}</h4>
                  <span class="text-xs text-slate-400 font-semibold mt-1 block">View Specs &rarr;</span>
                </div>
              </a>
            ))}
          </div>
        </div>
      )}

    </div>
  </section>

  <!-- Brochure CTA Banner -->
  <BrochureCTA />
</Layout>
