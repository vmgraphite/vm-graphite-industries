---
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ContactForm from '../components/ContactForm';
import { getSiteSettings, getContactPageContent } from '../lib/data';

const [siteSettings, contactContent] = await Promise.all([
  getSiteSettings(),
  getContactPageContent(),
]);

const pageBadge = contactContent?.badge || 'Direct Channels';
const pageTitle = contactContent?.title || 'Contact & Factory Locations';
const pageSubtitle = contactContent?.subtitle || 'Reach out to our technical sales team, request custom sample trials, or schedule a facility visit.';

// Fallback Default Locations
const defaultLocations = siteSettings.footerLocations && siteSettings.footerLocations.length > 0
  ? siteSettings.footerLocations
  : [
      {
        title: contactContent?.corporateOfficeHeading || siteSettings.corporateOfficeTitle || 'Corporate & Sales Office',
        badge: 'Corporate HQ',
        address: contactContent?.officeAddress || siteSettings.officeAddress || 'Plot No. 42, Industrial Area, Phase II, New Delhi - 110020, India',
        phone: contactContent?.primaryPhone || siteSettings.primaryPhone || '+91 94221 02425',
        email: contactContent?.email || siteSettings.email || 'info@vmgraphiteindustries.com',
      },
      {
        title: contactContent?.manufacturingPlantHeading || siteSettings.plantTitle || 'Manufacturing Plant Unit',
        badge: 'Manufacturing Unit',
        address: contactContent?.plantAddress || siteSettings.plantAddress || 'Survey No. 108/2, GIDC Industrial Estate, Sector 3, Gujarat - 392130, India',
        phone: contactContent?.primaryPhone || siteSettings.primaryPhone || '+91 94221 02425',
        email: contactContent?.email || siteSettings.email || 'info@vmgraphiteindustries.com',
      },
    ];

const locationsList = Array.isArray(contactContent?.locations) && contactContent.locations.length > 0
  ? contactContent.locations
  : defaultLocations;

// Direct Communication Channels (Dynamic List)
const directCommHeading = contactContent?.directCommHeading || 'Direct Communication';

const defaultChannels = [
  {
    title: 'Primary Phone',
    type: 'phone',
    value: contactContent?.primaryPhone || siteSettings.primaryPhone || '+91 94221 02425',
    subtext: siteSettings.workingHours || 'Mon - Sat: 9:00 AM - 6:30 PM IST',
  },
  {
    title: 'Official Email',
    type: 'email',
    value: contactContent?.email || siteSettings.email || 'info@vmgraphiteindustries.com',
    subtext: 'Commercial Inquiry Desk',
  },
  {
    title: 'WhatsApp Sales Desk',
    type: 'whatsapp',
    value: contactContent?.whatsappNumber || siteSettings.whatsappNumber || '919422102425',
    subtext: 'Instant technical sales response',
  },
];

const contactChannelsList = Array.isArray(contactContent?.contactChannels) && contactContent.contactChannels.length > 0
  ? contactContent.contactChannels
  : defaultChannels;

// Contact Form Dynamic Settings
const formBadge = contactContent?.formBadge || 'Inquiry Desk';
const formHeading = contactContent?.formHeading || 'Send an Official Commercial Inquiry';
const formSubtitle = contactContent?.formSubtitle || 'Fill out the details below. Our technical sales engineers respond within 2-4 business hours.';
---

<Layout
  title={contactContent?.seo?.metaTitle || "Contact Us & Factory Units | VM Graphite Industries LLP"}
  description={contactContent?.seo?.metaDescription || "Contact VM Graphite Industries LLP. Corporate office in New Delhi, manufacturing plant in Gujarat. Call, WhatsApp or send inquiry."}
  seo={contactContent?.seo}
  breadcrumbs={[{ name: 'Contact Us', item: '/contact' }]}
>
  <!-- Page Header -->
  <section class="bg-[#07090e] text-white py-16 industrial-grid-bg border-b border-white/[0.06] relative overflow-hidden">
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[800px] h-[400px] bg-[radial-gradient(ellipse_at_top,var(--primary-glow-subtle),transparent_65%)] pointer-events-none"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <Breadcrumbs items={[{ name: 'Contact Us', href: '/contact' }]} />

      <div class="max-w-3xl space-y-3 pt-6">
        <span class="theme-pill">{pageBadge}</span>
        <h1 class="display-lg text-white font-black tracking-tight" style="font-family:'Outfit',sans-serif;">
          {pageTitle}
        </h1>
        <p class="text-slate-400 text-sm sm:text-base leading-relaxed font-normal">
          {pageSubtitle}
        </p>
      </div>
    </div>
  </section>

  <!-- Contact Content & Locations -->
  <section class="py-16 bg-[#07090e] text-slate-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10">
        
        <!-- Left Contact Cards Column (5 cols) -->
        <div class="lg:col-span-5 space-y-6">
          
          <!-- Locations & Address Cards (User can add as many as they want) -->
          {locationsList.map((loc: any) => {
            const isPlant = loc.badge?.toLowerCase().includes('plant') || loc.badge?.toLowerCase().includes('unit') || loc.title?.toLowerCase().includes('plant');
            const iconColor = isPlant ? 'text-theme-bright' : 'text-theme';

            return (
              <div class="glow-card rounded-2xl p-6 border border-white/[0.08] shadow-xl space-y-3 bg-[#0f1118]">
                <div class="flex items-center justify-between">
                  <div class="flex items-center gap-3">
                    <div class={`shrink-0 ${iconColor}`}>
                      {isPlant ? (
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L5.6 15.13a2 2 0 00-1.022.547l-1.07 1.07a2 2 0 000 2.828l1.07 1.07a2 2 0 002.828 0l1.07-1.07z"/></svg>
                      ) : (
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>
                      )}
                    </div>
                    <h3 class="text-base sm:text-lg font-bold text-white" style="font-family:'Outfit',sans-serif;">{loc.title}</h3>
                  </div>
                  {loc.badge && (
                    <span class="text-[10px] font-mono font-bold text-theme-bright bg-theme-tint border border-theme px-2 py-0.5 rounded uppercase tracking-wider">
                      {loc.badge}
                    </span>
                  )}
                </div>

                <p class="text-xs sm:text-sm text-slate-400 leading-relaxed font-normal whitespace-pre-line">
                  {loc.address}
                </p>

                {(loc.phone || loc.email || loc.googleMapsUrl) && (
                  <div class="pt-2 border-t border-white/[0.06] flex flex-wrap items-center gap-4 text-xs">
                    {loc.phone && (
                      <a href={`tel:${loc.phone}`} class="text-slate-300 hover:text-white font-mono flex items-center gap-1.5 transition-colors">
                        <svg class="w-3.5 h-3.5 text-[var(--primary)]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
                        <span>{loc.phone}</span>
                      </a>
                    )}
                    {loc.email && (
                      <a href={`mailto:${loc.email}`} class="text-slate-300 hover:text-white font-mono flex items-center gap-1.5 transition-colors">
                        <svg class="w-3.5 h-3.5 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                        <span>{loc.email}</span>
                      </a>
                    )}
                    {loc.googleMapsUrl && (
                      <a href={loc.googleMapsUrl} target="_blank" rel="noopener noreferrer" class="text-theme-bright hover:underline text-[11px] font-mono flex items-center gap-1">
                        <span>View Map</span>
                        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
                      </a>
                    )}
                  </div>
                )}
              </div>
            );
          })}

          <!-- Direct Communication Channels (All contacts styled with unified UI) -->
          <div class="glow-card rounded-2xl p-6 border border-white/10 shadow-xl space-y-5 bg-[#0d1117]">
            <h4 class="text-xs font-bold uppercase tracking-wider text-theme-bright font-mono">{directCommHeading}</h4>
            
            <div class="space-y-4 text-xs">
              {contactChannelsList.map((ch: any) => {
                const isPhone = ch.type === 'phone';
                const isEmail = ch.type === 'email';
                const isWhatsapp = ch.type === 'whatsapp';
                const targetUrl = ch.customUrl
                  ? ch.customUrl
                  : isPhone
                  ? `tel:${ch.value}`
                  : isEmail
                  ? `mailto:${ch.value}`
                  : isWhatsapp
                  ? `https://wa.me/${String(ch.value).replace(/[^0-9]/g, '')}?text=Hello%20VM%20Graphite,%20I%20have%20an%20urgent%20inquiry.`
                  : '#';

                const iconBg = isWhatsapp
                  ? 'bg-emerald-500/10 text-emerald-400 border-emerald-500/30'
                  : isEmail
                  ? 'bg-cyan-500/10 text-cyan-400 border-cyan-500/30'
                  : 'bg-theme-tint text-theme-bright border-theme';

                return (
                  <div class="flex items-center gap-3">
                    <div class={`w-9 h-9 rounded-xl flex items-center justify-center shrink-0 border ${iconBg}`}>
                      {isPhone ? (
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
                      ) : isEmail ? (
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                      ) : isWhatsapp ? (
                        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
                      ) : (
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/></svg>
                      )}
                    </div>
                    <div>
                      <div class="text-slate-400 font-mono text-[11px]">{ch.title}</div>
                      <a
                        href={targetUrl}
                        target={isWhatsapp || ch.customUrl ? '_blank' : undefined}
                        rel={isWhatsapp || ch.customUrl ? 'noopener noreferrer' : undefined}
                        class="font-bold text-white hover:text-theme-bright font-mono text-sm transition-colors"
                      >
                        {ch.value}
                      </a>
                      {ch.subtext && (
                        <div class="text-[10px] text-slate-500 font-sans mt-0.5">{ch.subtext}</div>
                      )}
                    </div>
                  </div>
                );
              })}
            </div>
          </div>

        </div>

        <!-- Right Form Column (7 cols) -->
        <div class="lg:col-span-7">
          <div class="glow-card rounded-2xl p-7 sm:p-9 border border-white/10 shadow-2xl space-y-6 bg-[#0d1117]">
            <div>
              <span class="theme-pill">{formBadge}</span>
              <h3 class="display-lg text-white font-black mt-2" style="font-family:'Outfit',sans-serif;">{formHeading}</h3>
              <p class="text-xs sm:text-sm text-slate-400 mt-1 font-normal">
                {formSubtitle}
              </p>
            </div>

            <ContactForm
              client:load
              nameLabel={contactContent?.nameLabel}
              namePlaceholder={contactContent?.namePlaceholder}
              companyLabel={contactContent?.companyLabel}
              companyPlaceholder={contactContent?.companyPlaceholder}
              emailLabel={contactContent?.emailLabel}
              emailPlaceholder={contactContent?.emailPlaceholder}
              phoneLabel={contactContent?.phoneLabel}
              phonePlaceholder={contactContent?.phonePlaceholder}
              subjectLabel={contactContent?.subjectLabel}
              subjectPlaceholder={contactContent?.subjectPlaceholder}
              subjectOptions={contactContent?.subjectOptions}
              messageLabel={contactContent?.messageLabel}
              messagePlaceholder={contactContent?.messagePlaceholder}
              submitButtonText={contactContent?.submitButtonText}
              submittingButtonText={contactContent?.submittingButtonText}
              formDisclaimerText={contactContent?.formDisclaimerText}
              successHeading={contactContent?.successHeading}
              successMessage={contactContent?.successMessage}
              whatsappFollowupButtonText={contactContent?.whatsappFollowupButtonText}
              resetButtonText={contactContent?.resetButtonText}
              whatsappNumber={contactContent?.whatsappNumber || siteSettings.whatsappNumber}
              recipientEmail={contactContent?.email || siteSettings.email}
            />
          </div>
        </div>

      </div>

    </div>
  </section>
</Layout>
