---
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ContactForm from '../components/ContactForm';
import { getSiteSettings, getContactPageContent } from '../lib/data';

const [siteSettings, contactContent] = await Promise.all([
  getSiteSettings(),
  getContactPageContent(),
]);

const pageBadge = contactContent?.badge || 'Direct Channels';
const pageTitle = contactContent?.title || 'Contact & Factory Locations';
const pageSubtitle = contactContent?.subtitle || 'Reach out to our technical sales team, request custom sample trials, or schedule a facility visit.';

const corporateOfficeHeading = contactContent?.corporateOfficeHeading || 'Corporate & Sales Office';
const officeAddress = contactContent?.officeAddress || siteSettings.officeAddress;

const manufacturingPlantHeading = contactContent?.manufacturingPlantHeading || 'Manufacturing Plant Unit';
const plantAddress = contactContent?.plantAddress || siteSettings.plantAddress;

const directCommHeading = contactContent?.directCommHeading || 'Direct Communication';
const primaryPhone = contactContent?.primaryPhone || siteSettings.primaryPhone;
const email = contactContent?.email || siteSettings.email;
const whatsappNumber = contactContent?.whatsappNumber || siteSettings.whatsappNumber;
const whatsappButtonText = contactContent?.whatsappButtonText || 'Instant WhatsApp Sales Desk';

const formHeading = contactContent?.formHeading || 'Send an Official Commercial Inquiry';
const formSubtitle = contactContent?.formSubtitle || 'Fill out the details below. Our technical sales engineers respond within 2-4 business hours.';
---

<Layout
  title={contactContent?.seo?.metaTitle || "Contact Us & Factory Units | VM Graphite Industries LLP"}
  description={contactContent?.seo?.metaDescription || "Contact VM Graphite Industries LLP. Corporate office in New Delhi, manufacturing plant in Gujarat. Call, WhatsApp or send inquiry."}
  seo={contactContent?.seo}
  breadcrumbs={[{ name: 'Contact Us', item: '/contact' }]}
>
  <!-- Page Header -->
  <section class="bg-[#07090e] text-white py-16 industrial-grid-bg border-b border-white/[0.06] relative overflow-hidden">
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[800px] h-[400px] bg-[radial-gradient(ellipse_at_top,var(--primary-glow-subtle),transparent_65%)] pointer-events-none"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <Breadcrumbs items={[{ name: 'Contact Us', href: '/contact' }]} />

      <div class="max-w-3xl space-y-3 pt-6">
        <span class="theme-pill">{pageBadge}</span>
        <h1 class="display-lg text-white font-black tracking-tight" style="font-family:'Outfit',sans-serif;">
          {pageTitle}
        </h1>
        <p class="text-slate-400 text-sm sm:text-base leading-relaxed font-normal">
          {pageSubtitle}
        </p>
      </div>
    </div>
  </section>

  <!-- Contact Content & Locations -->
  <section class="py-16 bg-[#07090e] text-slate-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10">
        
        <!-- Left Contact Cards Column (5 cols) -->
        <div class="lg:col-span-5 space-y-6">
          
          <!-- Corporate Office Card -->
          <div class="glow-card rounded-2xl p-6 border border-white/[0.08] shadow-xl space-y-3 bg-[#0f1118]">
            <div class="flex items-center gap-3 text-theme">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>
              <h3 class="text-base sm:text-lg font-bold text-white" style="font-family:'Outfit',sans-serif;">{corporateOfficeHeading}</h3>
            </div>
            <p class="text-xs sm:text-sm text-slate-400 leading-relaxed font-normal">
              {officeAddress}
            </p>
          </div>

          <!-- Manufacturing Plant Card -->
          <div class="glow-card rounded-2xl p-6 border border-white/[0.08] shadow-xl space-y-3 bg-[#0f1118]">
            <div class="flex items-center gap-3 text-theme-bright">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L5.6 15.13a2 2 0 00-1.022.547l-1.07 1.07a2 2 0 000 2.828l1.07 1.07a2 2 0 002.828 0l1.07-1.07z"/></svg>
              <h3 class="text-base sm:text-lg font-bold text-white" style="font-family:'Outfit',sans-serif;">{manufacturingPlantHeading}</h3>
            </div>
            <p class="text-xs sm:text-sm text-slate-400 leading-relaxed font-normal">
              {plantAddress}
            </p>
          </div>

          <!-- Direct Communication Channels -->
          <div class="glow-card rounded-2xl p-6 border border-white/10 shadow-xl space-y-5 bg-[#0d1117]">
            <h4 class="text-xs font-bold uppercase tracking-wider text-theme-bright font-mono">{directCommHeading}</h4>
            
            <div class="space-y-4 text-xs">
              <div class="flex items-center gap-3">
                <div class="w-9 h-9 rounded-xl bg-theme-tint text-theme-bright flex items-center justify-center shrink-0 border border-theme">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
                </div>
                <div>
                  <div class="text-slate-400 font-mono text-[11px]">Primary Phone</div>
                  <a href={`tel:${primaryPhone}`} class="font-bold text-white hover:text-theme-bright font-mono text-sm">{primaryPhone}</a>
                </div>
              </div>

              <div class="flex items-center gap-3">
                <div class="w-9 h-9 rounded-xl bg-emerald-500/10 text-emerald-400 flex items-center justify-center shrink-0 border border-emerald-500/20">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                </div>
                <div>
                  <div class="text-slate-400 font-mono text-[11px]">Official Email</div>
                  <a href={`mailto:${email}`} class="font-bold text-white hover:text-theme-bright font-mono text-sm">{email}</a>
                </div>
              </div>
            </div>

            <!-- WhatsApp Direct Button -->
            <a
              href={`https://wa.me/${whatsappNumber.replace(/[^0-9]/g, '')}?text=Hello%20VM%20Graphite,%20I%20have%20an%20urgent%20inquiry.`}
              target="_blank"
              rel="noopener noreferrer"
              class="w-full py-3 bg-emerald-600 hover:bg-emerald-500 text-white font-bold rounded-xl text-xs flex items-center justify-center gap-2 transition-colors font-sans uppercase tracking-wider shadow-md"
            >
              <span>{whatsappButtonText}</span>
            </a>
          </div>

        </div>

        <!-- Right Form Column (7 cols) -->
        <div class="lg:col-span-7">
          <div class="glow-card rounded-2xl p-7 sm:p-9 border border-white/10 shadow-2xl space-y-6 bg-[#0d1117]">
            <div>
              <span class="theme-pill">Inquiry Desk</span>
              <h3 class="display-lg text-white font-black mt-2" style="font-family:'Outfit',sans-serif;">{formHeading}</h3>
              <p class="text-xs sm:text-sm text-slate-400 mt-1 font-normal">
                {formSubtitle}
              </p>
            </div>

            <ContactForm client:load />
          </div>
        </div>

      </div>

    </div>
  </section>
</Layout>
