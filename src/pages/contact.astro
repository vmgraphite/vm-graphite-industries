---
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ContactForm from '../components/ContactForm';
import { getSiteSettings } from '../lib/data';

const siteSettings = await getSiteSettings();
---

<Layout
  title="Contact Us & Factory Units | VM Graphite Industries LLP"
  description="Contact VM Graphite Industries LLP. Corporate office in New Delhi, manufacturing plant in Gujarat. Call, WhatsApp or send inquiry."
  breadcrumbs={[{ name: 'Contact Us', item: '/contact' }]}
>
  <!-- Page Header -->
  <section class="bg-slate-950 text-white py-14 industrial-grid-bg border-b border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <Breadcrumbs items={[{ name: 'Contact Us', item: '/contact' }]} />

      <div class="max-w-3xl space-y-3 pt-2">
        <h1 class="text-3xl sm:text-5xl font-black text-white tracking-tight">
          Contact &amp; Factory Locations
        </h1>
        <p class="text-slate-300 text-sm sm:text-base">
          Reach out to our technical sales team, request custom sample trials, or schedule a facility visit.
        </p>
      </div>
    </div>
  </section>

  <!-- Contact Content & Locations -->
  <section class="py-16 bg-slate-50 text-slate-900">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
        
        <!-- Left Contact Cards Column (5 cols) -->
        <div class="lg:col-span-5 space-y-6">
          
          <!-- Corporate Office Card -->
          <div class="bg-white rounded-2xl p-6 border border-slate-200 shadow-industrial space-y-3">
            <div class="flex items-center gap-3 text-industrial-copper">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>
              <h3 class="text-lg font-bold text-slate-900">Corporate &amp; Sales Office</h3>
            </div>
            <p class="text-xs text-slate-600 leading-relaxed font-medium">
              {siteSettings.officeAddress}
            </p>
          </div>

          <!-- Manufacturing Plant Card -->
          <div class="bg-white rounded-2xl p-6 border border-slate-200 shadow-industrial space-y-3">
            <div class="flex items-center gap-3 text-sky-600">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L5.6 15.13a2 2 0 00-1.022.547l-1.07 1.07a2 2 0 000 2.828l1.07 1.07a2 2 0 002.828 0l1.07-1.07a2 2 0 00.547-1.022l.477-2.387a6 6 0 00-.517-3.86l-.158-.318a6 6 0 01-.517-3.86l.477-2.387a2 2 0 00-.547-1.022l-1.07-1.07a2 2 0 00-2.828 0l-1.07 1.07a2 2 0 000 2.828l1.07 1.07z"/></svg>
              <h3 class="text-lg font-bold text-slate-900">Manufacturing Plant Unit</h3>
            </div>
            <p class="text-xs text-slate-600 leading-relaxed font-medium">
              {siteSettings.plantAddress}
            </p>
          </div>

          <!-- Direct Communication Channels -->
          <div class="bg-slate-900 text-white rounded-2xl p-6 border border-slate-800 shadow-industrial space-y-4">
            <h4 class="text-sm font-bold uppercase tracking-wider text-industrial-copper">Direct Channels</h4>
            
            <div class="space-y-3 text-xs">
              <div class="flex items-center gap-3">
                <div class="w-8 h-8 rounded-lg bg-slate-800 text-industrial-copper flex items-center justify-center shrink-0">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
                </div>
                <div>
                  <div class="text-slate-400 font-semibold">Primary Sales Phone</div>
                  <a href={`tel:${siteSettings.primaryPhone}`} class="font-bold text-white hover:text-industrial-copper">{siteSettings.primaryPhone}</a>
                </div>
              </div>

              <div class="flex items-center gap-3">
                <div class="w-8 h-8 rounded-lg bg-slate-800 text-emerald-400 flex items-center justify-center shrink-0">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                </div>
                <div>
                  <div class="text-slate-400 font-semibold">Official Email</div>
                  <a href={`mailto:${siteSettings.email}`} class="font-bold text-white hover:text-industrial-copper">{siteSettings.email}</a>
                </div>
              </div>
            </div>

            <!-- WhatsApp Direct Button -->
            <a
              href={`https://wa.me/${siteSettings.whatsappNumber.replace(/[^0-9]/g, '')}?text=Hello%20VM%20Graphite,%20I%20have%20an%20urgent%20inquiry.`}
              target="_blank"
              rel="noopener noreferrer"
              class="w-full py-3 bg-emerald-600 hover:bg-emerald-500 text-white font-bold rounded-xl text-xs flex items-center justify-center gap-2 transition-colors"
            >
              <span>Instant WhatsApp Sales Chat</span>
            </a>
          </div>

        </div>

        <!-- Right Form Column (7 cols) -->
        <div class="lg:col-span-7">
          <div class="bg-white rounded-2xl p-8 border border-slate-200 shadow-industrial space-y-6">
            <div>
              <h2 class="text-xs font-bold text-industrial-copper uppercase tracking-widest">Inquiry Desk</h2>
              <h3 class="text-2xl font-black text-slate-900 mt-1">Send a Direct Message</h3>
              <p class="text-xs text-slate-600 mt-1">
                Fill out the form below to connect directly with our technical engineers or sales representatives.
              </p>
            </div>

            <ContactForm client:load />
          </div>
        </div>

      </div>

    </div>
  </section>
</Layout>
