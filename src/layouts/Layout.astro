---
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import QuoteModal from '../components/QuoteModal';
import { getSiteSettings, getCategories } from '../lib/data';
import '../styles/global.css';

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'product' | 'article';
  productData?: any;
  breadcrumbs?: { name: string; item: string }[];
}

const { title, description, image, type, productData, breadcrumbs } = Astro.props;
const siteSettings = await getSiteSettings();
const categories = await getCategories();
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/images/logo.svg" />
    <meta name="generator" content={Astro.generator} />
    
    <SEO
      title={title}
      description={description}
      image={image}
      type={type}
      productData={productData}
      breadcrumbs={breadcrumbs}
    />
  </head>
  <body class="bg-[#07090e] text-slate-100 font-sans antialiased min-h-screen flex flex-col selection:bg-[var(--primary)] selection:text-white">
    <Header siteSettings={siteSettings} categories={categories} />
    
    <main class="flex-grow">
      <slot />
    </main>

    <Footer siteSettings={siteSettings} categories={categories} />

    <!-- WhatsApp Floating Action Button -->
    <WhatsAppButton whatsappNumber={siteSettings.whatsappNumber} />

    <!-- Global Product Quote Request Modal -->
    <QuoteModal client:idle />

    <!-- Interactive Scripts: Quote Modal, Scroll Reveal, Number Counter, Spotlight Cards -->
    <script is:inline>
      (function() {
        // 1. Quote Modal Event Listener
        document.addEventListener('click', function(e) {
          var target = e.target.closest('[data-open-quote-modal]');
          if (target) {
            var productName = target.getAttribute('data-product-name') || '';
            var categoryName = target.getAttribute('data-product-category') || '';
            window.dispatchEvent(
              new CustomEvent('open-quote-modal', {
                detail: { productName: productName, categoryName: categoryName },
              })
            );
          }
        });

        // 2. Animated Number Counter Function
        function animateCounter(el) {
          var targetVal = parseFloat(el.getAttribute('data-counter-target') || '0');
          var prefix = el.getAttribute('data-counter-prefix') || '';
          var suffix = el.getAttribute('data-counter-suffix') || '';
          var decimals = parseInt(el.getAttribute('data-counter-decimals') || '0', 10);
          var duration = parseInt(el.getAttribute('data-counter-duration') || '1200', 10);

          var startTimestamp = null;
          function step(timestamp) {
            if (!startTimestamp) startTimestamp = timestamp;
            var progress = Math.min((timestamp - startTimestamp) / duration, 1);
            var easeOut = 1 - Math.pow(1 - progress, 3);
            var current = easeOut * targetVal;
            el.textContent = prefix + current.toFixed(decimals) + suffix;
            if (progress < 1) {
              window.requestAnimationFrame(step);
            } else {
              el.textContent = prefix + targetVal.toFixed(decimals) + suffix;
            }
          }
          window.requestAnimationFrame(step);
        }

        // 3. High-Performance Instant Scroll Reveal
        function setupScrollReveal() {
          var revealElements = document.querySelectorAll(
            '.reveal-on-scroll, .reveal-scale, .reveal-slide-left, .reveal-slide-right, .reveal-pop, .reveal-fade-up'
          );

          if (!('IntersectionObserver' in window)) {
            revealElements.forEach(function(el) {
              el.classList.add('is-visible');
            });
            return;
          }

          var observer = new IntersectionObserver(
            function(entries) {
              entries.forEach(function(entry) {
                if (entry.isIntersecting) {
                  entry.target.classList.add('is-visible');

                  var counters = entry.target.querySelectorAll('[data-counter-target]');
                  counters.forEach(function(counter) {
                    if (!counter.getAttribute('data-animated')) {
                      counter.setAttribute('data-animated', 'true');
                      animateCounter(counter);
                    }
                  });

                  if (
                    entry.target.hasAttribute('data-counter-target') &&
                    !entry.target.getAttribute('data-animated')
                  ) {
                    entry.target.setAttribute('data-animated', 'true');
                    animateCounter(entry.target);
                  }

                  observer.unobserve(entry.target);
                }
              });
            },
            { threshold: 0.01, rootMargin: '300px 0px 50px 0px' }
          );

          revealElements.forEach(function(el) {
            observer.observe(el);
          });
        }

        // 4. Mouse Spotlight Glow for .glow-card
        function setupSpotlight() {
          var cards = document.querySelectorAll('.glow-card');
          cards.forEach(function(card) {
            card.addEventListener('mousemove', function(e) {
              var rect = card.getBoundingClientRect();
              var x = e.clientX - rect.left;
              var y = e.clientY - rect.top;
              card.style.setProperty('--mouse-x', x + 'px');
              card.style.setProperty('--mouse-y', y + 'px');
            });
          });
        }

        function initUI() {
          setupScrollReveal();
          setupSpotlight();
        }

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', initUI);
        } else {
          initUI();
        }
      })();
    </script>
  </body>
</html>
