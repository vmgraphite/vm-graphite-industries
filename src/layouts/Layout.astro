---
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import QuoteModal from '../components/QuoteModal';
import { getSiteSettings, getCategories } from '../lib/data';
import '../styles/global.css';

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'product' | 'article';
  productData?: any;
  breadcrumbs?: { name: string; item: string }[];
}

const { title, description, image, type, productData, breadcrumbs } = Astro.props;
const siteSettings = await getSiteSettings();
const categories = await getCategories();
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/images/logo.png" />
    <link rel="icon" type="image/svg+xml" href="/images/logo.svg" />
    <link rel="apple-touch-icon" href="/images/logo.png" />
    <meta name="generator" content={Astro.generator} />
    
    <SEO
      title={title}
      description={description}
      image={image}
      type={type}
      productData={productData}
      breadcrumbs={breadcrumbs}
    />
  </head>
  <body class="bg-[#07090e] text-slate-100 font-sans antialiased min-h-screen flex flex-col selection:bg-[#e8a020] selection:text-[#07090e]">
    <Header siteSettings={siteSettings} categories={categories} />
    
    <main class="flex-grow">
      <slot />
    </main>

    <Footer siteSettings={siteSettings} categories={categories} />

    <!-- WhatsApp Floating Action Button -->
    <WhatsAppButton whatsappNumber={siteSettings.whatsappNumber} />

    <!-- Global Product Quote Request Modal -->
    <QuoteModal client:idle />

    <!-- Interactive Scripts: Quote Modal, Scroll Reveal, Number Counter, Spotlight Cards -->
    <script>
      // 1. Quote Modal Event Listener
      document.addEventListener('click', (e) => {
        const target = (e.target as HTMLElement).closest('[data-open-quote-modal]');
        if (target) {
          const productName = target.getAttribute('data-product-name') || '';
          const categoryName = target.getAttribute('data-product-category') || '';
          window.dispatchEvent(
            new CustomEvent('open-quote-modal', {
              detail: { productName, categoryName },
            })
          );
        }
      });

      // 2. Animated Number Counter Function
      const animateCounter = (el: HTMLElement) => {
        const targetVal = parseFloat(el.getAttribute('data-counter-target') || '0');
        const prefix = el.getAttribute('data-counter-prefix') || '';
        const suffix = el.getAttribute('data-counter-suffix') || '';
        const decimals = parseInt(el.getAttribute('data-counter-decimals') || '0', 10);
        const duration = parseInt(el.getAttribute('data-counter-duration') || '1800', 10);

        let startTimestamp: number | null = null;
        const step = (timestamp: number) => {
          if (!startTimestamp) startTimestamp = timestamp;
          const progress = Math.min((timestamp - startTimestamp) / duration, 1);
          // Ease-out cubic
          const easeOut = 1 - Math.pow(1 - progress, 3);
          const current = easeOut * targetVal;
          el.textContent = `${prefix}${current.toFixed(decimals)}${suffix}`;
          if (progress < 1) {
            window.requestAnimationFrame(step);
          } else {
            el.textContent = `${prefix}${targetVal.toFixed(decimals)}${suffix}`;
          }
        };
        window.requestAnimationFrame(step);
      };

      // 3. Scroll Reveal & Counter Trigger Observer
      const setupScrollReveal = () => {
        const revealElements = document.querySelectorAll(
          '.reveal-on-scroll, .reveal-scale, .reveal-slide-left, .reveal-slide-right'
        );

        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');

                // Trigger counters within this revealed element if present
                const counters = entry.target.querySelectorAll('[data-counter-target]');
                counters.forEach((counter) => {
                  if (!counter.getAttribute('data-animated')) {
                    counter.setAttribute('data-animated', 'true');
                    animateCounter(counter as HTMLElement);
                  }
                });

                // Also check if the revealed element itself is a counter
                if (
                  entry.target.hasAttribute('data-counter-target') &&
                  !entry.target.getAttribute('data-animated')
                ) {
                  entry.target.setAttribute('data-animated', 'true');
                  animateCounter(entry.target as HTMLElement);
                }

                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.1, rootMargin: '0px 0px -30px 0px' }
        );

        revealElements.forEach((el) => observer.observe(el));
      };

      // 4. Mouse Spotlight Glow for .glow-card
      const setupSpotlight = () => {
        const cards = document.querySelectorAll('.glow-card');
        cards.forEach((card) => {
          let rafId: number | null = null;
          (card as HTMLElement).addEventListener('mousemove', (e: MouseEvent) => {
            if (rafId) return;
            rafId = requestAnimationFrame(() => {
              const rect = (card as HTMLElement).getBoundingClientRect();
              const x = e.clientX - rect.left;
              const y = e.clientY - rect.top;
              (card as HTMLElement).style.setProperty('--mouse-x', `${x}px`);
              (card as HTMLElement).style.setProperty('--mouse-y', `${y}px`);
              rafId = null;
            });
          });
        });
      };

      const initUI = () => {
        setupScrollReveal();
        setupSpotlight();
      };

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initUI);
      } else {
        initUI();
      }
    </script>
  </body>
</html>
